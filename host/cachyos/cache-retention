#!/usr/bin/env bash
set -euo pipefail

# `uv run` lifetime = shared cache lock.
if uv_output="$(UV_LOCK_TIMEOUT=0 uv cache prune --offline --color never 2>&1)"; then
  printf '%s\n' "$uv_output"
else
  uv_status=$?
  # Exit 2 also covers I/O/config errors → match the timeout diagnostic.
  if [[ $uv_status -eq 2 &&
        $'\n'$uv_output == *$'\nerror: Timeout (0s) when waiting for lock on `'* ]]; then
    echo 'uv cache is in use; skipping uv cleanup.'
  else
    printf '%s\n' "$uv_output" >&2
    exit "$uv_status"
  fi
fi
sudo -n paccache -r -k 2 -c /var/cache/pacman/pkg
aur_cache_args=()
for directory in "$HOME"/.cache/paru/clone/*; do
  [[ -d "$directory" ]] && aur_cache_args+=(-c "$directory")
done
if ((${#aur_cache_args[@]})); then
  paccache -r -k 2 "${aur_cache_args[@]}"
fi
