#!/usr/bin/env python3
"""Apply the private BrowserOS Google sign-in settings to a native browser launch."""
import configparser
import os
import shlex
import sys
from pathlib import Path


def google_signin(path):
    entry = configparser.ConfigParser(interpolation=None)
    entry.read(path)
    environment = {}
    switches = {}
    for token in shlex.split(entry.get("Desktop Entry", "Exec", fallback="")):
        key, separator, value = token.partition("=")
        if separator and key in {"GOOGLE_DEFAULT_CLIENT_ID", "GOOGLE_DEFAULT_CLIENT_SECRET", "GOOGLE_API_KEY"}:
            environment[key] = value
        elif separator and key in {"--oauth2-client-id", "--oauth2-client-secret"}:
            switches[key] = value
    client = switches.get("--oauth2-client-id", environment.get("GOOGLE_DEFAULT_CLIENT_ID"))
    secret = switches.get("--oauth2-client-secret", environment.get("GOOGLE_DEFAULT_CLIENT_SECRET"))
    if not client or not secret:
        raise ValueError("Google sign-in settings are missing from the BrowserOS desktop entry.")
    return environment, [f"{key}={value}" for key, value in switches.items()]



def main():
    credentials, switches = google_signin(Path.home() / ".local/share/applications/browseros.desktop")
    environment = os.environ | credentials
    binary = sys.argv[1]
    os.execve(binary, [binary, *switches, *sys.argv[2:]], environment)


if __name__ == "__main__":
    main()
