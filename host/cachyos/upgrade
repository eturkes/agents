#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

usage() {
  echo 'Usage: upgrade [--check]'
  echo 'Update packages and tools, then check system health.'
  echo '--check: Check system health and snapshot storage without updating or cleaning anything.'
  echo 'Exit codes: 0 = clear; 1 = failure; 2 = review needed; 64 = usage or terminal required.'
}

if (($# > 1)); then usage >&2; exit 64; fi
case ${1:-} in
  '') mode=upgrade ;;
  --check) mode=check ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 64 ;;
esac
if [[ $mode == upgrade && ( ! -t 0 || ! -t 1 ) ]]; then
  echo 'Run upgrade in an interactive terminal. Use upgrade --check for read-only checks.' >&2
  exit 64
fi

script_dir=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
repo_root=$(readlink -f -- "$script_dir/../..")
passed=0 review=0 failed=0
declare -A failed_before baseline_ok

capture() {
  check_status=0
  check_output=$("$@" 2>&1) || check_status=$?
}
details() { [[ -z $1 ]] || printf '%s\n' "$1" | sed 's/^/    /'; }
report() {
  printf '[%s] %s\n' "$1" "$2"
  case $1 in
    PASS) ((passed+=1)) ;;
    REVIEW) ((review+=1)) ;;
    FAIL) ((failed+=1)) ;;
  esac
}
check() {
  local label=$1 action=$2 display=$3
  shift 3
  capture "$@"
  if ((check_status == 0)); then
    report PASS "$label"
    [[ $display != show ]] || details "$check_output"
  else
    report FAIL "$label (exit $check_status)"
    details "$check_output"
    printf '    Next: %s\n' "$action"
  fi
}
failed_units() { systemctl "--$1" --failed --no-pager --no-legend --plain; }
capture_baseline() {
  local scope
  for scope in system user; do
    capture failed_units "$scope"
    if ((check_status)); then
      details "$check_output"
      return "$check_status"
    fi
    failed_before[$scope]=$(awk '{print $1}' <<< "$check_output")
    baseline_ok[$scope]=1
  done
}
check_services() {
  local scope=$1 unit rest listing new=0 old=0 classified=''
  capture failed_units "$scope"
  if ((check_status)); then
    report FAIL "$scope services: failed-unit listing unavailable (exit $check_status)"
    details "$check_output"
    printf '    Next: Run systemctl --%s --failed and resolve the connection error.\n' "$scope"
    return
  elif [[ -z $check_output ]]; then
    report PASS "$scope services: no failed units"
  elif [[ ${baseline_ok[$scope]:-0} == 0 ]]; then
    report REVIEW "$scope services: current failed units; no before-update baseline"
    details "$check_output"
  else
    listing=$check_output
    while read -r unit rest; do
      [[ -n $unit ]] || continue
      if grep -Fxq -- "$unit" <<< "${failed_before[$scope]}"; then
        ((old+=1))
        classified+="pre-existing: $unit"$'\n'
      else
        ((new+=1))
        classified+="new: $unit"$'\n'
      fi
    done <<< "$listing"
    if ((new)); then
      report FAIL "$scope services: $new newly failed; $old pre-existing"
    else
      report REVIEW "$scope services: $old pre-existing failed units"
    fi
    details "${classified%$'\n'}"
  fi
  if [[ -n $check_output ]]; then
    printf '    Next: Inspect each listed unit with systemctl --%s status UNIT.\n' "$scope"
  fi
}
check_packages() {
  capture pacman -Dk
  if ((check_status == 0)); then
    report PASS 'Package database'
  elif ((check_status == 1)) && [[ -n $check_output ]] &&
       ! grep -Evq "^error: 'CACHY_UPDATE_NOTICE': (description file|file list) is missing$" <<< "$check_output"; then
    report REVIEW 'Package database: CachyOS acknowledgement marker (pacman -Dk exit 1)'
    details "$check_output"
    echo '    Next: Read the CachyOS update notice. Preserve the marker until you review its instructions.'
  else
    report FAIL "Package database (pacman -Dk exit $check_status)"
    details "$check_output"
    echo '    Next: Resolve the listed package-record errors before another update.'
  fi
}
installed_kernels() {
  pacman -Qql | sed -n 's|^/usr/lib/modules/\([^/]*\)/pkgbase$|\1|p' | sort -u
}
check_dkms() {
  local modules kernels kernel module missing=''
  capture dkms status
  if ((check_status)); then
    report FAIL "Kernel modules: DKMS status unavailable (exit $check_status)"
    details "$check_output"
    echo '    Next: Run dkms status and resolve the reported error before rebooting.'
    return
  fi
  modules=$check_output
  capture installed_kernels
  if ((check_status)) || [[ -z $check_output ]]; then
    report FAIL 'Kernel modules: installed kernel list unavailable'
    details "$check_output"
    echo '    Next: Check the installed kernel packages with pacman -Q.'
    return
  fi
  kernels=$check_output
  while read -r kernel; do
    for module in bcachefs nvidia; do
      if ! awk -F'[,/:] *' -v module="$module" -v kernel="$kernel" \
          '$1 == module && $3 == kernel && $NF == "installed" {found=1} END {exit !found}' <<< "$modules"; then
        missing+="$module for $kernel"$'\n'
      fi
    done
  done <<< "$kernels"
  if [[ -n $missing ]]; then
    report FAIL 'Kernel modules: required DKMS installations are missing'
    details "${missing%$'\n'}"
    details "$modules"
    echo '    Next: Resolve the DKMS build errors before rebooting.'
  else
    report PASS 'Kernel modules: bcachefs and NVIDIA installed for every installed kernel'
    details "$kernels"
  fi
}
check_configs() {
  capture sudo -n pacdiff -o
  if ((check_status)); then
    report FAIL "Configuration review: file listing unavailable (exit $check_status)"
    details "$check_output"
    echo '    Next: Run sudo pacdiff -o to inspect the error.'
  elif [[ -n $check_output ]]; then
    report REVIEW 'Configuration files need a manual merge decision'
    details "$check_output"
    echo '    Next: Review the listed files with sudo pacdiff. Keep local settings when you merge them.'
  else
    report PASS 'Configuration files: no pending .pacnew or .pacsave files'
  fi
}
check_codexify() {
  local summary
  capture codexify doctor
  if ((check_status)) || grep -Eq '^FAIL[ :]' <<< "$check_output"; then
    report FAIL "Codexify health (doctor exit $check_status)"
    details "$check_output"
    echo '    Next: Run codexify doctor and resolve its reported issues.'
  else
    if grep -Eq '^WARN(ING)?[ :]' <<< "$check_output"; then
      report REVIEW 'Codexify health: doctor reported warnings'
      echo '    Next: Run codexify doctor and review its warnings.'
    else
      report PASS 'Codexify health'
    fi
    summary=$(sed -n -E '/^(PASS updates:|WARN(ING)?[ :]|Result:)/p' <<< "$check_output")
    details "${summary:-$check_output}"
  fi
}
postflight() {
  printf '\n=== System health and snapshot storage ===\n'
  check_packages
  check_dkms
  check 'Recovery kernel integrity' 'Resolve the recovery checkpoint errors before rebooting.' hide \
    sudo -n "$script_dir/kernel-recovery" check
  check_services system
  check_services user
  check 'Crash diagnostics policy' 'Run agent-crash-policy check and resolve the reported settings.' hide \
    "$script_dir/agent-crash-policy" check
  check 'NVIDIA compute access' 'Inspect the driver error and DKMS status before starting GPU work.' show \
    nvidia-smi --query-gpu=name,driver_version,memory.used,display_active --format=csv
  check 'Codex executable' 'Check the Codex installation and PATH.' show codex --version
  check_codexify
  check 'BrowserOS connection' 'Start BrowserOS, then run upgrade --check again.' hide \
    browseros-call tabs '{"action":"list"}'
  check_configs
  check 'Project snapshot storage' 'Run project-snapshots report and resolve the reported error.' show \
    "$script_dir/project-snapshots" report
  echo '    Snapshot retention is manual. Choose which snapshots to keep; upgrade only reports their storage.'
  printf '\nSummary: %d passed, %d need review, %d failed.\n' "$passed" "$review" "$failed"
  if ((failed)); then
    echo 'Next: Resolve the FAIL items, then run upgrade --check.'
    return 1
  elif ((review)); then
    echo 'Next: Review the items above, then run upgrade --check.'
    return 2
  fi
  echo 'All checks completed without reported issues.'
}

if [[ $mode == check ]]; then
  postflight
  exit 0
fi

update_stage='Service baseline'
cft_tmp=''
stage() { update_stage=$1; printf '\n=== %s ===\n' "$update_stage"; }
finish() {
  local update_status=$? result
  trap - EXIT
  set +e
  [[ -z $cft_tmp ]] || rm -rf -- "$cft_tmp"
  if ((update_status)); then
    report FAIL "Update stopped during $update_stage (exit $update_status); later update stages did not run"
  else
    echo 'Update stages completed.'
  fi
  postflight
  result=$?
  exit "$result"
}
trap finish EXIT
capture_baseline

stage 'Recovery kernel preflight'
sudo -n "$repo_root/host/cachyos/kernel-recovery" check

stage 'System packages (pacman/AUR)'
# paru owns repo + AUR toolchain; run first so later steps use current binaries.
paru -Syu

stage 'Python tools (uv)'
# uv itself is pacman-managed → `paru -Syu` above moves it; this step owns the
# uv-installed tools. headroom-ai path-pins the locally built wheel in
# ~/src/headroom/dist (image-worker termination guard): `upgrade --all`
# re-resolves that same path → the pin holds + the wheel must stay on disk.
# Once an upstream release ships the guard, return headroom to PyPI:
#   uv tool install --force --python 3.14 "headroom-ai[all]"
# State + recipe: $repo_root/host/cachyos/headroom/README.md
PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1 uv tool upgrade --all

stage 'MoonBit'
# ~/.moon toolchain self-updates: `moon upgrade` updates binaries; `moon update`
# refreshes registry index. Project dependencies remain project-local.
moon_home="${MOON_HOME:-$HOME/.moon}"
case ":$PATH:" in
  *":$moon_home/bin:"*) ;;
  *) export PATH="$moon_home/bin:$PATH" ;;
esac

moon upgrade
moon update

stage 'Local app repositories'
git -C "$HOME/.local/app/bgcmd" pull --ff-only
git -C "$HOME/.local/app/codex-reset-tracker" pull --ff-only

stage 'Global Node tools (pnpm)'
# vite/vitest = pnpm globals; `update -g --latest` upgrades them. Export global
# bin for direct/non-login invocation.
case ":$PATH:" in
  *":$HOME/.local/share/pnpm/bin:"*) ;;
  *) export PATH="$HOME/.local/share/pnpm/bin:$PATH" ;;
esac
pnpm update -g --latest

stage 'Headless browser (chromiumfish)'
# Upgrade pnpm workspace, then fetch browser referenced by updated chromiumfish.
# Browser startup requires executable chrome_crashpad_handler. If fetched cache
# lacks it, install Chrome for Testing handler matching MAJOR.MINOR.BUILD.
# Persistent cache ⇒ one repair per browser-version bump.
if [[ -d "$HOME/.local/share/chromiumfish" ]]; then
  pnpm -C "$HOME/.local/share/chromiumfish" update --latest
  chromiumfish fetch

  chromiumfish_path=$(chromiumfish path)
  chromiumfish_dir=$(dirname -- "$chromiumfish_path")
  if [[ ! -x "$chromiumfish_dir/chrome_crashpad_handler" ]]; then
    browser_version="$(chromiumfish --version | sed -n 's/.*browser \([^)]*\)).*/\1/p')"
    cft_json="$(curl -fsSL https://googlechromelabs.github.io/chrome-for-testing/latest-patch-versions-per-build-with-downloads.json)"
    cft_version="$(jq -r --arg build "${browser_version%.*}" '.builds[$build].version // empty' <<<"$cft_json")"
    cft_url="$(jq -r --arg build "${browser_version%.*}" '.builds[$build].downloads.chrome[]? | select(.platform == "linux64") | .url' <<<"$cft_json")"
    if [[ -z "$cft_url" ]]; then
      echo "chromiumfish cache $chromiumfish_dir needs chrome_crashpad_handler; no Chrome for Testing linux64 build matches ${browser_version:-unknown} -- install one by hand before headless use" >&2
      exit 1
    fi
    cft_tmp="$(mktemp -d)"
    curl -fsSL -o "$cft_tmp/chrome-linux64.zip" "$cft_url"
    unzip -q -o -j "$cft_tmp/chrome-linux64.zip" chrome-linux64/chrome_crashpad_handler -d "$cft_tmp"
    install -m 0755 "$cft_tmp/chrome_crashpad_handler" "$chromiumfish_dir/chrome_crashpad_handler"
    rm -rf "$cft_tmp"
    cft_tmp=''
    echo "chromiumfish $browser_version: installed chrome_crashpad_handler from Chrome for Testing $cft_version"
  fi

  # Gate = nonzero size + successful `--help`. Together they reject corrupt,
  # truncated, non-ELF + zero-byte handlers across shell fallback semantics.
  if [[ ! -s "$chromiumfish_dir/chrome_crashpad_handler" ]] ||
     ! "$chromiumfish_dir/chrome_crashpad_handler" --help >/dev/null 2>&1; then
    echo "chromiumfish cache $chromiumfish_dir has an unrunnable chrome_crashpad_handler; replace it before headless use" >&2
    exit 1
  fi
  echo 'Next: After browser changes, capture a real page with webcap and inspect the image.'
else
  echo "chromiumfish workspace not present; skipping"
fi

stage 'Marketplace language servers'
# Marketplace servers = user-managed. Shared updater resolves candidates,
# requires real LSP handshake + restores prior server on failure. Caller absorbs
# exit 1/2 so workstation upgrade continues with retained working server.
if [[ -x "$repo_root/claude/marketplace/upgrade-servers" ]]; then
  "$repo_root/claude/marketplace/upgrade-servers" ||
    report REVIEW "Language server updater exited $?; inspect its report for retained versions"
else
  echo "upgrade-servers not found at $repo_root/claude/marketplace/upgrade-servers; skipping"
fi

stage 'Bounded cache cleanup'
"$repo_root/host/cachyos/cache-retention"
