#!/usr/bin/env bash
set -euo pipefail

# Upgrade run for this CachyOS workstation, the host counterpart to
# container/aeon/upgrade.
#
# The two machines need very different scripts. Aeon is a Debian container where
# every toolchain was installed by its own installer, so its script drives a long
# list of self-updaters (rustup, uv, corepack, elan, moon, ...). Here almost
# everything is a pacman/AUR package -- rust, uv, pnpm, node, npm, ripgrep,
# headroom, cli-proxy-api and codex are all repo-owned -- so `paru -Syu` IS the
# toolchain upgrade, and running those installers' self-updaters on top would
# fight the package manager over the same files. What remains is the handful of
# things pacman does not own; this script covers exactly those, rolling each to
# its latest upstream release.
#
# Run it deliberately, not on a timer: a full -Syu on Arch is a rolling upgrade
# that can want intervention (.pacnew files, keyring bumps, manual pacman -Sy
# fallout). Anything requiring judgement is left to you and merely reported.

repo_root="$HOME/Projects/agents"

echo "=== System packages (pacman/AUR) ==="
# paru covers repo + AUR in one pass. This is the upgrade path for nearly every
# tool on this box, so it runs first: later steps assume current binaries.
paru -Syu

# headroom: the image-worker-termination fix (upstream-pending) deploys as a
# patched uv-tool build shadowing the repo package on PATH; -Syu moving the
# repo package underneath it is harmless. Once a repo release ships the fix,
# drop the shadow: uv tool uninstall headroom-ai. State + recipe:
#   $repo_root/host/cachyos/headroom/README.md

echo
echo "=== MoonBit ==="
# The toolchain lives user-global under ~/.moon and carries its own updater: `moon upgrade` rolls the
# binaries to the latest release, `moon update` refreshes the registry index it keeps as a standing
# local git repo under ~/.moon/registry/index -- cargo/uv/pnpm resolve against the live registry per
# command and need no such step. Per-project dependencies stay with `moon` inside each project.
moon_home="${MOON_HOME:-$HOME/.moon}"
case ":$PATH:" in
  *":$moon_home/bin:"*) ;;
  *) export PATH="$moon_home/bin:$PATH" ;;
esac

# `moon upgrade` reads its confirmation from the terminal, so hand it a pty when one is absent.
if [[ -t 0 ]]; then
  moon upgrade
else
  printf 'y\n' | script -qefc 'moon upgrade' /dev/null
fi
moon update

echo
echo "=== Local app repositories ==="
git -C "$HOME/.local/app/bgcmd" pull --ff-only
git -C "$HOME/.local/app/codex-reset-tracker" pull --ff-only

echo
echo "=== pnpm globals ==="
# vite and vitest are pnpm globals, so `update -g --latest` is their upgrade path. Export the global
# bin directory to keep this working outside a login shell.
case ":$PATH:" in
  *":$HOME/.local/share/pnpm/bin:"*) ;;
  *) export PATH="$HOME/.local/share/pnpm/bin:$PATH" ;;
esac
pnpm update -g --latest

echo
echo "=== chromiumfish ==="
# Upgrade the pnpm workspace, then fetch the browser build the freshly upgraded
# chromiumfish package points at -- `update --latest` moves the package, `fetch`
# follows it.
#
# Upstream Linux archives omit chrome_crashpad_handler and the fetcher accepts
# them -- it checks for the main chrome binary alone. That handler must be
# present: the browser posix_spawns it at startup, so a cache lacking it aborts
# every headless run at launch. Repair the cache in place from Chrome for
# Testing; same MAJOR.MINOR.BUILD = the crashpad revision this browser expects.
# The cache persists → one download per browser-version bump.
if [[ -d "$HOME/.local/share/chromiumfish" ]]; then
  pnpm -C "$HOME/.local/share/chromiumfish" update --latest
  chromiumfish fetch

  chromiumfish_dir="$(dirname "$(chromiumfish path)")"
  if [[ ! -x "$chromiumfish_dir/chrome_crashpad_handler" ]]; then
    browser_version="$(chromiumfish --version | sed -n 's/.*browser \([^)]*\)).*/\1/p')"
    cft_json="$(curl -fsSL https://googlechromelabs.github.io/chrome-for-testing/latest-patch-versions-per-build-with-downloads.json)"
    cft_version="$(jq -r --arg build "${browser_version%.*}" '.builds[$build].version // empty' <<<"$cft_json")"
    cft_url="$(jq -r --arg build "${browser_version%.*}" '.builds[$build].downloads.chrome[]? | select(.platform == "linux64") | .url' <<<"$cft_json")"
    if [[ -z "$cft_url" ]]; then
      echo "chromiumfish cache $chromiumfish_dir needs chrome_crashpad_handler; no Chrome for Testing linux64 build matches ${browser_version:-unknown} -- install one by hand before headless use" >&2
      exit 1
    fi
    cft_tmp="$(mktemp -d)"
    curl -fsSL -o "$cft_tmp/chrome-linux64.zip" "$cft_url"
    unzip -q -o -j "$cft_tmp/chrome-linux64.zip" chrome-linux64/chrome_crashpad_handler -d "$cft_tmp"
    install -m 0755 "$cft_tmp/chrome_crashpad_handler" "$chromiumfish_dir/chrome_crashpad_handler"
    rm -rf "$cft_tmp"
    echo "chromiumfish $browser_version: installed chrome_crashpad_handler from Chrome for Testing $cft_version"
  fi

  # Always verify size + a real run: an existence check passes a corrupt copy
  # that still kills the browser at launch. Truncated and non-ELF handlers fail
  # the run (SIGSEGV, rc=1); a zero-byte one needs the size test, since bash
  # falls back to running it as an empty script and reports success.
  if [[ ! -s "$chromiumfish_dir/chrome_crashpad_handler" ]] ||
     ! "$chromiumfish_dir/chrome_crashpad_handler" --help >/dev/null 2>&1; then
    echo "chromiumfish cache $chromiumfish_dir has an unrunnable chrome_crashpad_handler; replace it before headless use" >&2
    exit 1
  fi
else
  echo "chromiumfish workspace not present; skipping"
fi

echo
echo "=== Docs mirror ==="
# Refresh the local llms.txt copy from upstream. It is git-ignored rather than
# tracked (see .gitignore), since it can always be re-fetched here. Download to
# a temp file first, then move it into place, so an interrupted or failed fetch
# leaves the existing copy intact. A fetch failure is non-fatal: warn and keep
# the current copy rather than aborting the rest of the run.
agentlang_doc="$repo_root/docs/agentlanguages.dev/llms.txt"
agentlang_tmp="$(mktemp)"
mkdir -p "$(dirname "$agentlang_doc")"
if curl -fsSL -o "$agentlang_tmp" https://agentlanguages.dev/llms.txt; then
  mv "$agentlang_tmp" "$agentlang_doc"
  echo "agentlanguages.dev/llms.txt updated"
else
  rm -f "$agentlang_tmp"
  echo "agentlanguages.dev/llms.txt fetch failed; keeping existing copy" >&2
fi

# docs/scopedcommits.com/llms.txt is deliberately NOT fetched here: the site is
# live but has never published an llms.txt, so the repo's tracked copy is the
# original rather than a mirror. Maintain it by hand; adding a fetch would
# overwrite it with a 404.

echo
echo "=== Marketplace LSP servers ==="
# Nothing above touches these: no package manager owns a hand-fetched jar or a
# SWI-Prolog pack, so they only move here. Each is taken to its latest upstream
# release, verified with a real LSP handshake, and rolled back if that fails --
# upstream has shipped a release that broke Claude Code before, so latest is
# taken on evidence rather than on faith.
# `|| true` because a rolled-back upgrade (exit 1) or an upstream outage (exit 2)
# must not fail the whole run: the previous working server is still in place.
if [[ -x "$repo_root/claude/marketplace/upgrade-servers" ]]; then
  "$repo_root/claude/marketplace/upgrade-servers" || true
else
  echo "upgrade-servers not found at $repo_root/claude/marketplace/upgrade-servers; skipping"
fi

echo
echo "upgrade: done"
