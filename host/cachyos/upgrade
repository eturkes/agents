#!/usr/bin/env bash
set -euo pipefail

# Upgrade run for this CachyOS workstation, the host counterpart to
# container/aeon/upgrade.
#
# The two machines need very different scripts. Aeon is a Debian container where
# every toolchain was installed by its own installer, so its script drives a long
# list of self-updaters (rustup, uv, corepack, elan, moon, ...). Here almost
# everything is a pacman/AUR package -- rust, uv, pnpm, node, npm, rtk, ripgrep,
# headroom, cli-proxy-api and codex are all repo-owned -- so `paru -Syu` IS the
# toolchain upgrade, and running those installers' self-updaters on top would
# fight the package manager over the same files. What remains is the handful of
# things pacman does not own; this script covers exactly those, then checks the
# pins nothing upgrades automatically.
#
# Run it deliberately, not on a timer: a full -Syu on Arch is a rolling upgrade
# that can want intervention (.pacnew files, keyring bumps, manual pacman -Sy
# fallout). Anything requiring judgement is left to you and merely reported.

repo_root="$HOME/Projects/agents"

echo "=== System packages (pacman/AUR) ==="
# paru covers repo + AUR in one pass. This is the upgrade path for nearly every
# tool on this box, so it runs first: later steps assume current binaries.
paru -Syu

echo
echo "=== tokensave ==="
# The one agent tool NOT under pacman -- it lives in ~/.local/bin and ships its
# own GitHub-release updater. `upgrade` is a no-op when already current. Refresh
# installed agent integrations afterward so any newly added tools receive their
# explicit permissions immediately.
#
# ~/.claude/rules/tokensave.md is a hand-rewritten copy held with `chattr +i`,
# because tokensave otherwise restores it from an embedded template: on
# `reinstall`, and silently on `status`/`sync`/`list`/`gain` once the version
# stamp in ~/.tokensave/state.toml trails the running binary. Those silent paths
# fail harmlessly against the pin (exit 0), but `reinstall` refreshes the MCP
# server, hooks and permissions first and only then exits 1 on the blocked
# rename -- which under `set -e` would abort every step below. So that one
# failure is tolerated by message, and any other reinstall failure still stops
# the run.
#
# The pinned copy is tracked at host/cachyos/tokensave/tokensave.md, which is
# what makes the rewrite recoverable if the pin is ever off when tokensave runs.
# To edit it:
#   sudo chattr -i ~/.claude/rules/tokensave.md
#   <edit, then mirror into the repo copy>
#   sudo chattr +i ~/.claude/rules/tokensave.md
# `tokensave doctor` accepts any body containing "tokensave" and never rewrites,
# so the rewritten wording keeps passing its check. This note lives here rather
# than in the rules file itself, which is loaded into every session and so pays
# for its own length; maintenance reads it from the script instead.
if command -v tokensave >/dev/null 2>&1; then
  tokensave upgrade
  if ! ts_reinstall="$(tokensave reinstall 2>&1)"; then
    echo "$ts_reinstall"
    if ! grep -q 'rules/tokensave\.md.*Operation not permitted' <<<"$ts_reinstall"; then
      echo "tokensave reinstall failed; see above" >&2
      exit 1
    fi
    echo "rules file is pinned (chattr +i) and was kept; everything else refreshed"
  fi
  # tokensave drops a .bak beside the rules file on every write attempt, so the
  # pinned copy accumulates a stale duplicate of itself here.
  rm -f "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/rules/tokensave.md.bak"
else
  echo "tokensave not installed; skipping"
fi

echo
echo "=== Local app repositories ==="
git -C "$HOME/.local/app/bgcmd" pull --ff-only
git -C "$HOME/.local/app/codex-reset-tracker" pull --ff-only

echo
echo "=== chromiumfish ==="
# A pnpm workspace under ~/.local/share/chromiumfish, deliberately NOT upgraded
# automatically: bumping it re-pins the bundled browser version, and the aeon
# profile records a release whose Linux cache unpacked without
# chrome_crashpad_handler while the fetcher accepted it anyway. A silently broken
# browser would take visual QA down with it, so this reports and leaves it.
#   pnpm -C ~/.local/share/chromiumfish update --latest && chromiumfish fetch
# After bumping, verify a real capture still works before relying on it.
if [[ -d "$HOME/.local/share/chromiumfish" ]]; then
  echo "manual by design; upgrade + verify a capture before relying on it:"
  echo "  pnpm -C ~/.local/share/chromiumfish update --latest && chromiumfish fetch"
else
  echo "chromiumfish workspace not present; skipping"
fi

echo
echo "=== Docs mirror ==="
# Refresh the local llms.txt copy from upstream. It is git-ignored rather than
# tracked (see .gitignore), since it can always be re-fetched here. Download to
# a temp file first, then move it into place, so an interrupted or failed fetch
# leaves the existing copy intact. A fetch failure is non-fatal: warn and keep
# the current copy rather than aborting the rest of the run.
agentlang_doc="$repo_root/docs/agentlanguages.dev/llms.txt"
agentlang_tmp="$(mktemp)"
mkdir -p "$(dirname "$agentlang_doc")"
if curl -fsSL -o "$agentlang_tmp" https://agentlanguages.dev/llms.txt; then
  mv "$agentlang_tmp" "$agentlang_doc"
  echo "agentlanguages.dev/llms.txt updated"
else
  rm -f "$agentlang_tmp"
  echo "agentlanguages.dev/llms.txt fetch failed; keeping existing copy" >&2
fi

# docs/scopedcommits.com/llms.txt is deliberately NOT fetched here: the site is
# live but has never published an llms.txt, so the repo's tracked copy is the
# original rather than a mirror. Maintain it by hand; adding a fetch would
# overwrite it with a 404.

echo
echo "=== Marketplace LSP servers ==="
# Nothing above touches these: no package manager owns a hand-fetched jar or a
# SWI-Prolog pack, so they only move here. Each is taken to its latest upstream
# release, verified with a real LSP handshake, and rolled back if that fails --
# upstream has shipped a release that broke Claude Code before, so latest is
# taken on evidence rather than on faith.
# `|| true` because a rolled-back upgrade (exit 1) or an upstream outage (exit 2)
# must not fail the whole run: the previous working server is still in place.
if [[ -x "$repo_root/claude/marketplace/upgrade-servers" ]]; then
  "$repo_root/claude/marketplace/upgrade-servers" || true
else
  echo "upgrade-servers not found at $repo_root/claude/marketplace/upgrade-servers; skipping"
fi

echo
echo "upgrade: done"
