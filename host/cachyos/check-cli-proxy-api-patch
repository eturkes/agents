#!/usr/bin/env python3
"""Exercise cli-proxy-api-patch outcomes with an isolated home and command substitutes."""

import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

DISPATCH = r'''import json, os, pathlib, shutil, sys
name = pathlib.Path(sys.argv[0]).name
args = sys.argv[1:]
root = pathlib.Path(os.environ["PATCH_FIXTURE"])
with (root / "calls").open("a") as stream:
    stream.write(json.dumps([name, *args]) + "\n")
settings = json.loads((root / "settings.json").read_text())
if name == "pacman":
    print("cli-proxy-api-bin " + settings["version"])
elif name == "git":
    if "clone" in args:
        (pathlib.Path(args[-1]) / ".git").mkdir(parents=True)
    elif "apply" in args:
        sys.exit(settings["apply tests" if any(a.startswith("--include") for a in args) else "apply full"])
    elif "rev-parse" in args:
        print("abc1234")
elif name == "go" and args[0] == "test" and "-list" in args:
    print(settings["listed"])
elif name == "go" and args[0] == "test":
    counter = root / "go-tests"
    index = int(counter.read_text()) if counter.exists() else 0
    counter.write_text(str(index + 1))
    sys.exit(settings["go test"][index])
elif name == "go" and args[0] == "build":
    if settings["go build"]:
        sys.exit(settings["go build"])
    shutil.copy("/usr/bin/sleep", args[args.index("-o") + 1])
elif name == "systemctl" and "show" in args:
    if "MainPID" in args:
        pid = root / "pid"
        print(pid.read_text() if pid.exists() else "0")
    else:
        print(settings["ExecStart"])
'''


class Patch(unittest.TestCase):
    def setUp(self):
        source = Path(__file__).with_name("cli-proxy-api-patch")
        temporary = tempfile.TemporaryDirectory(prefix="cli-proxy-api-patch-check-")
        self.addCleanup(temporary.cleanup)
        self.root = Path(temporary.name).resolve()
        self.home = self.root / "home with spaces"
        self.dir = self.home / ".local/app/agents/host/cachyos"
        self.dir.mkdir(parents=True)
        for name in ("cli-proxy-api-patch", "cli-proxy-api-patch.patch", "cli-proxy-api-patch.conf"):
            shutil.copy(source.with_name(name), self.dir / name)
        self.bin = self.root / "bin"
        self.bin.mkdir()
        for name in ("pacman", "git", "go", "systemctl"):
            stub = self.bin / name
            stub.write_text(f"#!{sys.executable}\n" + DISPATCH)
            stub.chmod(0o755)
        self.binary = self.home / ".local/lib/cli-proxy-api-patch/cli-proxy-api"
        self.override = self.home / ".config/systemd/user/cli-proxy-api.service.d/cli-proxy-api-patch.conf"
        self.status = self.home / ".cache/cli-proxy-api-patch/status"
        self.settings = {"version": "8.0.35-1", "apply tests": 0, "apply full": 0, "go test": [1, 0],
                         "go build": 0, "ExecStart": "{ path=/usr/bin/cli-proxy-api ; }",
                         "listed": "TestConvertClaudeRequestToCodex_DeclaresDiscoveredToolAtReference\nok"}
        self.environment = {k: v for k, v in os.environ.items() if not k.startswith("XDG_")} | {
            "HOME": str(self.home), "PATCH_FIXTURE": str(self.root),
            "PATH": str(self.bin) + os.pathsep + os.environ["PATH"],
        }

    def run_patch(self, *args):
        (self.root / "settings.json").write_text(json.dumps(self.settings))
        (self.root / "calls").unlink(missing_ok=True)
        (self.root / "go-tests").unlink(missing_ok=True)
        result = subprocess.run(["bash", str(self.dir / "cli-proxy-api-patch"), *args], env=self.environment,
                                cwd=self.root, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                                timeout=20, check=False)
        calls = self.root / "calls"
        history = [json.loads(line) for line in calls.read_text().splitlines()] if calls.exists() else []
        return result.returncode, result.stdout, history

    def start_service(self):
        process = subprocess.Popen([str(self.binary), "60"])
        self.addCleanup(process.wait)
        self.addCleanup(process.kill)
        (self.root / "pid").write_text(str(process.pid))
        self.settings["ExecStart"] = f"{{ path={self.binary} ; argv[]={self.binary} --config x ; }}"

    def test_apply_installs_build_and_override(self):
        code, output, calls = self.run_patch("apply")
        self.assertEqual(code, 0, output)
        self.assertTrue(os.access(self.binary, os.X_OK))
        self.assertEqual(self.override.read_bytes(), (self.dir / "cli-proxy-api-patch.conf").read_bytes())
        digest = hashlib.sha256((self.dir / "cli-proxy-api-patch.patch").read_bytes()).hexdigest()
        self.assertEqual((self.binary.parent / "build").read_text(), f"8.0.35 {digest}\n")
        self.assertEqual(self.status.read_text(), "active 8.0.35\n")
        self.assertIn(["git", "-C", str(self.home / ".cache/cli-proxy-api-patch/src"), "checkout", "--quiet",
                       "--force", "--detach", "v8.0.35"], calls)
        self.assertIn("Restart pending", output)

    def test_upstream_fix_retires_override(self):
        self.run_patch("apply")
        self.settings |= {"version": "8.0.40-1", "go test": [0]}
        code, output, calls = self.run_patch("apply")
        self.assertEqual(code, 0, output)
        self.assertFalse(self.override.exists())
        self.assertEqual(self.status.read_text(), "retired 8.0.40\n")
        self.assertFalse([call for call in calls if call[:2] == ["go", "build"]], calls)
        code, output, _ = self.run_patch("check")
        self.assertEqual(code, 1, output)
        self.assertIn("not running", output)
        packaged = self.root / "packaged"
        shutil.copy("/usr/bin/sleep", packaged)
        process = subprocess.Popen([str(packaged), "60"])
        self.addCleanup(process.wait)
        self.addCleanup(process.kill)
        (self.root / "pid").write_text(str(process.pid))
        self.settings["ExecStart"] = f"{{ path={packaged} ; argv[]={packaged} --config x ; }}"
        code, output, _ = self.run_patch("check")
        self.assertEqual(code, 0, output)
        self.assertIn("includes the fix", output)
        replacement = packaged.with_name("replacement")
        shutil.copy("/usr/bin/sleep", replacement)
        replacement.replace(packaged)
        code, output, _ = self.run_patch("check")
        self.assertEqual(code, 2, output)
        self.assertIn("previous binary", output)

    def test_probe_without_patch_tests_cannot_retire(self):
        # Test-only apply that adds nothing: upstream's own tests pass the filter vacuously.
        self.settings |= {"listed": "ok", "go test": [0]}
        code, output, calls = self.run_patch("apply")
        self.assertEqual(code, 0, output)
        self.assertTrue(self.override.exists())
        self.assertEqual(self.status.read_text(), "active 8.0.35\n")
        self.assertTrue([call for call in calls if call[:2] == ["go", "build"]], calls)

    def test_conflict_keeps_packaged_binary(self):
        self.run_patch("apply")
        self.settings |= {"version": "8.0.40-1", "apply full": 1}
        code, output, calls = self.run_patch("apply")
        self.assertEqual(code, 2, output)
        self.assertFalse(self.override.exists())
        self.assertTrue(self.status.read_text().startswith("stock 8.0.40: the patch does not apply"))
        self.assertFalse([call for call in calls if call[:2] == ["go", "build"]], calls)
        code, output, _ = self.run_patch("check")
        self.assertEqual(code, 2, output)
        self.assertIn("without the fix", output)

    def test_failing_patch_tests_or_build_keep_packaged_binary(self):
        for change, reason in (({"go test": [1, 1]}, "tests fail"), ({"go build": 3}, "build fails")):
            self.settings |= {"go test": [1, 0], "go build": 0} | change
            code, output, _ = self.run_patch("apply")
            self.assertEqual(code, 2, output)
            self.assertIn(reason, self.status.read_text())
            self.assertFalse(self.override.exists())

    def test_current_build_skips_rebuild(self):
        self.run_patch("apply")
        code, output, calls = self.run_patch("apply")
        self.assertEqual(code, 0, output)
        self.assertIn("is current", output)
        self.assertTrue(self.override.exists())
        self.assertFalse({"git", "go"} & {call[0] for call in calls}, calls)

    def test_check_is_read_only_and_follows_running_binary(self):
        self.run_patch("apply")
        self.start_service()
        code, output, calls = self.run_patch("check")
        self.assertEqual(code, 0, output)
        self.assertIn("build is running", output)
        self.assertFalse({"git", "go"} & {call[0] for call in calls}, calls)
        replacement = self.binary.with_name("replacement")
        shutil.copy("/usr/bin/sleep", replacement)
        replacement.replace(self.binary)
        code, output, _ = self.run_patch("check")
        self.assertEqual(code, 2, output)
        self.assertIn("previous binary", output)
        self.settings["version"] = "8.0.36-1"
        code, output, _ = self.run_patch("check")
        self.assertEqual(code, 2, output)
        self.assertIn("does not match", output)

    def test_check_flags_missing_override_and_stale_unit(self):
        code, output, _ = self.run_patch("check")
        self.assertEqual(code, 2, output)
        self.run_patch("apply")
        code, output, _ = self.run_patch("check")
        self.assertEqual(code, 2, output)
        self.assertIn("does not start", output)
        self.binary.unlink()
        code, output, _ = self.run_patch("check")
        self.assertEqual(code, 1, output)

    def test_rollback_removes_override(self):
        self.run_patch("apply")
        code, output, calls = self.run_patch("rollback")
        self.assertEqual(code, 0, output)
        self.assertFalse(self.override.exists())
        self.assertEqual(self.status.read_text(), "rollback\n")
        self.assertIn(["systemctl", "--user", "daemon-reload"], calls)

    def test_usage(self):
        for args in ((), ("apply", "check"), ("--unknown",)):
            code, output, calls = self.run_patch(*args)
            self.assertEqual(code, 64, output)
            self.assertFalse(calls, calls)


if __name__ == "__main__":
    unittest.main()
