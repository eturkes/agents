#!/usr/bin/env bash
set -euo pipefail
root=$(dirname -- "$(readlink -f -- "$0")")
build=$(mktemp -d)
trap 'rm -rf -- "$build"' EXIT
read -r -a qt_flags <<<"$(pkg-config --cflags --libs Qt6Widgets)"
g++ -fPIC -std=c++17 "$root/inspect.cpp" -o "$build/inspect" "${qt_flags[@]}"
QT_QPA_PLATFORM=offscreen QT_QPA_PLATFORMTHEME=kde XDG_CURRENT_DESKTOP=KDE "$build/inspect" "$@"
