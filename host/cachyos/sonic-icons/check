#!/usr/bin/env bash
set -euo pipefail
root=$(dirname -- "$(readlink -f -- "$0")")
build=$(mktemp -d)
trap 'rm -rf -- "$build"' EXIT
# CachyOS Qt exports protected symbols; PIC avoids copy relocations.
read -r -a qt_flags <<<"$(pkg-config --cflags --libs Qt6Widgets)"
g++ -fPIC -std=c++17 "$root/check.cpp" -o "$build/check" "${qt_flags[@]}"
QT_QPA_PLATFORM=offscreen QT_QPA_PLATFORMTHEME=kde XDG_CURRENT_DESKTOP=KDE "$build/check"
