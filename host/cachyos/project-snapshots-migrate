#!/usr/bin/env python3
"""Move Projects to a native subvolume; fold nested subvolumes into its snapshot coverage."""

import argparse
import ctypes
import fcntl
import json
import os
import shutil
import subprocess
from contextlib import contextmanager
from pathlib import Path


def run(*args):
    result = subprocess.run(args, check=True, text=True, capture_output=True)
    return result.stdout


def is_subvolume(path):
    tree = json.loads(run("bcachefs", "subvolume", "list-snapshots", "--json", str(path)))
    return Path(tree["query_root"]["path"]).resolve() == path.resolve()


def subvolumes(path):
    mount = json.loads(run("findmnt", "--json", "--target", str(path), "--output", "TARGET"))
    root = Path(mount["filesystems"][0]["target"])
    entries = json.loads(run("bcachefs", "subvolume", "list", "--json", "--recursive", "--snapshots", str(root)))
    def descend(rows, parent):
        for entry in rows:
            current = parent / entry["path"]
            if current.is_relative_to(path):
                yield current
            yield from descend(entry.get("children", []), current)

    return list(descend(entries, root))


def nested(source):
    # Native snapshots stop at subvolume roots; .snapshots holds the snapshots themselves.
    return [path for path in subvolumes(source)
            if path != source and not path.is_relative_to(source / ".snapshots")]


def archive_hash(path):
    # Dereference hardlinks, not symlinks: cache subvolumes split cross-boundary hardlinks.
    with subprocess.Popen(
        ["tar", "--sort=name", "--format=gnu", "--hard-dereference", "-C", str(path), "-cf", "-", "."],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    ) as archive:
        digest = subprocess.run(["sha256sum"], stdin=archive.stdout, capture_output=True, text=True, check=True)
        archive.stdout.close()
        errors = archive.stderr.read().decode()
        status = archive.wait()
        if status or errors:
            raise RuntimeError(f"Archive comparison failed ({status}): {errors.strip()}")
    return digest.stdout.split()[0]


def open_references(source):
    prefix = str(source) + "/"
    references = []
    for process in Path("/proc").iterdir():
        if not process.name.isdecimal():
            continue
        try:
            links = [process / "cwd", process / "root", *(process / "fd").iterdir()]
            targets = []
            for link in links:
                try:
                    targets.append(os.readlink(link))
                except OSError:
                    pass
            try:
                targets.extend(line.split(maxsplit=5)[5].strip() for line in (process / "maps").read_text().splitlines() if len(line.split(maxsplit=5)) == 6)
            except (OSError, ProcessLookupError):
                pass
            if any(target == str(source) or target.startswith(prefix) for target in targets):
                references.append(f"{process.name} {(process / 'comm').read_text().strip()}")
        except (OSError, ProcessLookupError):
            continue
    return references


def require_idle(source):
    references = open_references(source)
    if references:
        raise RuntimeError(f"{source} has open process references; close them first: " + ", ".join(references))


@contextmanager
def paused(units):
    active = []
    try:
        # Stop timers before querying services they can activate.
        for unit in sorted(units, key=lambda value: (not value.endswith(".timer"), value)):
            status = subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit], check=False).returncode
            if status == 0:
                active.append(unit)
                subprocess.run(["systemctl", "--user", "stop", unit], check=True)
        yield
    finally:
        failures = []
        for unit in reversed(active):
            if subprocess.run(["systemctl", "--user", "start", unit], check=False).returncode:
                failures.append(unit)
        if failures:
            raise RuntimeError("Restart these units: " + " ".join(failures))


def exchange(first, second):
    libc = ctypes.CDLL(None, use_errno=True)
    rename = libc.renameat2
    rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    rename.restype = ctypes.c_int
    if rename(-100, os.fsencode(first), -100, os.fsencode(second), 2):
        code = ctypes.get_errno()
        raise OSError(code, os.strerror(code))


def fold(path):
    # Staging stays beside the cache: renameat2 exchange across subvolumes fails with EXDEV.
    staged = path.with_name(path.name + ".snapshot-fold")
    if staged.exists():
        raise RuntimeError(f"Resolve the retained fold copy first: {staged}")
    inner = [child for child in subvolumes(path) if child != path]
    if inner:
        raise RuntimeError("Fold its nested subvolumes first: " + ", ".join(map(str, inner)))
    parent_times = path.parent.stat()
    require_idle(path)
    staged.mkdir()
    try:
        # A full copy rewrites NoCoW extents, which carry no data checksums.
        run("cp", "-a", "--reflink=never", "--", str(path) + "/.", str(staged) + "/")
        delta = run("rsync", "-aHAXnci", "--delete", "--", str(path) + "/", str(staged) + "/")
        if delta:
            raise RuntimeError(f"Folded copy differs: {path}\n{delta}")
        require_idle(path)
        os.sync()
    except BaseException:
        shutil.rmtree(staged)
        raise
    try:
        exchange(path, staged)
    except OSError:
        # renameat2 failed, so nothing moved and staged is still the copy.
        shutil.rmtree(staged)
        raise
    # From here staged = the original subvolume; every exit keeps it until the late comparison passes.
    # Checksums: the quick check accepts an equal-size rewrite within the same second.
    late = run("rsync", "-aHAXnci", "--delete", "--", str(staged) + "/", str(path) + "/")
    if late:
        raise RuntimeError(f"The original subvolume changed during the fold; it stays at {staged}:\n{late}")
    run("bcachefs", "subvolume", "delete", str(staged))
    os.utime(path.parent, ns=(parent_times.st_atime_ns, parent_times.st_mtime_ns))


def migrate(source, state, units=()):
    source = source.absolute()
    if source.is_symlink() or source.resolve() != source or not source.is_dir():
        raise ValueError("Projects must be a real directory with resolved parents.")
    folds = sorted(nested(source), key=lambda path: len(path.parts), reverse=True)
    retained = [str(path) for path in folds if path.name.endswith(".snapshot-fold")]
    if retained:
        raise RuntimeError("An interrupted fold kept these original subvolumes: " + ", ".join(retained)
                           + ". Compare each with its folded path, then delete it with bcachefs subvolume delete.")
    if folds:
        skipped = []
        with paused(units):
            for path in folds:
                print(f"Folding {path} into the snapshot tree.", flush=True)
                try:
                    fold(path)
                except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
                    skipped.append(f"{path}: {getattr(error, 'stderr', None) or error}")
        if skipped:
            raise RuntimeError("These nested subvolumes stay outside snapshots:\n" + "\n".join(skipped))
    if is_subvolume(source):
        print("Projects is a native subvolume; snapshots cover the whole tree.", flush=True)
        return
    if state.resolve().is_relative_to(source):
        raise ValueError("Keep migration state outside Projects.")
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    staged = state / "staged"
    marker = state / "source.json"
    identity = {"source": str(source), "inode": source.stat().st_ino, "device": source.stat().st_dev}
    if staged.exists():
        if not marker.exists() or json.loads(marker.read_text()) != identity or not is_subvolume(staged):
            raise RuntimeError(f"Inspect the existing migration stage: {staged}")
        if subvolumes(staged) != [staged]:
            raise RuntimeError(f"Inspect the partially prepared cache subvolumes: {staged}")
    else:
        marker.write_text(json.dumps(identity) + "\n")
        run("bcachefs", "subvolume", "create", str(staged))
        print("Preparing a reflink copy; the original Projects directory stays active.", flush=True)
        run("cp", "-a", "--reflink=always", "--", str(source) + "/.", str(staged) + "/")
    with paused(units):
        require_idle(source)
        print("Writers paused. Synchronizing the final changes.", flush=True)
        run("rsync", "-aHAX", "--delete", "--", str(source) + "/", str(staged) + "/")
        print("Comparing complete file contents and archive metadata with SHA-256.", flush=True)
        original_hash = archive_hash(source)
        copied_hash = archive_hash(staged)
        if original_hash != copied_hash:
            raise RuntimeError(f"Projects copy differs: original={original_hash} staged={copied_hash}")
        require_idle(source)
        os.sync()
        exchange(source, staged)
        evidence = identity | {"archive_sha256": original_hash}
        (state / "verified.json").write_text(json.dumps(evidence, indent=2) + "\n")
        # After exchange, staged = the original → retired only after content equality + the atomic switch.
        shutil.rmtree(staged)
        marker.unlink()
        print("Projects migration is complete. File contents match. The paused units restart now.", flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--pause-unit", action="append", default=[], help="Stop an active user unit during migration. Restart it after migration.")
    args = parser.parse_args()
    home = Path.home().resolve()
    state = home / ".local/state/project-snapshots"
    state.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (state / "migration.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        migrate(home / "Projects", state / "migration", args.pause_unit)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        detail = error.stderr if isinstance(error, subprocess.CalledProcessError) else str(error)
        raise SystemExit(f"Migration stopped: {detail}") from error
