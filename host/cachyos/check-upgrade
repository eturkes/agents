#!/usr/bin/env python3
"""Exercise upgrade status handling with isolated homes and command substitutes."""

import json
import os
import shlex
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

DISPATCH = r'''import json, os, pathlib, sys
name = pathlib.Path(sys.argv[0]).name
args = sys.argv[1:]
root = pathlib.Path(os.environ["UPGRADE_FIXTURE"])
with (root / "calls").open("a") as stream:
    stream.write(json.dumps([name, *args]) + "\n")
settings = json.loads((root / "settings.json").read_text())
if name == "sudo":
    assert args.pop(0) == "-n", args
    os.execvp(args[0], args)
key = name
if name == "pacman":
    key += " " + " ".join(args)
elif name == "systemctl":
    key += " user" if "--user" in args else " system"
    key += " after" if (root / "updated").exists() else " before"
elif name == "chromiumfish" and args == ["path"]:
    key += " path"
elif name == "paru":
    (root / "updated").touch()
value = settings.get(key, ["", 0])
print(value[0], end="")
sys.exit(value[1])
'''


class Upgrade(unittest.TestCase):
    def setUp(self):
        source = Path(os.environ.get("UPGRADE_CHECK_SCRIPT", Path(__file__).with_name("upgrade")))
        temporary = tempfile.TemporaryDirectory(prefix="upgrade-check-", dir=Path(__file__).parent)
        self.addCleanup(temporary.cleanup)
        self.root = Path(temporary.name).resolve()
        self.home = self.root / "home with spaces"
        self.repo = self.home / ".local/app/agents"
        self.script = self.repo / "host/cachyos/upgrade"
        self.script.parent.mkdir(parents=True)
        self.script.write_bytes(source.read_bytes())
        self.bin = self.root / "bin"
        self.bin.mkdir()
        dispatcher = f"#!{sys.executable}\n" + DISPATCH
        names = [
            "sudo", "pacman", "dkms", "systemctl", "nvidia-smi", "codex", "codexify",
            "browseros-call", "pacdiff", "paru", "uv", "moon", "git", "pnpm", "chromiumfish",
        ]
        for name in names:
            self.write(self.bin / name, dispatcher)
        for name in ("kernel-recovery", "agent-crash-policy", "cache-retention", "project-snapshots"):
            self.write(self.script.parent / name, dispatcher)
        self.write(self.repo / "claude/marketplace/upgrade-servers", dispatcher)
        self.write(self.root / "browser/chrome_crashpad_handler", "#!/bin/sh\nexit 0\n")
        (self.home / ".local/share/chromiumfish").mkdir(parents=True)
        self.settings = {
            "pacman -Dk": ["No database errors have been found!\n", 0],
            "pacman -Qql": ["/usr/lib/modules/7.0-test/pkgbase\n/usr/lib/modules/6.9-test/pkgbase\n", 0],
            "dkms": [
                "".join(f"{module}/1, {kernel}, x86_64: installed\n"
                        for module in ("bcachefs", "nvidia") for kernel in ("7.0-test", "6.9-test")), 0,
            ],
            "codex": ["codex-cli 1.0\n", 0],
            "chromiumfish path": [str(self.root / "browser/chrome") + "\n", 0],
            "project-snapshots": ["Project snapshots: 4 retained. Physical usage: unavailable.\n", 0],
        }
        self.environment = os.environ | {
            "HOME": str(self.home), "UPGRADE_FIXTURE": str(self.root),
            "PATH": str(self.bin) + os.pathsep + os.environ["PATH"],
            "MOON_HOME": str(self.home / ".moon"),
        }

    @staticmethod
    def write(path, content):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)
        path.chmod(0o755)

    def run_upgrade(self, *args, tty=False):
        (self.root / "settings.json").write_text(json.dumps(self.settings))
        command = ["bash", str(self.script), *args]
        if tty:
            command = ["script", "-qefc", shlex.join(command), "/dev/null"]
        result = subprocess.run(command, env=self.environment, cwd=self.root, input="",
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                                timeout=20, check=False)
        calls = self.root / "calls"
        history = [json.loads(line) for line in calls.read_text().splitlines()] if calls.exists() else []
        return result.returncode, result.stdout, history

    def test_check_is_read_only_and_cwd_independent(self):
        code, output, calls = self.run_upgrade("--check")
        self.assertEqual(code, 0, output)
        names = {call[0] for call in calls}
        self.assertTrue({"pacman", "dkms", "kernel-recovery", "systemctl", "agent-crash-policy",
                         "nvidia-smi", "codex", "codexify", "browseros-call", "pacdiff",
                         "project-snapshots"} <= names, names)
        self.assertTrue(names.isdisjoint({"paru", "uv", "moon", "git", "pnpm", "cache-retention"}), names)
        self.assertIn(["project-snapshots", "report"], calls)
        self.assertIn("Summary:", output)
        self.assertIn("manual", output.lower())

    def test_upgrade_requires_a_terminal_before_package_work(self):
        code, output, calls = self.run_upgrade()
        self.assertEqual(code, 64, output)
        self.assertFalse(calls, calls)

    def test_unknown_option_cannot_update(self):
        code, output, calls = self.run_upgrade("--unknown", tty=True)
        self.assertEqual(code, 64, output)
        self.assertFalse(calls, calls)

    def test_marker_is_reviewed_and_stock_check_runs(self):
        self.settings["pacman -Dk"] = [
            ("error: 'CACHY_UPDATE_NOTICE': description file is missing\n"
             "error: 'CACHY_UPDATE_NOTICE': file list is missing\n"), 1,
        ]
        code, output, calls = self.run_upgrade("--check")
        self.assertEqual(code, 2, output)
        self.assertIn("REVIEW", output)
        self.assertIn("CACHY_UPDATE_NOTICE", output)
        self.assertIn(["pacman", "-Dk"], calls)
        self.assertNotIn("FAIL", output)

    def test_package_error_beside_marker_stays_failure(self):
        self.settings["pacman -Dk"] = [
            ("error: 'CACHY_UPDATE_NOTICE': file list is missing\n"
             "error: 'broken-package': description file is missing\n"), 1,
        ]
        code, output, calls = self.run_upgrade("--check")
        self.assertEqual(code, 1, output)
        self.assertIn("broken-package", output)
        self.assertIn(["project-snapshots", "report"], calls)

    def test_dkms_requires_both_modules_for_every_installed_kernel(self):
        self.settings["dkms"][0] = self.settings["dkms"][0].replace(
            "nvidia/1, 6.9-test, x86_64: installed\n", "")
        code, output, _ = self.run_upgrade("--check")
        self.assertEqual(code, 1, output)
        self.assertIn("nvidia", output)
        self.assertIn("6.9-test", output)

    def test_check_continues_after_failed_command(self):
        self.settings["nvidia-smi"] = ["Driver/library mismatch\n", 9]
        code, output, calls = self.run_upgrade("--check")
        self.assertEqual(code, 1, output)
        self.assertIn("Driver/library mismatch", output)
        self.assertIn(["project-snapshots", "report"], calls)

    def test_configuration_files_need_manual_review(self):
        self.settings["pacdiff"] = ["/etc/example.conf.pacnew\n", 0]
        code, output, _ = self.run_upgrade("--check")
        self.assertEqual(code, 2, output)
        self.assertIn("/etc/example.conf.pacnew", output)
        self.assertIn("sudo pacdiff", output)

    def test_codexify_release_information_is_reported(self):
        self.settings["codexify"] = ["PASS updates: New Codexify version 2.0 is available\n", 0]
        code, output, _ = self.run_upgrade("--check")
        self.assertEqual(code, 0, output)
        self.assertIn("New Codexify version 2.0 is available", output)

    def test_codexify_warnings_need_review_even_with_zero_exit(self):
        self.settings["codexify"] = ["WARN configuration: Optional configuration needs review\n", 0]
        code, output, _ = self.run_upgrade("--check")
        self.assertEqual(code, 2, output)
        self.assertIn("Optional configuration needs review", output)

    def test_preexisting_and_new_unit_failures_are_distinct(self):
        old = "old.service loaded failed failed Existing problem\n"
        new = "new.service loaded failed failed New problem\n"
        self.settings["systemctl user before"] = [old, 0]
        self.settings["systemctl user after"] = [old + new, 0]
        code, output, calls = self.run_upgrade(tty=True)
        self.assertEqual(code, 1, output)
        self.assertIn("pre-existing", output)
        self.assertIn("new.service", output)
        baseline = next(index for index, call in enumerate(calls) if call[0] == "systemctl")
        self.assertLess(baseline, calls.index(["paru", "-Syu"]))

    def test_only_preexisting_failed_units_need_review(self):
        old = "old.service loaded failed failed Existing problem\n"
        self.settings["systemctl user before"] = [old, 0]
        self.settings["systemctl user after"] = [old, 0]
        code, output, _ = self.run_upgrade(tty=True)
        self.assertEqual(code, 2, output)
        self.assertIn("pre-existing", output)
        self.assertNotIn("FAIL", output)

    def test_failed_update_stops_later_updates_and_runs_checks(self):
        self.settings["paru"] = ["Package transaction failed\n", 7]
        code, output, calls = self.run_upgrade(tty=True)
        self.assertEqual(code, 1, output)
        self.assertIn("7", output)
        self.assertNotIn("uv", {call[0] for call in calls})
        self.assertIn(["pacman", "-Dk"], calls)
        self.assertIn(["project-snapshots", "report"], calls)

    def test_crashpad_gate_still_rejects_empty_handler(self):
        self.write(self.root / "browser/chrome_crashpad_handler", "")
        code, output, calls = self.run_upgrade(tty=True)
        self.assertEqual(code, 1, output)
        self.assertIn("unrunnable chrome_crashpad_handler", output)
        self.assertNotIn("cache-retention", {call[0] for call in calls})
        self.assertIn(["project-snapshots", "report"], calls)

    def require_chromiumfish_path_failure(self, output):
        self.settings["chromiumfish path"] = [output, 23]
        # A valid handler in cwd exposes dirname's empty-path fallback without a download.
        self.write(self.root / "chrome_crashpad_handler", "#!/bin/sh\nexit 0\n")
        code, output, calls = self.run_upgrade(tty=True)
        self.assertEqual(code, 1, output)
        self.assertIn("Update stopped during Headless browser (chromiumfish) (exit 23)", output)
        self.assertNotIn("upgrade-servers", {call[0] for call in calls})
        self.assertNotIn("cache-retention", {call[0] for call in calls})
        self.assertIn(["project-snapshots", "report"], calls)

    def test_chromiumfish_path_failure_with_empty_output(self):
        self.require_chromiumfish_path_failure("")

    def test_chromiumfish_path_failure_with_valid_path_output(self):
        self.require_chromiumfish_path_failure(str(self.root / "browser/chrome") + "\n")

    def test_baseline_failure_prevents_updates(self):
        self.settings["systemctl system before"] = ["Cannot connect to system bus\n", 1]
        code, output, calls = self.run_upgrade(tty=True)
        self.assertEqual(code, 1, output)
        self.assertNotIn("paru", {call[0] for call in calls})
        self.assertIn("Cannot connect to system bus", output)


if __name__ == "__main__":
    unittest.main()
