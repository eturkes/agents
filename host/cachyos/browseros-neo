#!/bin/bash
set -euo pipefail

while IFS='=' read -r key value; do
  case "$key" in
    DISPLAY|XAUTHORITY|XDG_SESSION_TYPE|XDG_CURRENT_DESKTOP) export "$key=$value" ;;
  esac
done < <(systemctl --user show-environment)

systemctl --user start psd.service
install -d -m700 /tmp/browser-claw-home-cache
export LD_LIBRARY_PATH="/usr/lib/browserclaw${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
here=$(dirname "$(readlink -f "$0")")
# The AUR doctor deletes applied OTA migrations using the older bundled binary.
# Neo 0.51.2.3 starts with signin.allowed=false (every OAuth route); a managed primary account + a runtime sign-in
# re-check (onboarding Reconnect) → Chromium's "Profile will be deleted" dialog ⇒ sign-in allowed from startup.
exec "$here/browseros-neo-signin" /usr/lib/browserclaw/browserclaw --password-store=basic --profile-directory=Default \
  --allow-browser-signin=true "$@"
