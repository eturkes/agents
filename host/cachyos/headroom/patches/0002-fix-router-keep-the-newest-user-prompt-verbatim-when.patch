From cf098ba533213f97bc1e16930609d11adde9b7f1 Mon Sep 17 00:00:00 2001
From: Emir Turkes <eturkes@bu.edu>
Date: Wed, 7 Oct 2026 21:48:08 +0900
Subject: [PATCH 2/4] fix(router): keep the newest user prompt verbatim when
 system messages follow it

#3619/#3923 protect the newest user turn only when it is the final message
(messages_from_end == 1). Claude Code appends role:"system" messages after
the user's prompt (deferred-tool deltas, hook output), so on every
cache-mode delta turn the prompt sat at messages_from_end == 2 and its text
was compressed under the coding profile. End to end through a real
`claude -p` two-turn session on v0.40.0: a 28,085-char follow-up prompt
reached upstream as 18,439 chars, its opening instruction dropped.

The newest turn is now the last message that is not system/developer.
The fenced-command observation rule is unchanged, and a trailing system
message does not turn an observation into a prompt (second test).
---
 headroom/transforms/content_router.py   | 12 +++++-
 tests/test_transforms_content_router.py | 49 +++++++++++++++++++++++++
 2 files changed, 60 insertions(+), 1 deletion(-)

diff --git a/headroom/transforms/content_router.py b/headroom/transforms/content_router.py
index 848cb81f..c8fbc7f6 100644
--- a/headroom/transforms/content_router.py
+++ b/headroom/transforms/content_router.py
@@ -5685,6 +5685,16 @@ class ContentRouter(Transform):
             ),
             num_messages,
         )
+        # The newest turn: the last message that is not a system/developer
+        # message. Claude Code appends role:"system" reminders (deferred-tool
+        # deltas, hook output) AFTER the user's prompt, so the prompt is not
+        # always the final message.
+        newest_turn_index = num_messages - 1
+        while newest_turn_index > 0 and (
+            isinstance(messages[newest_turn_index], dict)
+            and messages[newest_turn_index].get("role") in {"system", "developer"}
+        ):
+            newest_turn_index -= 1
         model_limit = kwargs.get("model_limit", 0)
 
         # Adaptive Read protection: protect a fraction of recent messages
@@ -5922,7 +5932,7 @@ class ContentRouter(Transform):
                 and role == "user"
                 and (
                     i < first_assistant_index
-                    or (messages_from_end == 1 and not _answers_fenced_command(messages, i))
+                    or (i == newest_turn_index and not _answers_fenced_command(messages, i))
                 )
             )
 
diff --git a/tests/test_transforms_content_router.py b/tests/test_transforms_content_router.py
index f7e2aee9..ecd20a69 100644
--- a/tests/test_transforms_content_router.py
+++ b/tests/test_transforms_content_router.py
@@ -2489,6 +2489,55 @@ def test_follow_up_prompt_string_after_assistant_turn_is_verbatim_under_replay(
     assert follow_up not in calls
 
 
+def test_follow_up_prompt_before_trailing_system_messages_is_verbatim_under_replay(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    # Claude Code appends role:"system" reminders (deferred-tool deltas, hook
+    # output) after the user's prompt, so the prompt is not the final message.
+    router, calls = _prompt_router(monkeypatch)
+    follow_up = "Now also handle the async path in tenacity/asyncio. " * 60
+    messages = [
+        {"role": "user", "content": "run the tests"},
+        {"role": "assistant", "content": "All 167 tests pass on the sync path."},
+        {"role": "user", "content": follow_up},
+        {"role": "system", "content": [{"type": "text", "text": "Deferred tools now available."}]},
+        {"role": "system", "content": "A hook reported success."},
+    ]
+    out = router.apply(
+        messages,
+        _ChurnTokenizer(),
+        model_limit=100_000,
+        prefix_replay_guaranteed=True,
+        compress_user_messages=True,
+        min_tokens_to_compress=1,
+    )
+    assert out.messages[2]["content"] == follow_up
+    assert follow_up not in calls
+
+
+def test_text_harness_observation_before_trailing_system_message_still_compresses(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    # A trailing system message does not turn a fenced command's output into
+    # a prompt: the observation still compresses.
+    router, calls = _prompt_router(monkeypatch)
+    messages = [
+        {"role": "user", "content": "run the tests"},
+        {"role": "assistant", "content": "```bash\npytest -q\n```"},
+        {"role": "user", "content": [{"type": "text", "text": _FRESH_CC_OUTPUT}]},
+        {"role": "system", "content": "A hook reported success."},
+    ]
+    router.apply(
+        messages,
+        _ChurnTokenizer(),
+        model_limit=100_000,
+        prefix_replay_guaranteed=True,
+        compress_user_messages=True,
+        min_tokens_to_compress=1,
+    )
+    assert _FRESH_CC_OUTPUT in calls
+
+
 def test_text_harness_observation_text_block_still_compresses_under_replay(
     monkeypatch: pytest.MonkeyPatch,
 ) -> None:
