+    assert recovered[-1]["content"] == "compressed:openai"
+    assert recovered_result is not None
+
+
+@pytest.mark.skipif(not os.path.exists("/proc/self/task"), reason="requires /proc")
+async def test_repeated_timeouts_do_not_accumulate_workers(monkeypatch) -> None:
+    """The live failure mode: every image timeout replaced the pool but left
+    the old worker running, so workers accumulated (~1 GiB each) until the
+    host ran out of CPU and RAM. After a burst of timed-out jobs, NO worker
+    processes may remain."""
+    monkeypatch.setattr(image_isolation, "_IMAGE_WORKER", image_isolation._sleep_worker)
+
+    for _ in range(6):
+        messages = _messages()
+        returned, result = await image_isolation.run_image_compression_isolated(
+            messages,
+            provider="openai",
+            timeout=0.05,
+        )
+        assert returned is messages
+        assert result is None
+
+    deadline = time.monotonic() + 30.0
+    while time.monotonic() < deadline and _live_spawn_worker_pids():
+        await asyncio.sleep(0.1)
+    leftovers = _live_spawn_worker_pids()
+    assert not leftovers, f"image workers accumulated after timeouts: {sorted(leftovers)}"
+
+
+class _RecordingPool:
+    """Executor stand-in exposing only the private process table (the shape
+    `_force_stop_workers_compat` relies on for Python < 3.14)."""
+
+    def __init__(self, procs) -> None:
+        self._processes = dict(enumerate(procs))
+        self.shutdown_calls: list[tuple[bool, bool]] = []
+
+    def shutdown(self, wait: bool = True, *, cancel_futures: bool = False) -> None:
+        self.shutdown_calls.append((wait, cancel_futures))
+
+
+class _StubbornProc:
+    """Fake worker that survives SIGTERM and dies only on SIGKILL."""
+
+    pid = 999_999
+
+    def __init__(self) -> None:
+        self.terminated = False
+        self.killed = False
+
+    def is_alive(self) -> bool:
+        return not self.killed
+
+    def terminate(self) -> None:
+        self.terminated = True
+
+    def kill(self) -> None:
+        self.killed = True
+
+
+def test_compat_hard_stop_terminates_real_worker_without_public_api() -> None:
+    """Python 3.10–3.13 path: no terminate_workers()/kill_workers() on the
+    executor — the private-table fallback must still kill a live worker."""
+    import multiprocessing
+
+    ctx = multiprocessing.get_context("spawn")
+    proc = ctx.Process(target=time.sleep, args=(120.0,), daemon=True)
+    proc.start()
+    try:
+        pool = _RecordingPool([proc])
+        image_isolation._hard_stop_pool_workers(pool, grace=5.0)
+
+        deadline = time.monotonic() + 15.0
+        while time.monotonic() < deadline and proc.is_alive():
+            time.sleep(0.05)
+        assert not proc.is_alive(), "compat fallback left the worker running"
+        assert pool.shutdown_calls == [(False, True)]
+    finally:
+        if proc.is_alive():
+            proc.kill()
+        proc.join(timeout=5.0)
+
+
+def test_compat_hard_stop_escalates_to_kill() -> None:
+    stubborn = _StubbornProc()
+    pool = _RecordingPool([stubborn])
+
+    image_isolation._hard_stop_pool_workers(pool, grace=0.2)
+
+    assert stubborn.terminated
+    assert stubborn.killed
+    assert pool.shutdown_calls == [(False, True)]
+
+
+def test_public_api_hard_stop_signals_before_shutdown_and_escalates() -> None:
+    """3.14+ path: terminate first, kill after the grace period, and only
+    then shutdown() — shutdown() drops the process table, so signalling
+    afterwards would be a silent no-op."""
+
+    class _FakePool(_RecordingPool):
+        def __init__(self, procs) -> None:
+            super().__init__(procs)
+            self.calls: list[str] = []
+
+        def terminate_workers(self) -> None:
+            assert self.shutdown_calls == [], "signalled after shutdown()"
+            self.calls.append("terminate")
+
+        def kill_workers(self) -> None:
+            assert self.shutdown_calls == [], "signalled after shutdown()"
+            self.calls.append("kill")
+
+    stubborn = _StubbornProc()
+    pool = _FakePool([stubborn])
+    image_isolation._hard_stop_pool_workers(pool, grace=0.2)
+    assert pool.calls == ["terminate", "kill"]
+    assert pool.shutdown_calls == [(False, True)]
+
+
+def test_public_api_hard_stop_skips_kill_when_workers_exit_in_grace() -> None:
+    class _DocileProc:
+        pid = 999_998
+
+        def __init__(self) -> None:
+            self.stopped = False
+
+        def is_alive(self) -> bool:
+            return not self.stopped
+
+    class _FakePool(_RecordingPool):
+        def __init__(self, procs) -> None:
+            super().__init__(procs)
+            self.calls: list[str] = []
+
+        def terminate_workers(self) -> None:
+            self.calls.append("terminate")
+            for proc in self._processes.values():
+                proc.stopped = True
+
+        def kill_workers(self) -> None:
+            self.calls.append("kill")
+
+    pool = _FakePool([_DocileProc()])
+    image_isolation._hard_stop_pool_workers(pool, grace=5.0)
+    assert pool.calls == ["terminate"]
+    assert pool.shutdown_calls == [(False, True)]
+
+
+def test_handlers_gate_isolation_on_image_decision() -> None:
+    """Drift-lock: both handler call sites must reach
+    run_image_compression_isolated only behind ImageCompressionDecision, so a
+    disabled image gate (--no-image-optimize / --no-optimize / bypass) can
+    never instantiate an image worker."""
+    for src in (
+        inspect.getsource(AnthropicHandlerMixin.handle_anthropic_messages),
+        inspect.getsource(OpenAIHandlerMixin.handle_openai_chat),
+    ):
+        gate = src.index("_image_decision.should_compress")
+        call = src.index("run_image_compression_isolated(")
+        assert gate < call
+
+
+def test_skipping_decision_never_instantiates_pool() -> None:
+    """Deciding NOT to compress must not create the image pool (and with the
+    gate drift-lock above, the handlers then never instantiate a worker)."""
+    from types import SimpleNamespace
+
+    from headroom.proxy.image_compression_decision import ImageCompressionDecision
+
+    for config in (
+        SimpleNamespace(optimize=True, image_optimize=False),
+        SimpleNamespace(optimize=False, image_optimize=True),
+    ):
+        decision = ImageCompressionDecision.decide(
+            headers={},
+            config=config,
+            messages=[{"role": "user", "content": "img"}],
+        )
+        assert decision.should_compress is False
+
+    with image_isolation._IMAGE_POOL_LOCK:
+        assert image_isolation._IMAGE_POOL is None
