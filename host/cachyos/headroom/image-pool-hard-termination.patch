index 5dc7baa9..62252dfd 100644
--- a/headroom/image/compressor.py
+++ b/headroom/image/compressor.py
@@ -24,6 +24,7 @@ from __future__ import annotations
 import base64
 import io
 import logging
+import os
 import re
 from dataclasses import dataclass
 from typing import TYPE_CHECKING, Any
@@ -97,6 +98,66 @@ def _reset_resolved_ocr_for_tests() -> None:
     _RESOLVED_OCR = None
 
 
+def _ocr_thread_limit(env_var: str) -> int:
+    """Resolve an OCR ONNX thread bound from the environment (default 1)."""
+    try:
+        value = int(os.environ.get(env_var, "1"))
+    except ValueError:
+        return 1
+    return value if value >= 1 else 1
+
+
+def _build_ocr_engine(ocr_cls: Any, api_version: str | None) -> Any:
+    """Construct a RapidOCR engine with bounded ONNX Runtime threading.
+
+    RapidOCR defaults intra/inter-op thread counts to ``-1`` (automatic) for
+    EACH of its detector / classifier / recognizer sessions, so one engine
+    matured to ~65 native threads on an 8-CPU host. Since the engine runs in
+    Headroom's dedicated single-purpose image worker, bound it to 1 thread per
+    session (overridable via ``HEADROOM_OCR_INTRA_THREADS`` /
+    ``HEADROOM_OCR_INTER_THREADS``).
+
+    Falls back to a parameterless engine when the installed backend rejects
+    the settings (unknown key shapes in old/new releases) — a working
+    unbounded engine beats no OCR.
+    """
+    intra = _ocr_thread_limit("HEADROOM_OCR_INTRA_THREADS")
+    inter = _ocr_thread_limit("HEADROOM_OCR_INTER_THREADS")
+    if api_version == "v3":
+        # rapidocr 3.x: dotted keys override the engine config for the
+        # shared onnxruntime backend.
+        params = {
+            "EngineConfig.onnxruntime.intra_op_num_threads": intra,
+            "EngineConfig.onnxruntime.inter_op_num_threads": inter,
+        }
+        try:
+            return ocr_cls(params=params)
+        except Exception as exc:
+            logger.warning(
+                "OCR engine rejected thread bounds; retrying unbounded "
+                "(event=ocr_thread_bounds_rejected, api=v3): %s",
+                exc,
+            )
+            return ocr_cls()
+    if api_version == "v1":
+        # rapidocr-onnxruntime 1.4.x: `Global.`-prefixed kwargs override the
+        # bundled config's session settings.
+        params = {
+            "Global.intra_op_num_threads": intra,
+            "Global.inter_op_num_threads": inter,
+        }
+        try:
+            return ocr_cls(**params)
+        except Exception as exc:
+            logger.warning(
+                "OCR engine rejected thread bounds; retrying unbounded "
+                "(event=ocr_thread_bounds_rejected, api=v1): %s",
+                exc,
+            )
+            return ocr_cls()
+    return ocr_cls()
+
+
 @dataclass
 class CompressionResult:
     """Result of image compression."""
@@ -424,7 +485,7 @@ class ImageCompressor:
 
         if not hasattr(self, "_ocr_engine"):
             try:
-                self._ocr_engine = ocr_cls()
+                self._ocr_engine = _build_ocr_engine(ocr_cls, api_version)
             except Exception as exc:
                 logger.warning(
                     "OCR engine init failed (event=ocr_engine_init_failed, api=%s): %s",
