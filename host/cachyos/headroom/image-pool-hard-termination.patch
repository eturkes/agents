diff --git a/headroom/proxy/image_isolation.py b/headroom/proxy/image_isolation.py
index 2e2addf5..3b59bc4b 100644
--- a/headroom/proxy/image_isolation.py
+++ b/headroom/proxy/image_isolation.py
@@ -4,6 +4,7 @@ import asyncio
 import logging
 import multiprocessing
 import os
+import sys
 import threading
 import time
 from collections.abc import Callable
@@ -16,6 +17,27 @@ logger = logging.getLogger("headroom.proxy")
 _IMAGE_POOL_LOCK = threading.Lock()
 _IMAGE_POOL: ProcessPoolExecutor | None = None
 
+# Admission control: the pool has exactly one worker, so admitting more than
+# one in-flight job only builds a queue inside the executor. Queued jobs used
+# to start their `asyncio.wait_for` clock at submission, which meant they
+# could "time out" before their work had even begun executing — and each such
+# phantom timeout reset the pool and spawned another worker process. A single
+# slot keeps the timeout clock honest: it starts only once the job owns the
+# worker.
+_IMAGE_JOB_SLOT = threading.BoundedSemaphore(1)
+
+# How long a request may wait for the admission slot before failing open
+# (forwarding the original payload). Deliberately short: image compression is
+# best-effort, and a busy worker means the previous job is already slow.
+_ADMISSION_TIMEOUT_SECONDS = float(
+    os.environ.get("HEADROOM_IMAGE_ADMISSION_TIMEOUT_SECONDS", "1.0")
+)
+_ADMISSION_POLL_SECONDS = 0.02
+
+# Grace period between SIGTERM (terminate) and SIGKILL (kill) when hard-
+# stopping a retired pool's workers.
+_TERMINATE_GRACE_SECONDS = float(os.environ.get("HEADROOM_IMAGE_TERMINATE_GRACE_SECONDS", "5.0"))
+
 # Per-worker-process cached compressor. The image pool is a persistent
 # single-worker ProcessPoolExecutor, so building a fresh ImageCompressor (and,
 # inside it, a fresh ONNX router loading native ort.InferenceSession models) on
@@ -91,6 +113,19 @@ def _abort_worker(
     os.abort()
 
 
+def _pidfile_sleep_worker(
+    messages: list[dict[str, Any]],
+    provider: str,
+) -> tuple[list[dict[str, Any]], dict[str, Any] | None]:
+    """Test worker: publish this process's PID, then sleep far past any test
+    timeout. Lets tests observe the worker process and assert it is actually
+    terminated after a timeout (not merely abandoned)."""
+    with open(messages[0]["content"], "w") as fh:
+        fh.write(str(os.getpid()))
+    time.sleep(120.0)
+    return messages, None
+
+
 _IMAGE_WORKER: Callable[
     [list[dict[str, Any]], str],
     tuple[list[dict[str, Any]], dict[str, Any] | None],
@@ -108,13 +143,168 @@ def _image_pool() -> ProcessPoolExecutor:
         return _IMAGE_POOL
 
 
-def _reset_image_pool() -> None:
+def _snapshot_worker_processes(pool: ProcessPoolExecutor) -> list[Any]:
+    """Best-effort snapshot of the pool's worker `multiprocessing.Process`es.
+
+    Reads the executor's private process table; every consumer below treats an
+    empty result as "cannot observe" and degrades safely.
+    """
+    try:
+        processes = getattr(pool, "_processes", None)
+        if not processes:
+            return []
+        return [proc for proc in list(processes.values()) if proc is not None]
+    except Exception:
+        return []
+
+
+def _wait_for_processes(procs: list[Any], grace: float) -> bool:
+    """Wait up to ``grace`` seconds for every process in ``procs`` to exit.
+
+    Returns True when all observed processes exited, False on timeout or when
+    nothing could be observed (``procs`` empty).
+    """
+    if not procs:
+        time.sleep(grace)
+        return False
+    deadline = time.monotonic() + grace
+    while time.monotonic() < deadline:
+        alive = False
+        for proc in procs:
+            try:
+                if proc.is_alive():
+                    alive = True
+                    break
+            except ValueError:
+                continue
+        if not alive:
+            return True
+        time.sleep(0.05)
+    return False
+
+
+def _force_stop_workers_compat(pool: ProcessPoolExecutor, grace: float) -> None:
+    """Terminate workers on Python < 3.14, which lacks the public
+    ``terminate_workers()`` / ``kill_workers()`` executor API.
+
+    Falls back to the executor's private process table. If the table cannot be
+    read there is nothing more we can do here — that is the pre-fix behavior
+    (worker left running), so log it loudly instead of failing.
+    """
+    procs = _snapshot_worker_processes(pool)
+    if not procs:
+        logger.warning(
+            "Image pool retirement could not observe worker processes on "
+            "Python %s; a timed-out image worker may keep running",
+            ".".join(map(str, sys.version_info[:3])),
+        )
+        return
+    for proc in procs:
+        try:
+            if proc.is_alive():
+                proc.terminate()
+        except (ValueError, ProcessLookupError, OSError):
+            continue
+    if _wait_for_processes(procs, grace):
+        return
+    for proc in procs:
+        try:
+            if proc.is_alive():
+                proc.kill()
+        except (ValueError, ProcessLookupError, OSError):
+            continue
+
+
+def _hard_stop_pool_workers(pool: ProcessPoolExecutor, grace: float | None = None) -> None:
+    """Actually stop a retired pool's worker processes, then shut the pool down.
+
+    ``ProcessPoolExecutor.shutdown(wait=False, cancel_futures=True)`` only
+    cancels *queued* futures — a worker that already started a job keeps
+    running (and, for RapidOCR/ONNX image jobs, keeps ~1 GiB RSS and dozens of
+    native threads alive). Timed-out workers therefore accumulated without
+    bound. Send SIGTERM via the public 3.14+ executor API (or the private-
+    table fallback below it), then escalate to SIGKILL after a bounded grace
+    period.
+
+    Signal order matters: ``shutdown()`` drops the executor's process table,
+    which turns a later ``terminate_workers()`` / ``kill_workers()`` into a
+    silent no-op. Signal first, ``shutdown()`` last.
+    """
+    if grace is None:
+        grace = _TERMINATE_GRACE_SECONDS
+    try:
+        terminate = getattr(pool, "terminate_workers", None)
+        kill = getattr(pool, "kill_workers", None)
+        if callable(terminate) and callable(kill):
+            procs = _snapshot_worker_processes(pool)
+            try:
+                terminate()
+            except Exception as exc:
+                logger.warning(
+                    "terminate_workers() failed (%s); escalating to kill", type(exc).__name__
+                )
+            if not _wait_for_processes(procs, grace):
+                try:
+                    kill()
+                except Exception as exc:
+                    logger.warning("kill_workers() failed (%s)", type(exc).__name__)
+        else:
+            _force_stop_workers_compat(pool, grace)
+    finally:
+        # Reject any straggler submissions, cancel queued (never-started)
+        # futures, and let the executor's manager thread clean up.
+        pool.shutdown(wait=False, cancel_futures=True)
+
+
+def _retire_image_pool(pool: ProcessPoolExecutor | None) -> None:
+    """Permanently retire ``pool``: stop handing it out, then hard-stop its
+    workers.
+
+    * **Compare-and-swap**: the global ``_IMAGE_POOL`` is cleared only when it
+      still refers to ``pool``. A stale timeout from a request that ran on an
+      old pool can therefore never tear down a newer replacement pool.
+    * **Idempotent**: multiple failed requests may hold references to the same
+      pool; only the first retirement acts.
+    * The worker hard-stop runs on a daemon thread so the (SIGTERM, grace,
+      SIGKILL) sequence never blocks the event loop.
+    """
+    if pool is None:
+        return
     global _IMAGE_POOL
+    with _IMAGE_POOL_LOCK:
+        if _IMAGE_POOL is pool:
+            _IMAGE_POOL = None
+        if getattr(pool, "_headroom_retired", False):
+            return
+        pool._headroom_retired = True  # type: ignore[attr-defined]
+    # The reaper owns the whole stop sequence (terminate → grace → kill →
+    # shutdown). shutdown() must NOT run first: it drops the executor's
+    # process table and would turn the termination calls into silent no-ops.
+    threading.Thread(
+        target=_hard_stop_pool_workers,
+        args=(pool,),
+        name="headroom-image-pool-reaper",
+        daemon=True,
+    ).start()
+
+
+def _reset_image_pool() -> None:
+    """Retire whichever pool is currently installed (test/reset hook)."""
     with _IMAGE_POOL_LOCK:
         pool = _IMAGE_POOL
-        _IMAGE_POOL = None
-    if pool is not None:
-        pool.shutdown(wait=False, cancel_futures=True)
+    _retire_image_pool(pool)
+
+
+async def _acquire_image_slot(timeout: float) -> bool:
+    """Try to win the single admission slot without blocking the event loop."""
+    if _IMAGE_JOB_SLOT.acquire(blocking=False):
+        return True
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        await asyncio.sleep(_ADMISSION_POLL_SECONDS)
+        if _IMAGE_JOB_SLOT.acquire(blocking=False):
+            return True
+    return False
 
 
 async def run_image_compression_isolated(
@@ -123,22 +313,41 @@ async def run_image_compression_isolated(
