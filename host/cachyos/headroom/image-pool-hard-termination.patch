+def _pidfile_messages(path: Path) -> list[dict[str, object]]:
+    return [{"role": "user", "content": str(path)}]
+
+
+def _live_spawn_worker_pids() -> set[int]:
+    """PIDs of this process's live multiprocessing *spawn* children.
+
+    Filters out the multiprocessing resource tracker (also a child) by
+    cmdline, so the result is exactly the pool worker processes.
+    """
+    child_pids: set[int] = set()
+    for task in os.listdir("/proc/self/task"):
+        try:
+            with open(f"/proc/self/task/{task}/children") as fh:
+                child_pids.update(int(pid) for pid in fh.read().split())
+        except OSError:
+            continue
+    live: set[int] = set()
+    for pid in child_pids:
+        try:
+            with open(f"/proc/{pid}/cmdline", "rb") as fh:
+                cmdline = fh.read().decode(errors="replace")
+        except OSError:
+            continue
+        if "spawn_main" in cmdline and _pid_running(pid):
+            live.add(pid)
+    return live
+
+
+def _pid_running(pid: int) -> bool:
+    """True while `pid` is a live (non-zombie) process."""
+    try:
+        with open(f"/proc/{pid}/stat") as fh:
+            state = fh.read().rsplit(") ", 1)[1].split(" ", 1)[0]
+        return state not in {"Z", "X", "x"}
+    except FileNotFoundError:
+        return False
+    except Exception:
+        try:
+            os.kill(pid, 0)
+        except (ProcessLookupError, PermissionError):
+            return False
+        return True
+
+
+async def _read_pidfile(path: Path, deadline_s: float = 60.0) -> int:
+    deadline = time.monotonic() + deadline_s
+    while time.monotonic() < deadline:
+        try:
+            text = path.read_text().strip()
+            if text:
+                return int(text)
+        except (FileNotFoundError, ValueError):
+            pass
+        await asyncio.sleep(0.05)
