+def test_engine_rejecting_thread_bounds_falls_back_unbounded(
+    monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
+) -> None:
+    """An installed backend that predates (or renames) the settings keys must
+    still yield a working engine — unbounded beats no OCR."""
+    inits: list[dict[str, Any] | None] = []
+
+    class _PickyV3RapidOCR:
+        def __init__(self, params: dict[str, Any] | None = None) -> None:
+            inits.append(params)
+            if params is not None:
+                raise TypeError("unknown parameter: EngineConfig.onnxruntime")
+
+    with caplog.at_level("WARNING", logger="headroom.image.compressor"):
+        engine = compressor_module._build_ocr_engine(_PickyV3RapidOCR, "v3")
+
+    assert isinstance(engine, _PickyV3RapidOCR)
+    assert inits == [
+        {
+            "EngineConfig.onnxruntime.intra_op_num_threads": 1,
+            "EngineConfig.onnxruntime.inter_op_num_threads": 1,
+        },
+        None,
+    ]
+    assert any("ocr_thread_bounds_rejected" in r.getMessage() for r in caplog.records)
