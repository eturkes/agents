#!/usr/bin/env bash
set -euo pipefail
mode=${1:-check}
[[ "$mode" == apply || "$mode" == check ]] || { echo 'Usage: deploy [apply|check]' >&2; exit 2; }
root=$(dirname -- "$(readlink -f -- "$0")")
task_home=$(readlink -f -- "$HOME")
launcher="$task_home/.local/libexec/sonic-logout-greeter"
service="${XDG_DATA_HOME:-$task_home/.local/share}/dbus-1/services/org.kde.LogoutPrompt.service"
definition() {
  printf '[D-BUS Service]\nName=org.kde.LogoutPrompt\nExec="%s"\n' "$launcher"
}
if [[ "$mode" == apply ]]; then
  if [[ -e "$launcher" || -L "$launcher" ]]; then
    [[ -L "$launcher" && $(readlink -f -- "$launcher") == "$root/launch" ]] || {
      echo "Conflicting launcher: $launcher" >&2; exit 1;
    }
  fi
  if [[ -e "$service" || -L "$service" ]]; then
    if [[ ! -f "$service" || -L "$service" ]] || ! cmp -s "$service" <(definition); then
      echo "Conflicting service: $service" >&2; exit 1;
    fi
  fi
  mkdir -p -- "$(dirname -- "$launcher")" "$(dirname -- "$service")"
  ln -sfn -- "$root/launch" "$launcher"
  definition > "$service"
  busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig
fi
[[ -L "$launcher" && $(readlink -f -- "$launcher") == "$root/launch" && -x "$launcher" ]]
cmp -- "$service" <(definition)
printf 'PASS user-scoped logout-greeter activation\n'
