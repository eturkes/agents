#!/usr/bin/env bash
set -euo pipefail

mode=${1:-check}
[[ $# -le 1 && ( "$mode" == apply || "$mode" == check || "$mode" == live || "$mode" == rollback ) ]] || {
  echo 'Usage: nvidia-prime-policy [apply|check|live|rollback]' >&2
  exit 2
}
recipe_dir=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
sources=(nvidia-prime-display nvidia-prime-xorg.conf nvidia-prime-sddm.conf)
targets=(/usr/local/libexec/nvidia-prime-display /etc/X11/xorg.conf.d/90-nvidia-prime.conf /etc/sddm.conf.d/90-nvidia-prime.conf)
modes=(0755 0644 0644)

check_files() {
  local index failed=0
  for index in "${!sources[@]}"; do
    if cmp -s -- "$recipe_dir/${sources[index]}" "${targets[index]}"; then
      printf 'OK installed: %s\n' "${targets[index]}"
    else
      printf 'FAIL missing or different: %s\n' "${targets[index]}" >&2
      failed=1
    fi
  done
  return "$failed"
}

case "$mode" in
  apply|rollback)
    # Reject foreign files before the first write; rollback owns these three paths only.
    for index in "${!sources[@]}"; do
      target=${targets[index]}
      if [[ -L "$target" ]] || { [[ -e "$target" ]] && ! cmp -s -- "$recipe_dir/${sources[index]}" "$target"; }; then
        printf 'Refusing different existing file: %s\n' "$target" >&2
        exit 1
      fi
    done
    if [[ "$mode" == rollback ]]; then
      for ((index=${#targets[@]}-1; index>=0; index--)); do
        sudo -n rm -f -- "${targets[index]}"
      done
      echo 'Intel-primary configuration restored. Restart SDDM to activate it.'
      exit
    fi
    for index in "${!sources[@]}"; do
      sudo -n install -D -o root -g root -m "${modes[index]}" -- "$recipe_dir/${sources[index]}" "${targets[index]}"
    done
    check_files
    echo 'NVIDIA-primary configuration installed. Restart SDDM to activate it.'
    ;;
  check)
    check_files
    ;;
  live)
    desktop_environment=$(systemctl --user show-environment)
    while IFS='=' read -r key value; do
      case "$key" in
        DISPLAY|XAUTHORITY|XDG_SESSION_TYPE|XDG_CURRENT_DESKTOP) export "$key=$value" ;;
      esac
    done <<< "$desktop_environment"
    failed=0
    # No PRIME environment override: check the session's default renderer.
    renderer=$(env -u __NV_PRIME_RENDER_OFFLOAD -u __NV_PRIME_RENDER_OFFLOAD_PROVIDER -u __GLX_VENDOR_LIBRARY_NAME -u DRI_PRIME glxinfo -B)
    if [[ "$renderer" == *'OpenGL renderer string: NVIDIA '* ]]; then
      echo 'OK default renderer: NVIDIA'
    else
      echo 'FAIL default renderer is not NVIDIA' >&2
      failed=1
    fi
    compositor=$(qdbus6 org.kde.KWin /KWin org.kde.KWin.supportInformation)
    if [[ "$compositor" == *'Compositing is active'* && "$compositor" == *'OpenGL renderer string: NVIDIA '* ]]; then
      echo 'OK active desktop compositor: NVIDIA'
    else
      echo 'FAIL active desktop compositor is not NVIDIA' >&2
      failed=1
    fi
    providers=$(xrandr --listproviders)
    if awk '/Source Output/ && /name:NVIDIA-0$/ {source=1} /Sink Output/ && /name:modesetting$/ {sink=1} END {exit !(source && sink)}' <<< "$providers"; then
      echo 'OK PRIME providers: NVIDIA source + Intel modesetting sink'
    else
      echo 'FAIL PRIME output providers' >&2
      failed=1
    fi
    outputs=$(xrandr --query)
    if awk '$1 ~ /^HDMI-/ && $2 == "connected" && /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/ {print "OK active HDMI: " $0; active=1} END {exit !active}' <<< "$outputs"; then
      :
    else
      echo 'FAIL no active HDMI output' >&2
      failed=1
    fi
    exit "$failed"
    ;;
esac
