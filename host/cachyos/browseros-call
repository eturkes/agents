#!/usr/bin/env python3
"""Call a BrowserOS MCP tool and print its content[].text.

The MCP client drops content[] whenever a result also carries structuredContent, and BrowserOS
sets structuredContent to a stub ({"page": N}) on every text-returning tool -- so snapshot/read/
run/grep all arrive empty through the normal tool path. This talks to the server directly.

Usage: browseros-call <tool> '<json-args>'
       browseros-call snapshot '{"page":2}'
"""

import json
import sys
import urllib.request

ENDPOINT = "http://127.0.0.1:9000/mcp"


def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    name = sys.argv[1]
    args = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}
    body = json.dumps(
        {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": name, "arguments": args}}
    ).encode()
    req = urllib.request.Request(
        ENDPOINT,
        data=body,
        headers={"Content-Type": "application/json", "Accept": "application/json, text/event-stream"},
    )
    with urllib.request.urlopen(req, timeout=120) as response:
        payload = json.loads(response.read().decode())
    if "error" in payload:
        print(json.dumps(payload["error"]), file=sys.stderr)
        return 1
    result = payload.get("result", {})
    for item in result.get("content", []):
        if item.get("type") == "text":
            print(item["text"])
    if result.get("isError"):
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
