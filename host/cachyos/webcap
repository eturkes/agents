#!/usr/bin/env node
// Headless capture → PDF / PNG / DOM over CDP.
//
// Default capture path: adds full-page PNG, working prefers-color-scheme dark + settle waits over Chrome's
// own capture switches. Those switches (browser binary alone) = the fallback for flag-level control
// (`--window-size`, `--user-agent`, `--force-device-scale-factor`, proxy) or a missing node stack.
//
// Usage: webcap <url> [--pdf FILE] [--png FILE] [--dom FILE|-] [options]
//   --full-page        whole scroll height in PNG (PDF spans the document always)
//   --dark             render the page's prefers-color-scheme: dark styles
//   --width N          viewport width, default 1280
//   --height N         viewport height, default 800
//   --selector CSS     wait for this element before capture
//   --wait MS          settle delay after load, default 0
//   --timeout MS       navigation timeout, default 45000
//   --user-data-dir D  capture as this profile's user; runs against a copy of D
//   --profile-directory P
//                      profile inside D, default = D's Local State last_used
// Writes every requested artifact + prints one path per line; `--dom -` prints the HTML instead.

import { spawnSync } from "node:child_process";
import { existsSync, mkdtempSync, readFileSync, readdirSync, realpathSync, rmSync, unlinkSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { pathToFileURL } from "node:url";

const FLAGS = new Set(["--full-page", "--dark"]);
const VALUED = new Set([
  "--pdf", "--png", "--dom", "--width", "--height",
  "--selector", "--wait", "--timeout", "--user-data-dir", "--profile-directory",
]);

function die(msg) {
  process.stderr.write(`webcap: ${msg}\n`);
  process.exit(1);
}

function parseArgs(argv) {
  const opts = { width: 1280, height: 800, wait: 0, timeout: 45000 };
  for (let i = 0; i < argv.length; i++) {
    let a = argv[i];
    let inline;
    if (a.startsWith("--") && a.includes("=")) {
      const eq = a.indexOf("=");
      inline = a.slice(eq + 1);
      a = a.slice(0, eq);
    }
    if (FLAGS.has(a)) {
      if (inline !== undefined) die(`${a} takes no value`);
      opts[a.slice(2)] = true;
    } else if (VALUED.has(a)) {
      const v = inline ?? argv[++i];
      if (v === undefined) die(`${a} needs a value`);
      opts[a.slice(2)] = v;
    } else if (a.startsWith("-")) die(`unknown option ${a}`);
    else if (opts.url) die("pass one url");
    else opts.url = a;
  }
  return opts;
}

// chromiumfish + playwright-core = pnpm workspace deps here, not globals.
const WORKSPACE = join(homedir(), ".local/share/chromiumfish/node_modules");

function resolveModule(pkg) {
  const entry = join(WORKSPACE, pkg);
  if (!existsSync(entry)) die(`${pkg} missing from ${WORKSPACE}; run upgrade`);
  return pathToFileURL(entry).href;
}

const opts = parseArgs(process.argv.slice(2));
if (!opts.url) die("usage: webcap <url> [--pdf FILE] [--png FILE] [--dom FILE|-] [options]");
if (!opts.pdf && !opts.png && !opts.dom) die("choose at least one of --pdf, --png, --dom");

const { ChromiumFish, BASE_ARGS, binaryPath } = await import(`${resolveModule("chromiumfish")}/dist/index.js`);
const context = { viewport: { width: Number(opts.width), height: Number(opts.height) } };

// CDP media emulation (newPage colorScheme, emulateMedia) still reports dark=false here → promote
// every dark media block to `all`; the cascade stands, so a later light rule still wins.
// Cross-origin sheets deny cssRules → stay light; matchMedia stays light → matchMedia-driven themes need their own switch.
function promoteDarkRules() {
  const walk = (rules) => {
    for (const rule of rules) {
      if (rule.media && /prefers-color-scheme\s*:\s*dark/i.test(rule.media.mediaText)) rule.media.mediaText = "all";
      if (rule.cssRules) walk(rule.cssRules);
    }
  };
  let reached = 0;
  for (const sheet of document.styleSheets) {
    try {
      walk(sheet.cssRules);
      reached++;
    } catch {
      // cross-origin
    }
  }
  return { sheets: document.styleSheets.length, reached };
}

// Instant loads (file://, localhost) reach `load` before the first composited frame → CDP "Unable to
// capture screenshot"; two animation frames supply one.
function nextFrames() {
  return new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
}

let closable;
let page;

// Capture runs against a copy: a build opening the original garbage-collects component extensions it lacks
// + rewrites `Local State` profile.last_used → the owning browser loses extensions its Preferences still
// name + its next session opens elsewhere. The copy sheds ProcessSingleton → leave that browser running.
// Copy beside the original = the only place --reflink could share extents; psd's fuse-overlayfs forces a
// real copy (~1.4G, ~1s). realpath first: ~/.config/browser-claw = a symlink into /run, which `cp -a` copies alone.
// Singleton* name the live instance's socket → a copy keeping them forwards the capture into that browser.
function cloneProfile(dir) {
  if (!existsSync(dir)) die(`no profile at ${dir}`);
  const source = realpathSync(dir);
  const copy = mkdtempSync(join(dirname(source), ".webcap-"));
  // die() skips the capture's `finally` → removal rides process exit.
  process.on("exit", () => rmSync(copy, { recursive: true, force: true }));
  const cp = spawnSync("cp", ["-a", "--reflink=auto", `${source}/.`, copy], { encoding: "utf8" });
  if (cp.status !== 0) {
    rmSync(copy, { recursive: true, force: true });
    die(`cannot copy ${source}: ${cp.stderr?.trim() || cp.error?.message || `cp exited ${cp.status}`}`);
  }
  for (const entry of readdirSync(copy)) {
    if (entry.startsWith("Singleton")) unlinkSync(join(copy, entry));
  }
  return copy;
}

// Chrome opens `Local State`'s last-used profile, not `Default`, and creates an absent name empty → a
// signed-out capture that reads like a login failure → resolve the name here + report what exists.
function resolveProfileDir(copy, wanted, label) {
  let name = wanted;
  if (!name) {
    try {
      name = JSON.parse(readFileSync(join(copy, "Local State"), "utf8")).profile?.last_used;
    } catch {
      // no Local State yet
    }
  }
  name ||= "Default";
  if (existsSync(join(copy, name, "Preferences"))) return name;
  const found = readdirSync(copy, { withFileTypes: true })
    .filter((e) => e.isDirectory() && existsSync(join(copy, e.name, "Preferences")))
    .map((e) => e.name);
  die(`${label} has no profile ${JSON.stringify(name)}; found ${found.join(", ") || "none"}`);
}

if (opts["user-data-dir"]) {
  const scratch = cloneProfile(opts["user-data-dir"]);
  const profileDir = resolveProfileDir(scratch, opts["profile-directory"], opts["user-data-dir"]);
  const pw = await import(`${resolveModule("playwright-core")}/index.mjs`);
  const chromium = pw.chromium ?? pw.default.chromium;
  // Chrome deletes every cookie it fails to decrypt; playwright-core pins --password-store=basic (beside
  // --use-mock-keychain) into every launch, and a later --password-store wins (last duplicate) → name the
  // store actually running; no desktop-environment variable moves the pin. Here: no keyring daemon + a v10
  // jar (the hardcoded-key format `basic` reads) → a wallet store would write v11 rows the browser cannot read.
  closable = await chromium.launchPersistentContext(scratch, {
    executablePath: await binaryPath(),
    args: [...BASE_ARGS, "--password-store=basic", `--profile-directory=${profileDir}`],
    headless: true,
    ...context,
  });
  page = closable.pages()[0] ?? (await closable.newPage());
} else {
  closable = await ChromiumFish({ headless: true });
  page = await closable.newPage(context);
}

let failure;
try {
  await page.goto(opts.url, { waitUntil: "load", timeout: Number(opts.timeout) });
  if (opts.selector) await page.waitForSelector(opts.selector, { timeout: Number(opts.timeout) });
  if (Number(opts.wait)) await page.waitForTimeout(Number(opts.wait));
  if (opts.dark) {
    const { sheets, reached } = await page.evaluate(promoteDarkRules);
    if (reached < sheets) process.stderr.write(`webcap: ${sheets - reached}/${sheets} stylesheets are cross-origin and stay light\n`);
  }
  await page.evaluate(nextFrames);

  if (opts.dom) {
    const html = await page.content();
    if (opts.dom === "-") process.stdout.write(html);
    else {
      writeFileSync(opts.dom, html);
      process.stdout.write(`${opts.dom}\n`);
    }
  }
  if (opts.png) {
    await page.screenshot({ path: opts.png, fullPage: Boolean(opts["full-page"]) });
    process.stdout.write(`${opts.png}\n`);
  }
  if (opts.pdf) {
    await page.pdf({ path: opts.pdf, printBackground: true });
    process.stdout.write(`${opts.pdf}\n`);
  }
} catch (e) {
  failure = e?.message || String(e);
} finally {
  await closable.close();
}
if (failure) die(failure);
