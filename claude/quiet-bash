#!/bin/sh
# PreToolUse(Bash): inject progress-only quiet flags into selected runners, and
# turn pipe-source `cat` into a leading redirect. Green-run output shrinks;
# diagnostics + runner rc stay intact. Global CLAUDE.md `Reading` owns judgment
# cases beyond this table.
#
# Invariants:
# - Rewrites preserve runner rc + full failure diagnostics.
# - `updatedInput` replaces `tool_input` ⇒ merge original fields (`description`,
#   `timeout`, `run_in_background`).
# - Return only `updatedInput` ⇒ session permission path + deny rules remain active.
# - Heredoc ⇒ unchanged input; heredoc body = opaque data. Explicit verbosity
#   holds flag injection alone, leaving the pipe rewrite in force.
# - Membership = suppress progress while preserving results, warnings + failures.
# Exclusions: `just -q` suppresses recipe output; `moon test -q` drops totals;
# `git diff|log|show -q` changes semantics; npm/pnpm silent modes can hide failed-
# install diagnostics; R quiet flags skip work. `bun --silent` preserves errors ⇒
# included. `Rscript` already suppresses echo.
IN=""
[ -t 0 ] || IN=$(cat)   # hooks always pipe the payload; a bare terminal run exits quiet
cmd=$(printf '%s' "$IN" | jq -r '.tool_input.command // empty' 2>/dev/null)
[ -n "$cmd" ] || { printf '{}\n'; exit 0; }

case $cmd in *'<<'*) printf '{}\n'; exit 0 ;; esac

orig=$cmd

emit() {
  [ "$cmd" = "$orig" ] && { printf '{}\n'; exit 0; }
  printf '%s' "$IN" | jq -c --arg c "$cmd" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",updatedInput:(.tool_input + {command:$c})}}'
  exit 0
}

# Pipe-source `cat` hands a whole file to a consumer that already bounds output;
# `< f consumer` keeps that bound and keeps read-guard's operand budget out of a
# pipeline it cannot measure. One unflagged operand alone: further operands
# concatenate + flags annotate. Leading redirection is a simple-command form, so
# `bash -n` discards keyword consumers (`| while`) + every other bad splice.
piped=$(printf '%s' "$cmd" | sed -E 's@(^|[;&(]|&&|\|\|)([[:space:]]*)cat[[:space:]]+([^-[:space:]|;&<>()][^[:space:]|;&<>()]*)[[:space:]]*\|[[:space:]]*([[:alnum:]_./])@\1\2< \3 \4@g')
if [ "$piped" != "$cmd" ] && bash -n -c "$piped" 2>/dev/null; then cmd=$piped; fi

# Hand-written verbosity holds flag injection; the pipe rewrite already stands.
printf '%s' "$cmd" | grep -Eq '(^|[[:space:]])--?(v|vv|vvv|verbose|debug)([[:space:]]|$)' && emit

Q='(^|[[:space:]])--?q(uiet)?([[:space:]]|$)'
W='(^|[^-=[:alnum:]_])'

# rule <already-quiet ERE> <sed -E expr>: ORIGINAL-command match ⇒ preserve
# input; otherwise flag each chained runner. Hand-written flag wins.
# Expr bounds = `W` + space/EOL. Absolute paths match; dotted names, package
# names + assignments stay intact because `W` keeps `-` and `=` inside tokens.
rule() {
  printf '%s' "$orig" | grep -Eq -- "$1" && return 0
  cmd=$(printf '%s' "$cmd" | sed -E "$2")
}

# Python / uv
rule "$Q" 's@'"$W"'(pytest)([[:space:]]|$)@\1\2 -q\3@g'
rule "$Q" 's@'"$W"'(pip[[:space:]]+install)([[:space:]]|$)@\1\2 -q\3@g'
rule "$Q" 's@'"$W"'(uv[[:space:]]+(run|sync|add|remove|lock|build|export|tree|venv|init|tool))([[:space:]]|$)@\1\2 -q\4@g'
rule "$Q" 's@'"$W"'(uvx)([[:space:]]|$)@\1\2 -q\3@g'
rule "$Q" 's@'"$W"'(ruff[[:space:]]+(check|format))([[:space:]]|$)@\1\2 -q\4@g'
# Rust
rule "$Q" 's@'"$W"'(cargo[[:space:]]+(build|check|test|clippy|run|fmt|doc|add|update|bench))([[:space:]]|$)@\1\2 -q\4@g'
# Lean/MoonBit: `lake -q` hides only lake logs; child output + compile errors
# survive. `moon -q` preserves warnings + errors.
rule "$Q" 's@'"$W"'(lake)([[:space:]]|$)@\1\2 -q\3@g'
rule "$Q" 's@'"$W"'(moon[[:space:]]+(check|build|fmt))([[:space:]]|$)@\1\2 -q\4@g'
# JS/TS — node/bun/vite + the two dot-reporter suites
rule '--test-reporter' 's@'"$W"'(node[[:space:]][^|;&]*--test)([[:space:]]|$)@\1\2 --test-reporter=dot\3@g'
rule '--silent|--quiet' 's@'"$W"'(bun[[:space:]]+(install|add|remove|update))([[:space:]]|$)@\1\2 --silent\4@g'
rule '--logLevel|(^|[[:space:]])-l([[:space:]]|$)' 's@'"$W"'(vite[[:space:]]+build)([[:space:]]|$)@\1\2 -l warn\3@g'
rule '--reporter' 's@'"$W"'(vitest[[:space:]]+run)([[:space:]]|$)@\1\2 --reporter=dot\3@g'
rule '--reporter' 's@'"$W"'(playwright[[:space:]]+test)([[:space:]]|$)@\1\2 --reporter=dot\3@g'
# Build + fetch — git list = the subcommands whose `--quiet` is progress-only.
rule '(^|[[:space:]])--?s(ilent)?([[:space:]]|$)|--no-silent' 's@'"$W"'(make)([[:space:]]|$)@\1\2 -s\3@g'
rule "$Q" 's@'"$W"'(git[[:space:]]+(clone|fetch|pull|push|checkout|submodule))([[:space:]]|$)@\1\2 --quiet\4@g'
rule '(^|[[:space:]])-[[:alnum:]]*s|--silent' 's@'"$W"'(curl)([[:space:]]|$)@\1\2 -sS\3@g'
rule "$Q"'|(^|[[:space:]])-nv([[:space:]]|$)|--no-verbose' 's@'"$W"'(wget)([[:space:]]|$)@\1\2 -nv\3@g'

emit
