#!/usr/bin/env python3
"""Subagent corpus census = live rates behind global `CLAUDE.md` `Subagents`.

  agent-census [<projects-dir> ...]      default ~/.claude/projects

Section -> the rule it measures:
  compaction  -> `Teammate size`: teammates compact + keep working
  deaths      -> `Death shape`: terminal `API Error` classes + peak usage at death
  writes      -> the SubagentStop wrote-nothing notice (>=15 tool calls, no durable call)
  tail        -> `context-gauge -t`, corpus-wide: distance from the last durable call
  stops       -> the agent-flow TaskStop hold: lead stops on a mid-turn teammate, and those before its marker
  alerts      -> context-alert offsets + the GPT window (main + teammate transcripts): step growth,
                 context spent from a delivered tier to its response, derived vs assess.ts

Compaction record = a `type=system` entry carrying `compactMetadata` (`durationMs` = summarizer
cost) + the following `isCompactSummary` user entry holding the summary.
"""
import glob
import json
import math
import os
import re
import statistics
import sys
from datetime import datetime

DONE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*-DONE-[0-9]+")
REPORT = ".scratch/agents/"
WRITE_TOOLS = {"Write", "Edit", "NotebookEdit"}
BASH_DURABLE = re.compile(r"git commit|git add|>>|\btee\b")
CONTEXT_ERR = re.compile(r"prompt is too long|context (?:window|limit)|prompt_too_long", re.IGNORECASE)
NOTE = re.compile(r"Context \d+K/\S+ — \d+K left\. ")
ASSESS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "mods/context-alert/hooks/assess.ts")
FAMILY = {"main": "claude-opus", "agent": "gpt-"}   # models now running each loop
# Tier response = main: next commit; agent: notice → turn end (hand-off), final → next durable write.
RESPONSE = {("main", "notice"): "G", ("main", "final"): "G", ("agent", "notice"): "E", ("agent", "final"): "W"}
INPUT_CAP = 921_310       # largest GPT input upstream accepts (1.05M window − 128K max output)
COMPACT_PROMPT = 2_900    # CC's compaction instructions, sent on top of the full context
RESERVE = 33_000          # CC compaction trigger = window − 33K


def durable(b):
    n = b.get("name", "")
    if n in WRITE_TOOLS:
        return True
    return n == "Bash" and bool(BASH_DURABLE.search((b.get("input") or {}).get("command", "")))


def usage(u):
    return sum(u.get(k, 0) for k in ("input_tokens", "cache_creation_input_tokens",
                                     "cache_read_input_tokens", "output_tokens"))


def text_of(m):
    c = m.get("content")
    if isinstance(c, str):
        return c
    return "".join(b.get("text", "") for b in c or [] if isinstance(b, dict))


def scan(path):
    r = {"path": path, "tools": 0, "durable": 0, "tail": 0, "peak": 0, "cut": False, "done": False,
         "secs": [], "summary_report": False, "post_tools": 0, "post_reports": 0, "err": ""}
    compacted = False
    pending = set()
    last_text = ""
    with open(path, "rb") as fh:
        for raw in fh:
            if not raw.strip():
                continue
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            m = e.get("message") if isinstance(e.get("message"), dict) else {}
            cm = e.get("compactMetadata")
            if isinstance(cm, dict):
                compacted = True
                r["secs"].append(cm.get("durationMs", 0) / 1000)
                continue
            if e.get("isCompactSummary"):
                r["summary_report"] = REPORT in text_of(m)
                continue
            if e.get("type") == "user":
                c = m.get("content")
                for b in (c if isinstance(c, list) else []):
                    if isinstance(b, dict) and b.get("type") == "tool_result":
                        pending.discard(b.get("tool_use_id"))
                continue
            if e.get("type") != "assistant":
                continue
            if isinstance(m.get("usage"), dict):
                r["peak"] = max(r["peak"], usage(m["usage"]))
            for b in (m.get("content") or []):
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and b.get("text", "").strip():
                    last_text = b["text"].strip()
                if b.get("type") != "tool_use":
                    continue
                r["tools"] += 1
                pending.add(b.get("id"))
                if compacted:
                    r["post_tools"] += 1
                    blob = " ".join(v for v in (b.get("input") or {}).values()
                                    if isinstance(v, str))
                    r["post_reports"] += REPORT in blob
                if durable(b):
                    r["durable"] += 1
                    r["tail"] = 0
                else:
                    r["tail"] += 1
    r["cut"] = bool(pending)
    r["done"] = bool(DONE.search(last_text[-400:]))
    if last_text.startswith("API Error"):
        r["err"] = last_text[:160].replace("\n", " ")
    return r


def records(path):
    with open(path, "rb") as fh:
        for raw in fh:
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            if isinstance(e, dict):
                m = e.get("message")
                yield e, m if isinstance(m, dict) else {}


def blocks(m):
    return [b for b in (m.get("content") if isinstance(m.get("content"), list) else [])
            if isinstance(b, dict)]


def ended(e, m):
    """Turn ended, in transcript terms (agent-flow tracks it live): an assistant record with text and no tool_use."""
    b = blocks(m)
    return (e.get("type") == "assistant" and any(x.get("type") == "text" and x.get("text")
                                                 for x in b)
            and not any(x.get("type") == "tool_use" for x in b))


def lead_stops(path):
    """(time, stopped prompt prefix) per successful TaskStop in a lead transcript."""
    sent, out = {}, []
    for e, m in records(path):
        if e.get("isSidechain"):
            continue
        for b in blocks(m):
            if b.get("type") == "tool_use" and b.get("name") == "TaskStop":
                sent[b.get("id")] = e.get("timestamp")
            elif b.get("type") == "tool_result" and b.get("tool_use_id") in sent:
                c = b.get("content")
                try:
                    r = json.loads(c if isinstance(c, str) else text_of({"content": c}))
                except ValueError:
                    continue
                if isinstance(r, dict) and str(r.get("message", "")).startswith("Successfully"):
                    out.append((sent[b["tool_use_id"]], str(r.get("command", "")).rstrip(".")))
    return out


def teammate(path):
    """Brief, marker time, turn state per record time, write times, last durable write per marker."""
    t: dict = {"brief": "", "marker": None, "states": [], "times": [], "last_write": None, "gap": None,
               "calls": 0}
    for e, m in records(path):
        ts = e.get("timestamp") or ""
        if ts:
            t["times"].append(ts)   # every record rewrites the file = the hook's mtime test
        if e.get("type") == "user" and not t["brief"]:
            t["brief"] = text_of(m)
        if e.get("type") not in ("user", "assistant"):
            continue
        t["states"].append((ts, ended(e, m)))
        for b in blocks(m):
            if e.get("type") != "assistant":
                continue
            if b.get("type") == "tool_use":
                t["calls"] += 1
                if durable(b) and t["marker"] is None:
                    t["last_write"], t["calls"] = ts, 0
            elif (b.get("type") == "text" and t["marker"] is None
                  and DONE.search(b.get("text", ""))):
                t["marker"] = ts
                if t["last_write"]:
                    t["gap"] = (secs(ts) - secs(t["last_write"]), t["calls"])
    return t


def secs(ts):
    return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()


def stops(roots):
    """Lead TaskStops matched to one teammate by its brief's opening words."""
    n = matched = early = held = 0
    gaps = []
    for r in roots:
        for lead in glob.glob(os.path.join(r, "*", "*.jsonl")):
            subs = (glob.glob(os.path.join(lead[:-6], "subagents", "*.jsonl"))
                    + glob.glob(os.path.join(lead[:-6], "subagents", "workflows", "*", "*.jsonl")))
            if not subs:
                continue
            mates = [teammate(s) for s in subs]
            gaps += [t["gap"] for t in mates if t["gap"]]
            for at, cmd in lead_stops(lead):
                n += 1
                hit = [t for t in mates if cmd[:40] and cmd[:40] in t["brief"][:1500]]
                if len(hit) != 1:
                    continue
                t = hit[0]
                matched += 1
                early += not (t["marker"] and t["marker"] <= at)
                before = [s for s in t["states"] if s[0] and s[0] <= at]
                touched = max((x for x in t["times"] if x <= at), default="")
                held += bool(before) and not before[-1][1] and secs(at) - secs(touched) <= 900
    print(f"\nstops: {matched} of {n} lead TaskStops matched to one teammate; {early} came before "
          f"its marker; {held} found it mid-turn within 15 min = the agent-flow hold")
    if gaps:
        s = sorted(g[0] for g in gaps)
        c = sorted(g[1] for g in gaps)
        print(f"  marker after the last durable write: median {statistics.median(s):.0f}s "
              f"p90 {q(s, .9):.0f}s, {statistics.median(c):.0f} tool calls (n={len(s)})")


def q(v, p):
    v = sorted(v)
    return v[min(len(v) - 1, int(len(v) * p))] if v else 0


def ctx(u):
    """Context of one response: CC's last executor pass when `iterations` lists them, else the top-level sum."""
    it = [x for x in u.get("iterations") or []
          if not isinstance(x, dict) or x.get("type") not in ("advisor_message", "compaction")]
    x = it[-1] if it else None
    if isinstance(x, dict) and x.get("type") in ("message", "fallback_message"):
        n = sum(x.get(k) or 0 for k in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
        if n:
            return n + (x.get("output_tokens") or 0)
    return sum(u.get(k) or 0 for k in ("input_tokens", "cache_creation_input_tokens",
                                       "cache_read_input_tokens", "output_tokens"))


def advice():
    """assess.ts → ({advice label: (loop, tier)}, {(loop, tier): offset}); label = text before the first colon."""
    with open(ASSESS) as fh:
        src = fh.read()
    labels, offsets = {}, {}
    for loop, body in re.findall(r"(main|agent): \{(.*?)\}", src, re.DOTALL):
        for tier, v in re.findall(r"(notice|final): ('[^']*'|[\d_]+)", body):
            if v.startswith("'"):
                labels[(loop, v[1:].split(":")[0])] = tier
            else:
                offsets[(loop, tier)] = int(v.replace("_", ""))
    return labels, offsets


def events(path, side, labels):
    """Loop events in order: U usage, C compaction, N delivered tier, G commit, W durable write, E turn end."""
    loop = "main" if side else "agent"
    ev, seen = [], {}
    for e, m in records(path):
        if side and e.get("isSidechain"):
            continue
        if isinstance(e.get("compactMetadata"), dict):
            ev.append(("C",))
            continue
        a = e.get("attachment")
        if isinstance(a, dict) and a.get("type") == "hook_additional_context":
            for s in a.get("content") or []:
                hit = NOTE.search(s) if isinstance(s, str) else None
                tier = hit and labels.get((loop, s[hit.end():].split(":")[0]))
                if tier:
                    ev.append(("N", tier))
            continue
        if e.get("type") != "assistant" or m.get("model") in (None, "<synthetic>"):
            continue
        n = ctx(m["usage"]) if isinstance(m.get("usage"), dict) else 0
        if n and m.get("id") in seen:    # CC repeats one response across records
            i = seen[m["id"]]
            ev[i] = ("U", max(ev[i][1], n), ev[i][2])
        elif n:
            seen[m.get("id")] = len(ev)
            ev.append(("U", n, m["model"]))
        if m.get("stop_reason") == "end_turn":
            ev.append(("E",))
        for b in blocks(m):
            if b.get("type") != "tool_use":
                continue
            if b.get("name") == "Bash" and "git commit" in (b.get("input") or {}).get("command", ""):
                ev.append(("G",))
            if durable(b):
                ev.append(("W",))
    return ev


def response(ev, i, target):
    """Context spent from the tier at ev[i] to its response; None = compaction or session end came first."""
    u0 = last = next((x[1] for x in reversed(ev[:i]) if x[0] == "U"), None)
    for x in ev[i + 1:]:
        if x[0] == "C" or u0 is None:
            return None
        if x[0] == "U":
            last = x[1]
        elif x[0] == target:
            return last - u0
    return None


def alerts(roots):
    labels, offsets = advice()
    steps = {"main": [], "agent": []}
    spent = {k: [] for k in RESPONSE}
    for r in roots:
        for loop, pat in (("main", "*/*.jsonl"), ("agent", "**/subagents/*.jsonl")):
            for f in glob.glob(os.path.join(r, pat), recursive=True):
                ev = events(f, loop == "main", labels)
                prev = None
                for i, x in enumerate(ev):
                    if x[0] == "C":
                        prev = None
                    elif x[0] == "U":
                        fam = FAMILY[loop]
                        if prev and x[2].startswith(fam) and prev[2].startswith(fam) and x[1] >= prev[1] / 2:
                            steps[loop].append(x[1] - prev[1])    # drop past half = reset, skipped
                        prev = x
                    elif x[0] == "N":
                        s = response(ev, i, RESPONSE[(loop, x[1])])
                        if s is not None:
                            spent[(loop, x[1])].append(s)
    print("\nalerts: offset below the compaction trigger = slowest response to the current advice + p99 step"
          " (rounded up to 1K)")
    for loop, v in steps.items():
        print(f"  {loop:5s} steps n={len(v)}  p99 {q(v, .99) / 1000:.1f}K  max {max(v, default=0) / 1000:.1f}K")
    for (loop, tier), v in spent.items():
        derived = math.ceil((max(v, default=0) + q(steps[loop], .99)) / 1000)
        print(f"  {loop:5s} {tier:6s} responses n={len(v):3d}  p50 {q(v, .5) / 1000:5.1f}K  max "
              f"{max(v, default=0) / 1000:5.1f}K  → offset {derived}K  assess.ts {offsets[(loop, tier)] // 1000}K")
    bound = INPUT_CAP - max(steps["agent"], default=0) - COMPACT_PROMPT + RESERVE
    print(f"  teammate window ≤ {INPUT_CAP // 1000}K input cap − max step − compaction prompt + "
          f"{RESERVE // 1000}K = {bound // 1000}K  declared {os.environ.get('CLAUDE_CODE_MAX_CONTEXT_TOKENS', 'unset')}")


def main():
    roots = sys.argv[1:] or [os.path.expanduser("~/.claude/projects")]
    files = sorted(f for r in roots
                   for f in glob.glob(os.path.join(r, "**", "subagents", "*.jsonl"),
                                      recursive=True))
    rows = [scan(f) for f in files]
    n = len(rows)
    live = [r for r in rows if r["tools"] >= 10]
    print(f"agents: {n}   (>=10 tool calls: {len(live)})")

    comp = [r for r in rows if r["secs"]]
    secs = [s for r in comp for s in r["secs"]]
    print(f"\ncompaction: {len(comp)} of {n} crossed the trigger, {len(secs)} events"
          f"   cost median {statistics.median(secs):.0f}s p90 {q(secs, .9):.0f}s "
          f"max {max(secs):.0f}s" if secs else f"\ncompaction: none of {n}")
    if comp:
        print(f"  last summary names .scratch/agents/: "
              f"{sum(r['summary_report'] for r in comp)} of {len(comp)}")
        print(f"  kept working past it: {sum(1 for r in comp if r['post_tools'])} of {len(comp)}"
              f"   ({sum(r['post_tools'] for r in comp)} further tool calls, "
              f"{sum(r['post_reports'] for r in comp)} further report-path references)")

    errs = [r for r in rows if r["err"]]
    ctx = [r for r in errs if CONTEXT_ERR.search(r["err"])]
    print(f"\ndeaths: {len(errs)} ended on `API Error`, {len(ctx)} of them on context")
    for r in errs:
        print(f"  peak {r['peak'] // 1000}K  {r['err'][:96]}")

    fire = [r for r in rows if r["durable"] == 0 and r["tools"] >= 15]
    print(f"\nwrites: {sum(1 for r in rows if r['durable'] == 0)} of {n} wrote nothing durable; "
          f"{len(fire)} of {n} also reached 15 tool calls = the SubagentStop wrote-nothing set")

    print("\ntail = tool calls after the last durable write")
    for lo, hi in ((0, 0), (1, 10), (11, 30), (31, 10 ** 9)):
        g = [r for r in live if lo <= r["tail"] <= hi]
        if g:
            print(f"  {lo}-{'+' if hi > 10 ** 8 else hi}: n={len(g):3d}  "
                  f"cut_mid_call={sum(r['cut'] for r in g):3d}  "
                  f"ended_on_DONE={sum(r['done'] for r in g):3d}")
    if live:
        w = max(live, key=lambda r: r["tail"])
        print(f"  widest: tail {w['tail']}/{w['tools']} cut={w['cut']} done={w['done']}  "
              f"{os.path.basename(w['path'])}")

    stops(roots)
    alerts(roots)


main()
