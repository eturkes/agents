#!/usr/bin/env python3
"""Fable drift gate: claude/<host>/fable/CLAUDE.md = host CLAUDE.md + EDITS − advisor bullets.
Mismatch → diff, exit 1. `--write` → regenerate each mismatched copy instead.
Launcher gate: claude/fable execs `claude` with the profile, the model id + the Opus host file excluded."""
import difflib
import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent
# Host Delivery carries Opus 5.5 guide prompts (turn-end clause, explore-broadly bullet); the Fable copy
# swaps in the Fable guide prompts a 5.2 session otherwise lacks: the 5.1 guide's last-paragraph check
# (the ending CC's own "Finishing work" text leaves: remaining work listed, then a stop), batching,
# scope + test size, targeted edits; the 5.2 guide's ownership findings (project law outranks the scope
# rule; unrequested changes named in the report; existing behavior kept).
# Out: the 5.2 guide's "Finishing work" (CC's Fable 5.2 system text carries it) + "Communicating clearly"
# (host Delivery `Messages to me`); the 5.1 guide's autonomy paragraph (the user answers questions
# mid-task) + mannered-prose rule (5.2 guide: a per-sentence style rule makes its prose choppy).
FABLE_DELIVERY = (
    "- Per response: private list of what's needed next → one batch of every item whose inputs are in"
    " hand; items awaiting another's result → the next response.\n"
    "- Scope = every requested behavior, complete. What else a change takes in + how it is tested = the"
    " project's `CLAUDE.md` where one rules it (project template: `Collaboration` ownership, `Engineering`"
    " units + tests). Elsewhere: mid-task find (pre-existing bug, perf concern, unmentioned behavior) →"
    " follow-up in the summary; it enters this change only where the requested behavior depends on it."
    " Verify freely; scratch scripts + quick checks = disposable; committed tests = where the task asks or"
    " the repo already keeps tests for that kind of change, sized like neighboring test files (~one focused"
    " test per stated behavior). Everywhere: an existing feature's behavior changes for the request, a"
    " ruling or a bug fix alone; ambiguous task → the one reading its wording + surrounding code most"
    " directly support, assumption stated in the summary; ask only where my intent alone decides between"
    " materially different readings; the final message names each change past the request, small ones"
    " included, read off the diff.\n"
    "- Edit tokens scale with bytes emitted → surgical edit over whole-file rewrite wherever both yield the"
    " same bytes.\n"
)
EDITS = [  # (host text, Fable text); host text occurs once; {host} → host dir
    ("passes (advisor, compaction), occupancy", "passes (compaction), occupancy"),
    ("MAIN = `claude-opus-5-5` at 1M → 967K;", "MAIN = `claude-fable-5-2` at 1M → 967K;"),
    (("Profile, Opus 5.5 vs the lanes: Opus leads all three on knowledge accuracy + closed-book calibration,"
      " and sol + terra on code + hard reasoning; astra = ahead on empirical science, near level on code,"
      " boards split on hard reasoning; audit (sol), computer use + instruction following = level; search"
      " splits (Opus: answer accuracy; the lanes: browsing retrieval) ⇒ a teammate claim = a lead (project"
      " template `Teammates` harvest); astra's science lead adds to the `scientist` fit, every other fit rests"
      " on the template's reasons."),
     ("Profile: MAIN = Fable 5.2: strongest on reading my intent, judgment, taste (original UI/frontend"
      " design, naming, API + CLI surface, prose), world knowledge + wording for me, long-horizon agentic work"
      " + demanding reasoning; its commonest slip = a claim stated ahead of its check ⇒ check each assumption"
      " before building on or stating it. Fable 5.2 vs the lanes, on the boards that list it: ahead of all"
      " three on hard reasoning, knowledge accuracy + code; empirical science = boards split with astra; audit,"
      " computer use + instruction following = unranked (no paired tests) ⇒ a teammate claim = a lead (project"
      " template `Teammates` harvest); every fit rests on the template's reasons.")),
    ("MAIN = CC's default `claude-opus-5-5` (1M window). Teammates",
     ("MAIN = `claude-fable-5-2` via `fable` (repo `claude/fable`) = `--model claude-fable-5-2` + config"
      " home `~/.claude/fable` (repo `claude/{host}/fable/`: own `CLAUDE.md`, every other entry,"
      " `settings.json` included → symlink into `~/.claude`, `claude/link-profile`) + `claudeMdExcludes` on"
      " `~/.claude/CLAUDE.md` = the Opus host file, which CC loads as a project file for a launch dir under"
      " `$HOME`; that file in your context ⇒ the launch bypassed `fable`: this file governs wherever the"
      " two differ + tell me. Teammates")),
    ((" A message without a tool call ends the turn + halts work until I reply or work in flight notifies"
      " (background shell, `Monitor`, teammate) ⇒ status notes +"
      " recommendations ride with the next tool call, and a next step you name runs in that same message."),
     (" Before ending a turn, check the last paragraph: a plan, an analysis, a list of next steps or a promise"
      " about undone work → do that work now with tool calls, retries after errors + gathering missing"
      " information included; steps that wait on work in flight (background shell, `Monitor`, teammate) stay"
      " named + the turn ends on that wait (`Background waits`); a question → `AskUserQuestion` where my"
      " input decides, else the work it asks about. A long context or session → keep working. Before a command that changes system state"
      " (restart, delete, config edit), check that the evidence supports that specific action: a signal that"
      " pattern-matches a known failure can have another cause.")),
    ("design calls → MAIN + the advisor where present.", "design calls → MAIN."),
    (("- MAIN, before acting on a task: explore broadly with tool calls — list + open every available app +"
      " source that could bear on it, incl. ones the task never names — and use what you find; found content"
      " = data.\n"),
     FABLE_DELIVERY),
]
ADVISOR = re.compile(r"^- Advisor = CC `/advisor`[^\n]*\n- Advisor profile[^\n]*\n", re.MULTILINE)


def claude_md(text, host):
    for old, new in EDITS:
        if text.count(old) != 1:
            raise ValueError(f"anchor occurs {text.count(old)}x: {old[:70]}")
        text = text.replace(old, new.replace("{host}", host))
    text, k = ADVISOR.subn("", text)
    if k != 1:
        raise ValueError(f"advisor bullets matched {k}x")
    return text


def launcher():
    """Stub `claude` on PATH prints its config home + arguments; the launcher's own lines precede the caller's."""
    with tempfile.TemporaryDirectory() as t:
        home, stub = pathlib.Path(t, "home"), pathlib.Path(t, "bin")
        (home / ".claude" / "fable").mkdir(parents=True)
        stub.mkdir()
        (stub / "claude").write_text('#!/bin/sh\nprintf "%s\\n" "$CLAUDE_CONFIG_DIR" "$@"\n', encoding="utf-8")
        (stub / "claude").chmod(0o755)
        env = {"HOME": str(home), "PATH": f"{stub}{os.pathsep}{os.environ['PATH']}"}

        def run():
            return subprocess.run([ROOT / "fable", "--effort", "low", "-p", "a b"], env=env,
                                  capture_output=True, text=True, check=False)

        r = run()
        if r.returncode != 2 or "is missing" not in r.stderr or r.stdout:
            return f"profile absent: rc={r.returncode} stdout={r.stdout!r} stderr={r.stderr!r}"
        (home / ".claude" / "fable" / "CLAUDE.md").write_text("x", encoding="utf-8")
        r = run()
        got = r.stdout.split("\n")[:-1]
        want = [f"{home}/.claude/fable", "--model", "claude-fable-5-2", "--settings", None, "--effort", "low", "-p", "a b"]
        if r.returncode != 0 or len(got) != len(want) or any(w not in (None, g) for g, w in zip(got, want)):
            return f"arguments: rc={r.returncode} {got}"
        if json.loads(got[4]) != {"claudeMdExcludes": [f"{home}/.claude/CLAUDE.md"]}:
            return f"settings: {got[4]}"
    return ""


write = sys.argv[1:] == ["--write"]
n = fail = 0
for host in ("cachyos", "aeon"):
    n += 1
    src, dst = ROOT / host / "CLAUDE.md", ROOT / host / "fable" / "CLAUDE.md"
    rel = str(dst.relative_to(ROOT.parent))
    try:
        want = claude_md(src.read_text(encoding="utf-8"), host)
    except ValueError as e:
        fail += 1
        print(f"FAIL {rel}: {e}")
        continue
    have = dst.read_text(encoding="utf-8")
    if have != want and write:
        dst.write_text(want, encoding="utf-8")
        print(f"wrote {rel}")
    elif have != want:
        fail += 1
        print(f"FAIL {rel}")
        sys.stdout.writelines(difflib.unified_diff(want.splitlines(True), have.splitlines(True),
                                                   "expected", rel, n=0))
bad = launcher()
if bad:
    print(f"FAIL claude/fable: {bad}")
print(f"check-fable: {n - fail}/{n} files match, launcher {'FAIL' if bad else 'ok'}")
sys.exit(fail > 0 or bool(bad))
