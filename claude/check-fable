# claude/<host>/fable/settings.json = host settings.json + this delta. Code Mode (CC ≥ 2.1.327 beside mods)
# refuses a session behind a gateway (`ANTHROPIC_BASE_URL` off api.anthropic.com), one holding
# `ANTHROPIC_AUTH_TOKEN` + one without feature-flag downloads ⇒ a `fable` session signs in to Anthropic itself
# (`/login`, once per host) + leaves the proxy, its GPT lanes + the cache keeper behind it.
SETTINGS_ENV_DROP = (
    "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL",  # the proxy
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",    # turns feature-flag downloads off
    "CLAUDE_CODE_GATEWAY_HINT_HEADERS",            # read by cache-keepalive alone
)
SETTINGS_ENV_SET = {
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1",
    "CLAUDE_AGENT_LANES": "claude",                # mod agent-lanes → its one-lane Claude table
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",   # the teammate window mods + context-gauge read: Haiku 5.5 = 1M
    # What NONESSENTIAL_TRAFFIC covered, bar telemetry events + flag downloads (both ride together; Code Mode
    # needs the flags). DISABLE_AUTOUPDATER = already in the host file.
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
}
SETTINGS_MODS_DROP = ("idle-compact",)  # reports to cache-keepalive, which a direct session never passes
# idleCompaction: CC's own idle compaction + keepalive work on a direct sign-in ⇒ the host's `false` leaves.
SETTINGS_KEYS_DROP = ("idleCompaction",)
# A stored claude.ai sign-in + flag downloads would also pull the account's connectors + skills into the
# session; the proxy sessions never had them ⇒ kept out.
SETTINGS_KEYS_SET = {"disableClaudeAiConnectors": True, "syncClaudeAiSkills": False}
ADVISOR = re.compile(r"^- Advisor = CC `/advisor`[^\n]*\n- Advisor profile[^\n]*\n", re.MULTILINE)


def claude_md(text, host):
    lines = text.split("\n")
    for start, new in BULLETS:
        hits = [i for i, line in enumerate(lines) if line.startswith(start)]
        if len(hits) != 1:
            raise ValueError(f"bullet starts {len(hits)}x: {start}")
        lines[hits[0]] = new
    text = "\n".join(lines)
    for old, new in EDITS:
        if text.count(old) != 1:
            raise ValueError(f"anchor occurs {text.count(old)}x: {old[:70]}")
        text = text.replace(old, new.replace("{host}", host))
    text, k = ADVISOR.subn("", text)
    if k != 1:
        raise ValueError(f"advisor bullets matched {k}x")
    return text


def settings_json(text, host):
    s = json.loads(text)
    env = s["env"]
    for key in (*SETTINGS_ENV_DROP, *SETTINGS_KEYS_DROP):
        if key not in (env if key in SETTINGS_ENV_DROP else s):
            raise ValueError(f"host settings lack {key}")
    for key in SETTINGS_ENV_DROP:
        del env[key]
    env.update(SETTINGS_ENV_SET)
    mods = env["CLAUDE_CODE_PLUGIN_DIRS"].split(":")
    kept = [m for m in mods if m.rsplit("/", 1)[-1] not in SETTINGS_MODS_DROP]
    if len(kept) != len(mods) - len(SETTINGS_MODS_DROP):
        raise ValueError(f"mods to drop not all listed: {mods}")
    env["CLAUDE_CODE_PLUGIN_DIRS"] = ":".join(kept)
    for key in SETTINGS_KEYS_DROP:
        del s[key]
    s.update(SETTINGS_KEYS_SET)
    return json.dumps(s, indent=2, ensure_ascii=False) + "\n"


def launcher():
    """Stub `claude` on PATH prints its config home, resume hint + arguments; the launcher's own lines precede
    the caller's."""
    with tempfile.TemporaryDirectory() as t:
        home, stub = pathlib.Path(t, "home"), pathlib.Path(t, "bin")
        (home / ".claude" / "fable").mkdir(parents=True)
        stub.mkdir()
        (stub / "claude").write_text('#!/bin/sh\nprintf "%s\\n" "$CLAUDE_CONFIG_DIR" "$CLAUDE_CODE_RESUME_HINT_COMMAND" "$@"\n',
                                     encoding="utf-8")
        (stub / "claude").chmod(0o755)
        env = {"HOME": str(home), "PATH": f"{stub}{os.pathsep}{os.environ['PATH']}"}

        def run():
            return subprocess.run([ROOT / "fable", "--effort", "low", "-p", "a b"], env=env,
                                  capture_output=True, text=True, check=False)

        r = run()
        if r.returncode != 2 or "is missing" not in r.stderr or r.stdout:
            return f"profile absent: rc={r.returncode} stdout={r.stdout!r} stderr={r.stderr!r}"
        (home / ".claude" / "fable" / "CLAUDE.md").write_text("x", encoding="utf-8")
        r = run()
        got = r.stdout.split("\n")[:-1]
        want = [f"{home}/.claude/fable", "fable", "--model", "claude-fable-5-2", "--settings", None, "--effort", "low",
                "-p", "a b"]
        if r.returncode != 0 or len(got) != len(want) or any(w not in (None, g) for g, w in zip(got, want)):
            return f"arguments: rc={r.returncode} {got}"
        if json.loads(got[5]) != {"claudeMdExcludes": [f"{home}/.claude/CLAUDE.md"]}:
            return f"settings: {got[5]}"
    return ""


write = sys.argv[1:] == ["--write"]
n = fail = 0
for host in ("cachyos", "aeon"):
    for name, derive in (("CLAUDE.md", claude_md), ("settings.json", settings_json)):
        n += 1
        src, dst = ROOT / host / name, ROOT / host / "fable" / name
        rel = str(dst.relative_to(ROOT.parent))
        try:
            want = derive(src.read_text(encoding="utf-8"), host)
        except (ValueError, KeyError) as e:
            fail += 1
            print(f"FAIL {rel}: {e}")
            continue
        have = dst.read_text(encoding="utf-8") if dst.exists() else ""
        if have != want and write:
            dst.write_text(want, encoding="utf-8")
            print(f"wrote {rel}")
        elif have != want:
            fail += 1
            print(f"FAIL {rel}")
            sys.stdout.writelines(difflib.unified_diff(want.splitlines(True), have.splitlines(True),
                                                       "expected", rel, n=0))
bad = launcher()
if bad:
    print(f"FAIL claude/fable: {bad}")
print(f"check-fable: {n - fail}/{n} files match, launcher {'FAIL' if bad else 'ok'}")
sys.exit(fail > 0 or bool(bad))
