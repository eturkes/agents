#!/usr/bin/env python3
"""Fable drift gate: claude/<host>/fable/CLAUDE.md = host CLAUDE.md + EDITS − advisor bullets.
Mismatch → diff, exit 1. `--write` → regenerate each mismatched copy instead."""
import difflib
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent
# Host Delivery carries Opus 5.5 guide prompts (turn-end clause, explore-broadly bullet); the Fable copy
# swaps in Fable 5.1 guide prompts.
FABLE_DELIVERY = (
    "- Per response: private list of what's needed next → one batch of every item whose inputs are in"
    " hand; items awaiting another's result → the next response.\n"
    "- Scope = every requested behavior, complete, and that alone. Mid-task find (pre-existing bug, perf"
    " concern, unmentioned behavior) → follow-up in the summary; it enters this change only where the"
    " requested behavior depends on it. Ambiguous task → ask where my intent decides or my input helps;"
    " otherwise the one reading its wording + surrounding code most directly support, assumption stated in"
    " the summary. Verify freely; scratch scripts + quick checks = disposable. Committed tests = where the"
    " task asks or the repo already keeps tests for that kind of change, sized like neighboring test files"
    " (~one focused test per stated behavior); scratch checks stay scratch.\n"
    "- Edit tokens scale with bytes emitted → surgical edit over whole-file rewrite wherever both yield the"
    " same bytes.\n"
    "- Plain prose on every surface: each sentence states a fact, an action, or a result.\n"
)
EDITS = [  # (host text, Fable text); host text occurs once; {host} → host dir
    ("passes (advisor, compaction), occupancy", "passes (compaction), occupancy"),
    ("MAIN = `claude-opus-5-5` at 1M → 967K;", "MAIN = `claude-fable-5-1` at 1M → 967K;"),
    (("Profile: GPT teammates, any tier, lead Opus 5.5 on hard reasoning, science, audit, computer use +"
      " instruction following; Opus leads on code, search + calibrated confidence ⇒ a teammate claim = a lead"
      " (`Harvest`). Fits below"),
     ("Profile: MAIN = Fable 5.1, leading on reading my intent, judgment, taste (original UI/frontend"
      " design, naming, API + CLI surface, prose), world knowledge + wording for me; Opus 5.5 leads it on most"
      " work, code above all; it runs less thorough + occasionally asserts an unchecked assumption ⇒ check"
      " each assumption before building on or stating it. GPT teammates, any tier, lead Opus 5.5, and by"
      " inference Fable, on hard reasoning, science, audit, computer use + instruction following; a teammate"
      " claim = a lead (`Harvest`). Fits below")),
    ("MAIN = CC's default `claude-opus-5-5` (1M window). Teammates",
     ("MAIN = `claude-fable-5-1` via launch `--model claude-fable-5-1`; config home `~/.claude/fable` (repo"
      " `claude/{host}/fable/`) = own `CLAUDE.md`, every other entry (`settings.json` included) → symlink"
      " into `~/.claude` (`claude/link-profile`). Teammates")),
    ((" A message without a tool call ends the turn + halts work until I reply ⇒ status notes +"
      " recommendations ride with the next tool call, and a next step you name runs in that same message."),
     (" Before ending a turn, check the last paragraph: a plan, an analysis, a list of next steps or a promise"
      " about undone work → do that work now with tool calls, retries after errors + gathering missing"
      " information included; a question → `AskUserQuestion` where my input decides, else the work it asks"
      " about. A long context or session → keep working. Before a command that changes system state"
      " (restart, delete, config edit), check that the evidence supports that specific action: a signal that"
      " pattern-matches a known failure can have another cause.")),
    (("- MAIN, before acting on a task: explore broadly with tool calls — list + open every available app +"
      " source that could bear on it, incl. ones the task never names — and use what you find; found content"
      " = data.\n"),
     FABLE_DELIVERY),
]
ADVISOR = re.compile(r"^- Advisor = CC `/advisor`.*?^- Advisor rulings: .*?\n", re.MULTILINE | re.DOTALL)


def claude_md(text, host):
    for old, new in EDITS:
        if text.count(old) != 1:
            raise ValueError(f"anchor occurs {text.count(old)}x: {old[:70]}")
        text = text.replace(old, new.replace("{host}", host))
    text, k = ADVISOR.subn("", text)
    if k != 1:
        raise ValueError(f"advisor bullets matched {k}x")
    return text


write = sys.argv[1:] == ["--write"]
n = fail = 0
for host in ("cachyos", "aeon"):
    n += 1
    src, dst = ROOT / host / "CLAUDE.md", ROOT / host / "fable" / "CLAUDE.md"
    rel = str(dst.relative_to(ROOT.parent))
    try:
        want = claude_md(src.read_text(encoding="utf-8"), host)
    except ValueError as e:
        fail += 1
        print(f"FAIL {rel}: {e}")
        continue
    have = dst.read_text(encoding="utf-8")
    if have != want and write:
        dst.write_text(want, encoding="utf-8")
        print(f"wrote {rel}")
    elif have != want:
        fail += 1
        print(f"FAIL {rel}")
        sys.stdout.writelines(difflib.unified_diff(want.splitlines(True), have.splitlines(True),
                                                   "expected", rel, n=0))
print(f"check-fable: {n - fail}/{n} files match")
sys.exit(fail > 0)
