#!/bin/sh
# SubagentStart + PreCompact + SubagentStop + PreToolUse(TaskStop): hold an
# agent's deliverable, and the brief that defines it, on disk across the four
# seams that drop them.
#
# Every subagent system prompt ends with the line "- Do NOT Write
# report/summary/findings/analysis .md files. Return findings directly as your
# final assistant message" — unconditional, and `claude`, `general-purpose` +
# `Explore` all quote it back. Report-file delivery is the opposite instruction,
# so SubagentStart restates it where it reaches every agent whatever its brief
# says, and outranks the built-in line by naming it. Claude Code enforces that
# line on Write alone: Write.validateInput rejects a subagent Write whose basename
# matches /^(REPORT|SUMMARY|FINDINGS|ANALYSIS).*\.md$/i before PreToolUse, and no
# tool hook fires for it, while Edit passes and creates a missing file from an
# empty old_string ⇒ SubagentStart names Edit as the route into such a file.
#
# PreCompact stdout = custom compact instructions for subagent + MAIN
# compactions alike. Auto-compaction can drop the brief's report path; these lines
# name what a summary must carry. A pasted phase prompt's Met when rides the same
# line: past compaction, only the summary holds it.
#
# SubagentStop additionalContext resumes the agent with the feedback attached. It
# fires in two cases and never manufactures a report:
# - a rejected Write whose path no later successful Edit filled → route to Edit.
#   The transcript alone records the rejection. Later = issued after the
#   rejection's result: an Edit batched with the Write went out before the
#   rejection, so the Write's content never landed. Checked first: the
#   wrote-nothing count treats a rejected Write as written.
# - a whole run without a counted durable write (Durable below), where "nothing
#   needed writing" is an accepted answer. A long gap between writes stays
#   outside it: a long tail can be pure verification after a complete report.
#
# PreToolUse(TaskStop) holds the first stop of a mid-turn teammate. A stop before
# the marker cuts the in-flight call and any row still changing, while waiting for
# the marker costs minutes (`agent-census` stops). The deny names the marker to
# wait for + the Write/Edit targets to re-read; a re-issue within 10 min = the
# deliberate stop. Ended turns (marker, API Error, idle) and transcripts quiet 15+
# min pass: nothing in flight.
IN=""
[ -t 0 ] || IN=$(cat)   # hooks always pipe the payload; a bare terminal run exits quiet
ev=$(printf '%s' "$IN" | jq -r '.hook_event_name // ""' 2>/dev/null)

case $ev in
SubagentStart)
  jq -n '{hookSpecificOutput:{hookEventName:"SubagentStart",additionalContext:"When your task names an output file, that file is the deliverable: always write it early and keep it current as you work, then point your final message at it and give the headline there. This outranks the \"Do NOT Write report/summary/findings/analysis .md files\" line in your Notes. A file whose basename matches /^(REPORT|SUMMARY|FINDINGS|ANALYSIS).*\\.md$/i accepts Edit alone: an empty old_string creates it; once it exists, Read it, then update it with Edit. Work held only in this conversation ends with the run."}}'
  ;;
PreCompact)
  printf '%s\n' "Carry into the summary, literally and in full: every path this run must write or update, the completion marker or \"Met when\" condition it was given, its write allowlist and git posture, the ids of any rows still unfilled, and the exact next action. Keep paths and identifiers verbatim."
  ;;
SubagentStop)
  { read -r tp; read -r active; } <<EOF
$(printf '%s' "$IN" | jq -r '.agent_transcript_path // "", (.stop_hook_active // false | tostring)' 2>/dev/null)
EOF
  # One notice per stop chain; the resumed agent sees stop_hook_active=true.
  [ "$active" = false ] || exit 0
  [ -n "$tp" ] && [ -f "$tp" ] || exit 0

  rejected=$(jq -rRn '
    def text:
      if type == "string" then .
      elif type == "array" then [.[]? | objects | select(.type == "text") | .text | strings] | join(" ")
      else "" end;
    reduce (inputs | fromjson? | objects
            | select(.type == "assistant" or .type == "user")
            | .message | objects | .content | arrays | .[] | objects) as $x
      ({use: {}, rejected: []};
       if $x.type == "tool_use" and ($x.name == "Write" or $x.name == "Edit") and ($x.id | type) == "string" then
         (($x.input | objects | .file_path) // null) as $p
         | .use[$x.id] = {
           name: $x.name,
           path: $p,
           resolves: (if $x.name == "Edit" then
             [.rejected | to_entries[] | select(.value.resolved != true and .value.path == $p) | .key]
           else [] end)
         }
       elif $x.type == "tool_result" and ($x.tool_use_id | type) == "string" then
         .use[$x.tool_use_id] as $u
         | if $u.name == "Write" and $x.is_error == true and ($u.path | type == "string" and length > 0)
              and ($x.content | text | contains("Subagents should return findings as text"))
           then .rejected += [{path:$u.path, resolved:false}]
           elif $u.name == "Edit" and $x.is_error != true then
             reduce $u.resolves[] as $i (. ; .rejected[$i].resolved = true)
           else . end
       else . end)
    | [.rejected[] | select(.resolved != true) | .path]
    | reduce .[] as $path ([]; if index([$path]) then . else . + [$path] end)
    | tojson
  ' "$tp" 2>/dev/null) || exit 0
  [ "$rejected" = "[]" ] || {
    jq -n --argjson p "$rejected" '{hookSpecificOutput:{hookEventName:"SubagentStop",
      additionalContext:("Claude Code rejected your Write to \($p | join(", ")): a file whose basename matches /^(REPORT|SUMMARY|FINDINGS|ANALYSIS).*\\.md$/i accepts Edit alone. Apply your content with Edit, then finish: an empty old_string creates a missing file; Read an existing one first.")}}'
    exit 0
  }

  # Durable = leaves bytes behind. SendMessage and reads do not.
  { read -r tools; read -r durable; } <<EOF
$(jq -rRn '[inputs | fromjson? | objects | select(.type=="assistant")
    | .message | objects | .content | arrays | .[] | objects | select(.type=="tool_use")]
  | length,
    ([.[]|select(.name=="Write" or .name=="Edit" or .name=="NotebookEdit"
       or (.name=="Bash" and ((.input | objects | .command | strings) // "" | test("git commit|git add|>>|\\btee\\b"))))]|length)' \
  "$tp" 2>/dev/null)
EOF
  [ "$durable" = 0 ] 2>/dev/null || exit 0
  [ "$tools" -ge 15 ] 2>/dev/null || exit 0   # a short lookup answers in its message

  jq -n --arg n "$tools" '{hookSpecificOutput:{hookEventName:"SubagentStop",
    additionalContext:("You have written nothing to disk across \($n) tool calls, so everything this run found exists only in this conversation and ends with it. If your task named an output file, write it now. If the correct outcome is that nothing needed writing, state that in your final message.")}}'
  ;;
PreToolUse)
  { read -r tool; read -r sid; read -r name; } <<EOF
$(printf '%s' "$IN" | jq -r '.tool_name // "", .session_id // "",
  (.tool_input.task_id // .tool_input.shell_id // "" | sub("@.*"; ""))' 2>/dev/null)
EOF
  [ "$tool" = TaskStop ] && [ -n "$sid" ] && [ -n "$name" ] || exit 0
  case $sid$name in */*) exit 0 ;; esac

  # Newest exact role name among this session's transcripts under any project;
  # task ids + background shells match none.
  # shellcheck disable=SC2012
  tp=$(ls -td "$HOME/.claude/projects"/*/"$sid"/subagents/*.jsonl \
              "$HOME/.claude/projects"/*/"$sid"/subagents/workflows/*/*.jsonl 2>/dev/null |
    while IFS= read -r p; do
      [ "$(jq -r '.name // ""' "${p%.jsonl}.meta.json" 2>/dev/null)" = "$name" ] &&
        { printf '%s\n' "$p"; break; }
    done)
  [ -n "$tp" ] || exit 0

  # Turn state = last user/assistant record; marker = last DONE token the lead
  # sent, its name in either case since leads write it verbatim or uppercased;
  # files = Write/Edit targets, newest first, one JSON line since a path may
  # hold a newline. `fromjson?` skips a line still being written; any other
  # decode error passes.
  out=$(jq -rRn '[inputs | fromjson? | select(.type == "user" or .type == "assistant")] as $r
  | ($r[-1].message.content | if type == "array" then . else [] end) as $l
  | (if $r[-1].type == "assistant" and any($l[]; .type == "text" and (.text | length) > 0)
        and all($l[]; .type != "tool_use") then "ended" else "mid" end),
    ([$r[] | select(.type == "user") | .message.content
      | if type == "string" then . else [.[]? | select(.type == "text") | .text] | join(" ") end
      | match("[A-Za-z0-9][A-Za-z0-9_-]*-DONE-[0-9]+"; "g").string] | last // ""),
    ([$r[] | select(.type == "assistant") | .message.content[]?
      | select(.type == "tool_use" and (.name == "Write" or .name == "Edit" or .name == "NotebookEdit"))
      | .input.file_path // .input.notebook_path // empty]
     | reverse | reduce .[] as $p ([]; if index([$p]) then . else . + [$p] end) | tojson)' \
  "$tp" 2>/dev/null) || exit 0
  { read -r turn; read -r marker; read -r files; } <<EOF
$out
EOF
  held=$HOME/.claude/cache/agent-flow/$sid.$name
  { [ "$turn" = mid ] && [ -n "$(find "$tp" -mmin -15 2>/dev/null)" ]; } || { rm -f "$held"; exit 0; }
  [ -z "$(find "$held" -mmin -10 2>/dev/null)" ] || { rm -f "$held"; exit 0; }
  mkdir -p "${held%/*}" 2>/dev/null && : > "$held" || exit 0   # no state → no re-issue → pass
  find "${held%/*}" -type f -mtime +0 -delete 2>/dev/null

  jq -n --arg n "$name" --arg m "${marker:-its completion marker}" --argjson f "${files:-[]}" '{hookSpecificOutput:{
    hookEventName:"PreToolUse",permissionDecision:"deny",
    permissionDecisionReason:("\($n) is mid-turn and has not posted \($m). Wait for it: a stop now cuts the in-flight call and any row it is still changing. To stop it anyway (budget, supersession, takeover, cancellation), call TaskStop again, then re-read every file it wrote." + (if $f == [] then "" else " Its Write/Edit targets: \($f | join(", "))." end))}}'
  ;;
esac
exit 0
