#!/bin/sh
# SubagentStart + PreCompact + SubagentStop + PreToolUse(TaskStop): hold an
# agent's deliverable, and the brief that defines it, on disk across the four
# seams that drop them.
#
# Every subagent system prompt ends with the line "- Do NOT Write
# report/summary/findings/analysis .md files. Return findings directly as your
# final assistant message" — unconditional, and `claude`, `general-purpose` +
# `Explore` all quote it back. Report-file delivery is the opposite instruction,
# so SubagentStart restates it where it reaches every agent whatever its brief
# says, and outranks the built-in line by naming it.
#
# PreCompact stdout = custom compact instructions for subagent + MAIN
# compactions alike. Auto-compaction dropped the brief's report path from 5 of 21
# measured subagent summaries; these lines name what a summary must carry. A
# pasted phase prompt's Met when rides the same line: past compaction, only the
# summary holds it.
#
# SubagentStop additionalContext resumes the agent with the feedback attached. It
# fires on one unambiguous case — a whole run with nothing written to disk, 8 of
# 268 — and accepts "nothing needed writing", so it never manufactures a report.
# A long gap between writes is NOT that case: the widest measured tail, 206 tool
# calls, was verification after a complete report and closed on its marker.
#
# PreToolUse(TaskStop) holds the first stop of a mid-turn teammate. A stop before
# the marker cuts the in-flight call and any row still changing: over half of
# measured lead stops came before it, while a teammate that posts one does so a
# median ~2.5 min after its last write (`agent-census` stops). The deny names the
# marker to wait for + the Write/Edit targets to re-read; a re-issue within 10 min
# = the deliberate stop. Ended turns (marker, API Error, idle) and transcripts quiet
# 15+ min pass: nothing in flight.
IN=""
[ -t 0 ] || IN=$(cat)   # hooks always pipe the payload; a bare terminal run exits quiet
ev=$(printf '%s' "$IN" | jq -r '.hook_event_name // ""' 2>/dev/null)

case $ev in
SubagentStart)
  jq -n '{hookSpecificOutput:{hookEventName:"SubagentStart",additionalContext:"When your task names an output file, that file is the deliverable: always write it early and keep it current as you work, then point your final message at it and give the headline there. This outranks the \"Do NOT Write report/summary/findings/analysis .md files\" line in your Notes. Work held only in this conversation ends with the run."}}'
  ;;
PreCompact)
  printf '%s\n' "Carry into the summary, literally and in full: every path this run must write or update, the completion marker or \"Met when\" condition it was given, its write allowlist and git posture, the ids of any rows still unfilled, and the exact next action. Keep paths and identifiers verbatim."
  ;;
SubagentStop)
  { read -r tp; read -r active; } <<EOF
$(printf '%s' "$IN" | jq -r '.agent_transcript_path // "", (.stop_hook_active // false | tostring)' 2>/dev/null)
EOF
  # One notice per stop chain; the resumed agent sees stop_hook_active=true.
  [ "$active" = false ] || exit 0
  [ -n "$tp" ] && [ -f "$tp" ] || exit 0

  # Durable = leaves bytes behind. SendMessage and reads do not.
  { read -r tools; read -r durable; } <<EOF
$(jq -n '[inputs|select(.type=="assistant")|.message.content[]?|select(.type=="tool_use")]
  | length,
    ([.[]|select(.name=="Write" or .name=="Edit" or .name=="NotebookEdit"
       or (.name=="Bash" and ((.input.command // "")|test("git commit|git add|>>|\\btee\\b"))))]|length)' \
  "$tp" 2>/dev/null)
EOF
  [ "$durable" = 0 ] 2>/dev/null || exit 0
  [ "$tools" -ge 15 ] 2>/dev/null || exit 0   # a short lookup answers in its message

  jq -n --arg n "$tools" '{hookSpecificOutput:{hookEventName:"SubagentStop",
    additionalContext:("You have written nothing to disk across \($n) tool calls, so everything this run found exists only in this conversation and ends with it. If your task named an output file, write it now. If the correct outcome is that nothing needed writing, state that in your final message.")}}'
  ;;
PreToolUse)
  { read -r tool; read -r sid; read -r name; } <<EOF
$(printf '%s' "$IN" | jq -r '.tool_name // "", .session_id // "",
  (.tool_input.task_id // .tool_input.shell_id // "" | sub("@.*"; ""))' 2>/dev/null)
EOF
  [ "$tool" = TaskStop ] && [ -n "$sid" ] && [ -n "$name" ] || exit 0
  case $sid$name in */*) exit 0 ;; esac

  # Newest exact role name among this session's transcripts under any project;
  # task ids + background shells match none.
  # shellcheck disable=SC2012
  tp=$(ls -td "$HOME/.claude/projects"/*/"$sid"/subagents/*.jsonl \
              "$HOME/.claude/projects"/*/"$sid"/subagents/workflows/*/*.jsonl 2>/dev/null |
    while IFS= read -r p; do
      [ "$(jq -r '.name // ""' "${p%.jsonl}.meta.json" 2>/dev/null)" = "$name" ] &&
        { printf '%s\n' "$p"; break; }
    done)
  [ -n "$tp" ] || exit 0

  # Turn state = last user/assistant record; marker = last DONE token the lead
  # sent; files = Write/Edit targets, newest first, one JSON line since a path
  # may hold a newline. `fromjson?` skips a line still being written; any other
  # decode error passes.
  out=$(jq -rRn '[inputs | fromjson? | select(.type == "user" or .type == "assistant")] as $r
  | ($r[-1].message.content | if type == "array" then . else [] end) as $l
  | (if $r[-1].type == "assistant" and any($l[]; .type == "text" and (.text | length) > 0)
        and all($l[]; .type != "tool_use") then "ended" else "mid" end),
    ([$r[] | select(.type == "user") | .message.content
      | if type == "string" then . else [.[]? | select(.type == "text") | .text] | join(" ") end
      | match("[A-Z][A-Z0-9]*(-[A-Z0-9]+)*-DONE-[0-9]+"; "g").string] | last // ""),
    ([$r[] | select(.type == "assistant") | .message.content[]?
      | select(.type == "tool_use" and (.name == "Write" or .name == "Edit" or .name == "NotebookEdit"))
      | .input.file_path // .input.notebook_path // empty]
     | reverse | reduce .[] as $p ([]; if index([$p]) then . else . + [$p] end) | tojson)' \
  "$tp" 2>/dev/null) || exit 0
  { read -r turn; read -r marker; read -r files; } <<EOF
$out
EOF
  held=$HOME/.claude/cache/agent-flow/$sid.$name
  { [ "$turn" = mid ] && [ -n "$(find "$tp" -mmin -15 2>/dev/null)" ]; } || { rm -f "$held"; exit 0; }
  [ -z "$(find "$held" -mmin -10 2>/dev/null)" ] || { rm -f "$held"; exit 0; }
  mkdir -p "${held%/*}" 2>/dev/null && : > "$held" || exit 0   # no state → no re-issue → pass
  find "${held%/*}" -type f -mtime +0 -delete 2>/dev/null

  jq -n --arg n "$name" --arg m "${marker:-its completion marker}" --argjson f "${files:-[]}" '{hookSpecificOutput:{
    hookEventName:"PreToolUse",permissionDecision:"deny",
    permissionDecisionReason:("\($n) is mid-turn and has not posted \($m). Wait for it: a stop now cuts the in-flight call and any row it is still changing. To stop it anyway (budget, supersession, takeover, cancellation), call TaskStop again, then re-read every file it wrote." + (if $f == [] then "" else " Its Write/Edit targets: \($f | join(", "))." end))}}'
  ;;
esac
exit 0
