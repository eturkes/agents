#!/bin/sh
# Emit live Claude OAuth token for GET /api/oauth/usage; empty stdout preserves
# cached poll. Source order: unexpired ~/.claude/.credentials.json → newest
# CLIProxyAPI Claude-store refresh. Shared-account refresh races can clear local
# Claude credentials; proxy store = fallback.
cred="${OAUTH_CRED_FILE:-$HOME/.claude/.credentials.json}"
store="${CLI_PROXY_AUTH_DIR:-$HOME/.cli-proxy-api}"

t=$(jq -r --argjson now "$(( $(date +%s) * 1000 ))" \
  '.claudeAiOauth | select((.accessToken // "") != "" and (.expiresAt // 0) > $now) | .accessToken' \
  "$cred" 2>/dev/null)

# Newest Claude entry wins. One jq/file isolates malformed siblings. Descending
# `<last_refresh> <token>` sort puts latest first; absent timestamp = fallback.
if [ -z "$t" ]; then
  best=$(for f in "$store"/*.json; do
      [ -f "$f" ] || continue
      jq -r 'select(.type == "claude" and (.access_token // "") != "")
             | "\(.last_refresh // "") \(.access_token)"' "$f" 2>/dev/null
    done | sort -r | head -1)
  t=${best#* }
fi

printf '%s' "$t"
