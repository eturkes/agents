#!/bin/sh
# Refresh 5h/7d OAuth cache when age >=180s. Detached locked poll ⇒ callers
# return immediately and render cached state. Cache path = $1, default
# ~/.claude/.oauth_usage.json. Shared by statusline + oauth-limit-alert; token =
# ./oauth-token.
uc="${1:-${OAUTH_USAGE_FILE:-$HOME/.claude/.oauth_usage.json}}"
lk="$uc.lock"
now=$(date +%s)

ca=$(stat -c %Y "$uc" 2>/dev/null || echo 0)
[ "$(( now - ca ))" -ge 180 ] || exit 0
lm=$(stat -c %Y "$lk" 2>/dev/null || echo 0)     # reap stale-fetch lock
[ "$lm" -gt 0 ] && [ "$(( now - lm ))" -ge 60 ] && rmdir "$lk" 2>/dev/null
mkdir "$lk" 2>/dev/null || exit 0                # live fetch owns lock

# Credential transport = child-local files/variables; process listings expose
# command structure alone.
setsid -f sh -c '
  t=$("$1" 2>/dev/null)
  if [ -n "$t" ]; then
    r=$(curl -fsS --max-time 8 -H "Authorization: Bearer $t" -H "anthropic-beta: oauth-2025-04-20" https://api.anthropic.com/api/oauth/usage 2>/dev/null)
    [ -n "$r" ] && printf %s "$r" | jq -e .five_hour >/dev/null 2>&1 && printf %s "$r" >"$2.tmp" && mv "$2.tmp" "$2"
  fi
  rmdir "$3" 2>/dev/null
' _ "${OAUTH_TOKEN_CMD:-$(dirname "$0")/oauth-token}" "$uc" "$lk" </dev/null >/dev/null 2>&1 &
