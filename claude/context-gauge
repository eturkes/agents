#!/bin/sh
# Context gauge = assistant usage sum: input + cache creation/read + output.
# Output: "N% used/<window>". Cached system/tool/instruction + hidden-reasoning
# input can exceed transcript-visible text; server tools can bill each internal
# iteration. Window: MAIN = first-party 1M, collapse-managed; teammate =
# unknown-model CLAUDE_CODE_MAX_CONTEXT_TOKENS, compacting at window - 33K.
# POSIX sh + utilities except jq. Globs pin transcript depth; `ls -t` ranks mtime.
# Usage: context-gauge [-p] [<teammate>]
#   (no arg)   → MAIN last turn: session id match, then newest project transcript
#   <teammate> → newest role-name/raw-id match across plain + workflow sessions;
#                report HIGH-WATER turn for sizing across compaction/trailing zero usage
#   -p         → resolved transcript path; marker polling reads LAST assistant text;
#                raw grep also matches spawn prompt + marker-bearing messages
[ "$1" = "-p" ] && { path_only=1; shift; }
transcript_root="$HOME/.claude/projects"
project_transcripts="$transcript_root/$(pwd -P | tr '/.' '--')"
f=""
if [ -n "$1" ]; then
  agent=true # subagent turns carry isSidechain=true
  # Newest-first; filename = raw agent id, meta.json = role name.
  # shellcheck disable=SC2012
  f=$(ls -td "$project_transcripts"/*/subagents/*.jsonl \
              "$project_transcripts"/*/subagents/workflows/*/*.jsonl 2>/dev/null |
    while IFS= read -r p; do
      [ -f "$p" ] || continue
      case ${p##*/} in *"$1"*) printf '%s\n' "$p"; break;; esac
      m=${p%.jsonl}.meta.json
      [ -f "$m" ] && [ "$(jq -r '.name//""' "$m" 2>/dev/null)" = "$1" ] &&
        { printf '%s\n' "$p"; break; }
    done)
else
  agent=false
  for p in "$transcript_root"/*/"$CLAUDE_CODE_SESSION_ID.jsonl"; do
    [ -f "$p" ] && { f=$p; break; }
  done
  # Session-id fallback = newest regular transcript in current project; UUID
  # filenames keep `ls` output unambiguous.
  # shellcheck disable=SC2012
  [ -n "$f" ] || f=$(ls -td "$project_transcripts"/*.jsonl 2>/dev/null |
    while IFS= read -r p; do [ -f "$p" ] && { printf '%s\n' "$p"; break; }; done)
fi
[ -n "$path_only" ] && { [ -n "$f" ] && printf '%s\n' "$f"; exit; }
u=$(jq -n --argjson a "$agent" '[inputs|select(.type=="assistant" and ($a or .isSidechain!=true) and .message.model!="<synthetic>" and (.message.usage|type)=="object" and (.message.usage.cache_read_input_tokens|type)=="number")|.message.usage|.input_tokens+.cache_creation_input_tokens+.cache_read_input_tokens+.output_tokens]|select(length>0)|if $a then max else .[-1] end' "$f" 2>/dev/null)
w=1000000  # MAIN; a teammate runs the model CC reads as unknown, so its window is declared
[ "$agent" = true ] && w=${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-200000}
awk -v u="$u" -v w="$w" '
function h(n){ if(n>=1000000){s=sprintf("%.1fM",n/1000000);sub(/\.0M$/,"M",s);return s}
              return sprintf("%dK",int(n/1000+0.5)) }
BEGIN{ if(u==""){ print "? ?/" h(w); exit }
       print int(u*100/w+0.5) "% " h(u) "/" h(w) }'
