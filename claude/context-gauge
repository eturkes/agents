#!/bin/sh
# Context gauge = assistant usage sum: input + cache creation/read + output.
# Output: "N% used/<window>". Cached system/tool/instruction + hidden-reasoning
# input can exceed transcript-visible text; an advisor/compaction turn sums every
# executor pass into top-level usage → ctx = last executor iteration (CC's rule).
# Denominator = compaction trigger = window - 33K for every loop ⇒ 100% = compaction;
# window = MAIN's 1M | teammate's CLAUDE_CODE_MAX_CONTEXT_TOKENS (unknown model),
# clamped to ACW when set.
# POSIX sh + utilities except jq. Globs pin transcript depth; `ls -t` ranks mtime.
# Usage: context-gauge [-p|-t] [<teammate>]
#   (no arg)   → MAIN last turn: session id match, then newest project transcript
#   <teammate> → newest role-name/raw-id match in this session's plain + workflow
#                transcripts from any cwd (no session id → every session of the
#                cwd project); report HIGH-WATER turn for sizing across
#                compaction/trailing zero usage
#   -p         → resolved transcript path; marker polling reads LAST assistant text;
#                raw grep also matches spawn prompt + marker-bearing messages
#   -t         → "tail N/TOTAL" = tool calls since the last DURABLE one (Write/Edit/
#                NotebookEdit/commit). That distance predicts the work a TaskStop
#                loses (`agent-census` tail). A tail of pure verification is
#                correct, so read it as "ask for a flush", not failure.
[ "$1" = "-p" ] && { path_only=1; shift; }
[ "$1" = "-t" ] && { tail_only=1; shift; }
transcript_root="$HOME/.claude/projects"
# = CC's project dir name: each UTF-16 unit outside [A-Za-z0-9] → '-'; past 200
# units → first 200 + '-' + base36 |Java hashCode| of the path. `; echo .` keeps
# a trailing newline of the path that `$(…)` would strip.
project_transcripts="$transcript_root/$(jq -rn --arg p "$(pwd -P; echo .)" '
  def mod($m): . - (. / $m | floor) * $m;
  def b36: (if . >= 36 then . / 36 | floor | b36 else "" end)
    + "0123456789abcdefghijklmnopqrstuvwxyz"[mod(36):mod(36) + 1];
  [$p[:-2] | explode[] | if . > 65535 then (. - 65536) as $c
    | 55296 + ($c / 1024 | floor), 56320 + ($c | mod(1024)) else . end] as $u
  | [$u[] | if (. >= 48 and . <= 57) or (. >= 65 and . <= 90) or (. >= 97 and . <= 122)
      then . else 45 end] | implode
  | if length <= 200 then . else .[:200] + "-" + (reduce $u[] as $x (0;
      . * 31 + $x | mod(4294967296)) | if . >= 2147483648 then 4294967296 - . else . end
      | b36) end')"
f=""
if [ -n "$1" ]; then
  agent=true # subagent turns carry isSidechain=true
  # Newest-first; filename = raw agent id, meta.json = role name. Names recur
  # across sessions → scope = this session, globbed under every project so any
  # cwd resolves it. A raw-id fragment also hits longer names (rev-1 ⊂ rev-10)
  # → exact role name first.
  r=$transcript_root s="*/$CLAUDE_CODE_SESSION_ID"
  [ -n "$CLAUDE_CODE_SESSION_ID" ] || r=$project_transcripts s='*'
  # shellcheck disable=SC2012,SC2086
  ts=$(ls -td "$r"/$s/subagents/*.jsonl \
               "$r"/$s/subagents/workflows/*/*.jsonl 2>/dev/null)
  f=$(printf '%s\n' "$ts" | while IFS= read -r p; do
      [ "$(jq -r '.name//""' "${p%.jsonl}.meta.json" 2>/dev/null)" = "$1" ] &&
        { printf '%s\n' "$p"; break; }
    done)
  [ -n "$f" ] || f=$(printf '%s\n' "$ts" | while IFS= read -r p; do
      case ${p##*/} in *"$1"*) printf '%s\n' "$p"; break;; esac
    done)
else
  agent=false
  for p in "$transcript_root"/*/"$CLAUDE_CODE_SESSION_ID.jsonl"; do
    [ -f "$p" ] && { f=$p; break; }
  done
  # Session-id fallback = newest regular transcript in current project; UUID
  # filenames keep `ls` output unambiguous.
  # shellcheck disable=SC2012
  [ -n "$f" ] || f=$(ls -td "$project_transcripts"/*.jsonl 2>/dev/null |
    while IFS= read -r p; do [ -f "$p" ] && { printf '%s\n' "$p"; break; }; done)
fi
[ -n "$path_only" ] && { [ -n "$f" ] && printf '%s\n' "$f"; exit; }
[ -n "$tail_only" ] && { [ -n "$f" ] || exit; jq -rn '
  [inputs|select(.type=="assistant")|.message.content[]?|select(.type=="tool_use")
   |(.name=="Write" or .name=="Edit" or .name=="NotebookEdit"
     or (.name=="Bash" and ((.input.command // "")|test("git commit|git add|>>|\\btee\\b"))))]
  | length as $n | ([to_entries[]|select(.value)|.key]|last) as $i
  | "tail \(if $i==null then $n else $n-1-$i end)/\($n)"' "$f"; exit; }
u=$(jq -n --argjson a "$agent" 'def ctx: (.input_tokens//0) as $i | (.cache_creation_input_tokens//0) as $c | (.cache_read_input_tokens//0) as $r | (.output_tokens//0) as $o | ([.iterations[]?|select(type!="object" or (.type!="advisor_message" and .type!="compaction"))]|last) as $x | if $i+$c+$r>0 and (.iterations|type)=="array" and ($x|type)=="object" and ($x.type=="message" or $x.type=="fallback_message") and ([$x.input_tokens,$x.output_tokens,$x.cache_creation_input_tokens,$x.cache_read_input_tokens]|all(type=="number" and (isinfinite or isnan|not) and .>=0)) and $x.input_tokens+$x.cache_creation_input_tokens+$x.cache_read_input_tokens>0 then $x.input_tokens+$x.cache_creation_input_tokens+$x.cache_read_input_tokens+$x.output_tokens else $i+$c+$r+$o end; [inputs|select(.type=="assistant" and ($a or .isSidechain!=true) and .message.model!="<synthetic>" and (.message.usage|type)=="object" and (.message.usage.cache_read_input_tokens|type)=="number")|.message.usage|ctx]|select(length>0)|if $a then max else .[-1] end' "$f" 2>/dev/null)
w=1000000  # MAIN; a teammate runs the model CC reads as unknown, so its window is declared
[ "$agent" = true ] && w=${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-200000}
acw=$CLAUDE_CODE_AUTO_COMPACT_WINDOW
[ "$acw" -gt 0 ] 2>/dev/null && [ "$acw" -lt "$w" ] && w=$acw
w=$((w - 33000))
awk -v u="$u" -v w="$w" '
function h(n){ if(n>=1000000){s=sprintf("%.1fM",n/1000000);sub(/\.0M$/,"M",s);return s}
              return sprintf("%dK",int(n/1000+0.5)) }
BEGIN{ if(u==""){ print "? ?/" h(w); exit }
       print int(u*100/w+0.5) "% " h(u) "/" h(w) }'
