#!/bin/sh
# PreToolUse Bash shim: hold grep commands for the fff search stack (shell fn → rg-fff);
# delegate everything else to rtk. A command containing any grep-leading segment (incl.
# command/if/while/env-assignment prefixes; after ; & | ( { ` or newline) is exempted whole —
# over-exemption is safe (plain shell semantics), under-exemption re-severs fff.
# Wired in settings.json hooks.PreToolUse (matcher Bash); the hook COMMAND snapshots at session
# start, but this file is re-read every invocation → edits apply live.
IN=$(cat)
if printf '%s' "$IN" | jq -er '.tool_input.command // "" | test("(^|[;&|({`\\n])\\s*(([A-Za-z_][A-Za-z0-9_]*=\\S*|command|if|elif|then|else|do|while|until|time)\\s+)*grep\\s")' >/dev/null 2>&1; then
  exit 0
fi
printf '%s' "$IN" | rtk hook claude
