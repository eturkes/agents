#!/bin/sh
# fable — Claude Code with Fable as MAIN (claude/prompts/README.md `Fable as MAIN`).
# Usage: fable [claude arguments], e.g. `fable --effort xhigh`, `fable --resume <id> --effort xhigh`.
# = the Fable profile as config home + the Fable model id + the Opus host file kept out: CC loads
# `<dir>/.claude/CLAUDE.md` of every directory above the launch dir as a project file ⇒ under $HOME a
# profile session also receives `~/.claude/CLAUDE.md`, the file the profile replaces; `claudeMdExcludes`
# drops it (it matches user files too ⇒ a launch setting, never the shared settings.json).
p=$HOME/.claude/fable
[ -f "$p/CLAUDE.md" ] || {
  echo "fable: $p/CLAUDE.md is missing. Deploy the Fable profile first (claude/prompts/README.md, Fable as MAIN)." >&2
  exit 2
}
CLAUDE_CONFIG_DIR=$p exec claude --model claude-fable-5-2 \
  --settings "{\"claudeMdExcludes\":[\"$HOME/.claude/CLAUDE.md\"]}" "$@"
