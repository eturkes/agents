#!/bin/sh
# Claude Code context gauge + rate limits + prompt-cache warmth.
# Mode signal = stdin: JSON ⇒ statusline; TTY/empty ⇒ manual transcript fallback.
# Live usage = total_input_tokens (incl. cache reads/writes) + total_output_tokens;
# transcript fallback uses the same sum.
# Gauge denominator = MAIN's raw model window (JSON context_window_size), which
# is collapse-managed. Teammates declare their own window ⇒ read them with
# context-gauge, which resolves it per target.
j=""
[ -t 0 ] || j=$(cat)
# One jq pass over the piped JSON → all fields, newline-delimited into positional reads. Empty u ⇒ manual.
{ read -r u; read -r w; read -r sp; read -r sr; read -r wp; read -r wr; read -r tp; read -r pd; } <<EOF
$(printf '%s' "$j" | jq -r '(if (.context_window.total_input_tokens? != null or .context_window.total_output_tokens? != null) then ((.context_window.total_input_tokens // 0) + (.context_window.total_output_tokens // 0)) else "" end), .context_window.context_window_size // "", .rate_limits.five_hour.used_percentage // "", .rate_limits.five_hour.resets_at // "", .rate_limits.seven_day.used_percentage // "", .rate_limits.seven_day.resets_at // "", .transcript_path // "", .workspace.project_dir // ""' 2>/dev/null)
EOF
# Real API turn = non-sidechain assistant record carrying usage; shared by the gauge fallback + cache anchor.
api='.type=="assistant" and .isSidechain!=true and .message.model!="<synthetic>" and (.message.usage|type)=="object"'
if [ -n "$u" ]; then c=1
else
  transcript_root="$HOME/.claude/projects"
  f=$(find "$transcript_root" -mindepth 2 -maxdepth 2 -type f -name "$CLAUDE_CODE_SESSION_ID.jsonl" -print -quit 2>/dev/null)
  [ -n "$f" ] || f=$(find "$transcript_root" -mindepth 2 -maxdepth 2 -type f -name '*.jsonl' -printf '%T@ %p\n' 2>/dev/null | sort -nr | cut -d ' ' -f 2- | head -1)
  u=$(jq -n "last(inputs|select($api)|.message.usage|.input_tokens+.cache_creation_input_tokens+.cache_read_input_tokens+.output_tokens)//empty" "$f" 2>/dev/null)
  w=1000000  # MAIN's first-party window
  c=0
fi
[ "$w" -gt 0 ] 2>/dev/null || w=1000000
now=$(date +%s)  # one clock read, reused for reset-delta + cache warmth
# Rate-limit suffix: rate_limits present ⇒ segments; manual/pre-first response ⇒ gauge only.
# seg PCT EPOCH LABEL [RED_S YELLOW_S GREEN_S EXTRA] ⇒ "LABEL N%EXTRA MM/DD HH:MM".
# EXTRA = preformatted leading-space insert between used% and reset.
# LABEL+used%: green >=50; yellow >=75; red >=90.
# Reset: red <=RED_S; yellow <=YELLOW_S; green <=GREEN_S.
# Defaults: red<=1h; yellow<=2h; green=today. 5h green<=3h; 7d red<=5h,
# yellow<=10h, green<=15h.
seg() {
  pct=$(awk -v p="$1" -v l="$3" 'BEGIN{q=int(p+0.5)
    if(q>=90)printf "\033[31m%s %d%%\033[0m",l,q
    else if(q>=75)printf "\033[33m%s %d%%\033[0m",l,q
    else if(q>=50)printf "\033[32m%s %d%%\033[0m",l,q
    else printf "%s %d%%",l,q}')
  dt=$(date -d "@$2" +'%m/%d %H:%M'); delta=$(( $2 - now ))
  rs=${4:-3600}; ys=${5:-7200}
  if [ "$delta" -le "$rs" ]; then dt=$(printf '\033[31m%s\033[0m' "$dt")
  elif [ "$delta" -le "$ys" ]; then dt=$(printf '\033[33m%s\033[0m' "$dt")
  elif [ -n "$6" ]; then [ "$delta" -le "$6" ] && dt=$(printf '\033[32m%s\033[0m' "$dt")
  elif [ "$(date -d "@$2" +%Y%m%d)" = "$(date +%Y%m%d)" ]; then dt=$(printf '\033[32m%s\033[0m' "$dt")
  fi
  printf '%s%s %s' "$pct" "$7" "$dt"
}
# Empty native rate_limits ⇒ cached OAuth usage. oauth-refresh owns cache +
# detached poll; render reads cache synchronously.
if [ -z "$sp$wp" ]; then
  uc="$HOME/.claude/.oauth_usage.json"
  "$HOME/.claude/oauth-refresh" "$uc"
  if [ -s "$uc" ]; then  # render the last good poll; utilization is a %, ISO resets_at → epoch
    { read -r sp; read -r sri; read -r wp; read -r wri; read -r fn; read -r fp; } <<EOF2
$(jq -r '.five_hour.utilization // "", .five_hour.resets_at // "", .seven_day.utilization // "", .seven_day.resets_at // "", (([.limits[]? | select(.kind == "weekly_scoped")] | max_by(.percent // 0)) as $s | if $s == null then "", "" else (($s.scope.model.display_name // $s.scope.surface // "scoped") | ascii_downcase | gsub(" "; "-")), ($s.percent // 0) end)' "$uc" 2>/dev/null)
EOF2
    [ -n "$sri" ] && sr=$(date -d "$sri" +%s 2>/dev/null)
    [ -n "$wri" ] && wr=$(date -d "$wri" +%s 2>/dev/null)
  fi
fi
rl=""
# Weekly model-scoped cache limit (`.limits[] weekly_scoped`) ⇒ 7d-segment
# insert with shared color thresholds.
fx=""
[ -n "$fn" ] && [ -n "$fp" ] && fx=$(awk -v p="$fp" -v n="$fn" 'BEGIN{q=int(p+0.5)
  if(q>=90)printf " \033[31m%s %d%%\033[0m",n,q
  else if(q>=75)printf " \033[33m%s %d%%\033[0m",n,q
  else if(q>=50)printf " \033[32m%s %d%%\033[0m",n,q
  else printf " %s %d%%",n,q}')
[ -n "$sp" ] && [ -n "$sr" ] && rl=" | $(seg "$sp" "$sr" 5h 3600 7200 10800)"
[ -n "$wp" ] && [ -n "$wr" ] && rl="$rl | $(seg "$wp" "$wr" 7d 18000 36000 54000 "$fx")"
# `last` = latest cache-moving API-turn timestamp; prompt-cache TTL = 1h.
# Backward scan stops at latest qualifying assistant usage. Assistant usage is
# authoritative; transcript metadata can advance mtime independently. Streaming
# appends assistant records ⇒ live mid-turn anchor.
# Warmth color: >30m plain; <=30m green; <=15m yellow; expired red.
ttl=3600
ce=$(tac "${tp:-$f}" 2>/dev/null | jq -rn "first(inputs|select($api and ((.message.usage.cache_read_input_tokens//0)+(.message.usage.cache_creation_input_tokens//0))>0)|.timestamp)//empty" 2>/dev/null)
[ -n "$ce" ] && te=$(date -d "$ce" +%s 2>/dev/null) && [ -n "$te" ] && {
  ts="last $(date -d "@$te" +'%m/%d %H:%M')"
  left=$(( ttl - (now - te) ))
  if [ "$left" -le 0 ]; then ts=$(printf '\033[31m%s\033[0m' "$ts")
  elif [ "$left" -le 900 ]; then ts=$(printf '\033[33m%s\033[0m' "$ts")
  elif [ "$left" -le 1800 ]; then ts=$(printf '\033[32m%s\033[0m' "$ts")
  fi
  rl="$rl | $ts"
}
# TZ column qualifying all timestamps, then launch-dir basename.
[ -n "$rl" ] && rl="$rl | $(date +%Z)"
[ -n "$rl" ] && [ -n "$pd" ] && rl="$rl | ${pd##*/}"
awk -v u="$u" -v w="$w" -v c="$c" -v r="$rl" '
function h(n){ if(n>=1000000){s=sprintf("%.1fM",n/1000000);sub(/\.0M$/,"M",s);return s}
              return sprintf("%dK",int(n/1000+0.5)) }
BEGIN{ if(u==""){ print "? ?/" h(w) r; exit }
       p=int(u*100/w+0.5); s=p "% " h(u) "/" h(w)
       if(c&&p>=92) s="\033[31m" s "\033[0m"; else if(c&&p>=75) s="\033[33m" s "\033[0m"; else if(c&&p>=50) s="\033[32m" s "\033[0m"
       print s r }'
