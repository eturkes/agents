#!/bin/sh
# Claude Code context gauge + effort + project phase + rate limits.
# Mode signal = stdin: JSON ⇒ statusline; TTY/empty ⇒ manual transcript fallback.
# Live usage = total_input_tokens (incl. cache reads/writes) + total_output_tokens =
# CC's last-executor-iteration figure; transcript fallback applies the same rule (ctx).
# Gauge denominator = compaction trigger = JSON context_window_size, clamped to ACW
# when set, - 33K for every model. Red = rounded ≥92% = 885K at a 967K trigger,
# ahead of CC's `warn` (trigger - 20K = 947K).
# Teammates → context-gauge, resolving the same way per target.
j=""
[ -t 0 ] || j=$(cat)
# One jq pass over the piped JSON → all fields, newline-delimited into positional reads. Empty u ⇒ manual.
{ read -r u; read -r w; read -r sp; read -r sr; read -r wp; read -r wr; read -r ef; read -r pd; } <<EOF
$(printf '%s' "$j" | jq -r '(if (.context_window.total_input_tokens? != null or .context_window.total_output_tokens? != null) then ((.context_window.total_input_tokens // 0) + (.context_window.total_output_tokens // 0)) else "" end), .context_window.context_window_size // "", .rate_limits.five_hour.used_percentage // "", .rate_limits.five_hour.resets_at // "", .rate_limits.seven_day.used_percentage // "", .rate_limits.seven_day.resets_at // "", .effort.level // "", .workspace.project_dir // .cwd // ""' 2>/dev/null)
EOF
# Real API turn = non-sidechain assistant record carrying usage → gauge fallback.
ctx='def ctx: (.input_tokens//0) as $i | (.cache_creation_input_tokens//0) as $c | (.cache_read_input_tokens//0) as $r | (.output_tokens//0) as $o | ([.iterations[]?|select(type!="object" or (.type!="advisor_message" and .type!="compaction"))]|last) as $x | if $i+$c+$r>0 and (.iterations|type)=="array" and ($x|type)=="object" and ($x.type=="message" or $x.type=="fallback_message") and ([$x.input_tokens,$x.output_tokens,$x.cache_creation_input_tokens,$x.cache_read_input_tokens]|all(type=="number" and (isinfinite or isnan|not) and .>=0)) and $x.input_tokens+$x.cache_creation_input_tokens+$x.cache_read_input_tokens>0 then $x.input_tokens+$x.cache_creation_input_tokens+$x.cache_read_input_tokens+$x.output_tokens else $i+$c+$r+$o end;'
api='.type=="assistant" and .isSidechain!=true and .message.model!="<synthetic>" and (.message.usage|type)=="object"'
if [ -n "$u" ]; then c=1
else
  transcript_root="$HOME/.claude/projects"
  f=$(find "$transcript_root" -mindepth 2 -maxdepth 2 -type f -name "$CLAUDE_CODE_SESSION_ID.jsonl" -print -quit 2>/dev/null)
  [ -n "$f" ] || f=$(find "$transcript_root" -mindepth 2 -maxdepth 2 -type f -name '*.jsonl' -printf '%T@ %p\n' 2>/dev/null | sort -nr | cut -d ' ' -f 2- | head -1)
  u=$(jq -n "$ctx last(inputs|select($api)|.message.usage|ctx)//empty" "$f" 2>/dev/null)
  w=1000000  # MAIN's first-party window
  c=0
fi
[ "$w" -gt 0 ] 2>/dev/null || w=1000000
acw=$CLAUDE_CODE_AUTO_COMPACT_WINDOW
[ "$acw" -gt 0 ] 2>/dev/null && [ "$acw" -lt "$w" ] && w=$acw
w=$((w - 33000))
now=$(date +%s)  # one clock read for every reset delta
# lp LABEL PCT ⇒ "LABEL N%" under the color thresholds every usage figure shares.
lp() {
  awk -v p="$2" -v l="$1" 'BEGIN{q=int(p+0.5)
    if(q>=90)printf "\033[31m%s %d%%\033[0m",l,q
    else if(q>=75)printf "\033[33m%s %d%%\033[0m",l,q
    else if(q>=50)printf "\033[32m%s %d%%\033[0m",l,q
    else printf "%s %d%%",l,q}'
}
# seg PCT EPOCH LABEL [RED_S YELLOW_S GREEN_S EXTRA FMT] ⇒ "LABEL N%EXTRA MM/DD HH:MM".
# EXTRA = preformatted leading-space insert between used% and reset; FMT = reset date format.
seg() {
  pct=$(lp "$3" "$1")
  dt=$(date -d "@$2" +"${8:-%m/%d %H:%M}"); delta=$(( $2 - now ))
  rs=${4:-3600}; ys=${5:-7200}
  if [ "$delta" -le "$rs" ]; then dt=$(printf '\033[31m%s\033[0m' "$dt")
  elif [ "$delta" -le "$ys" ]; then dt=$(printf '\033[33m%s\033[0m' "$dt")
  elif [ -n "$6" ]; then [ "$delta" -le "$6" ] && dt=$(printf '\033[32m%s\033[0m' "$dt")
  elif [ "$(date -d "@$2" +%Y%m%d)" = "$(date +%Y%m%d)" ]; then dt=$(printf '\033[32m%s\033[0m' "$dt")
  fi
  printf '%s%s %s' "$pct" "$7" "$dt"
}
# Empty native rate_limits ⇒ cached OAuth usage. oauth-refresh owns cache +
# detached poll; render reads cache synchronously.
if [ -z "$sp$wp" ]; then
  uc="$HOME/.claude/.oauth_usage.json"
  "$HOME/.claude/oauth-refresh" "$uc"
  if [ -s "$uc" ]; then  # render the last good poll; utilization is a %, ISO resets_at → epoch
    { read -r sp; read -r sri; read -r wp; read -r wri; } <<EOF2
$(jq -r '.five_hour.utilization // "", .five_hour.resets_at // "", .seven_day.utilization // "", .seven_day.resets_at // ""' "$uc" 2>/dev/null)
EOF2
    [ -n "$sri" ] && sr=$(date -d "$sri" +%s 2>/dev/null)
    [ -n "$wri" ] && wr=$(date -d "$wri" +%s 2>/dev/null)
  fi
fi
rl=""
# Codex weekly = the 604800 s window; own segment since its reset ≠ Claude's.
# codex-refresh = detached poll ⇒ render reads the last good cache.
xc="$HOME/.claude/.codex_usage.json"
"$HOME/.claude/codex-refresh" "$xc"
xw=$(jq -r 'first(.rate_limit | .primary_window, .secondary_window | select(.limit_window_seconds? == 604800 and (.used_percent | type) == "number")) | "\(.used_percent) \(.reset_at | numbers // "")"' "$xc" 2>/dev/null) || xw=""  # parse error after a leading document ⇒ drop its output
xp=${xw%% *}; xa=${xw#* }
xs=""
if [ -n "$xa" ]; then xs=" | $(seg "$xp" "$xa" codex 18000 36000 54000)"
elif [ -n "$xp" ]; then xs=" | $(lp codex "$xp")"
fi
[ -n "$sp" ] && [ -n "$sr" ] && rl=" | $(seg "$sp" "$sr" 5h 3600 7200 10800 "" '%H:%M')"
[ -n "$wp" ] && [ -n "$wr" ] && rl="$rl | $(seg "$wp" "$wr" 7d 18000 36000 54000)"
rl="$rl$xs"
# Effort varies per launch (`--effort`) → shown beside the gauge; high/xhigh/max
# spend more per turn ⇒ green/yellow/red.
case $ef in
  high) ef=$(printf '\033[32m%s\033[0m' "$ef") ;;
  xhigh) ef=$(printf '\033[33m%s\033[0m' "$ef") ;;
  max) ef=$(printf '\033[31m%s\033[0m' "$ef") ;;
esac
# Phase = the one `## Phase` section | `Phase:` field (line or heading) in the
# nearest `.agent/spec.md` from the launch dir up to its repo root, read outside
# fences, comments, quotes + indented code; 0 | 2+ declarations ⇒ no phase.
# Open resume note = unticked `RESUME` row (pause.md) ⇒ phase text purple.
# Portable awk (gawk, mawk, busybox) ⇒ no interval expressions. 1 MiB cap bounds each render's read.
ph='function plain(s){ gsub(/~~[^~]*~~/,"",s); gsub(/\*\*|__|`/,"",s); sub(/^[ \t*_]+/,"",s); sub(/[ \t*_]+$/,"",s); return s }
function field(s){ s=plain(s); if(!match(toupper(s),/^PHASE[ \t]*:/)) return "\001"; return plain(substr(s,RLENGTH+1)) }
function unlist(s){ ck=""; li=match(s,/^([-+*]|[0-9]+[.)])([ \t]|$)/)
  if(li){ s=substr(s,RLENGTH+1); sub(/^[ \t]+/,"",s); if(match(s,/^\[[ xX]\]([ \t]|$)/)){ ck=toupper(substr(s,2,1)); s=substr(s,RLENGTH+1) } }
  return s }
function resume(s){ s=unlist(s); if(ck=="X") return 0; s=plain(s)
  return s ~ /^RESUME([^A-Za-z0-9_]|$)/ || toupper(s) ~ /^RESUME[ \t]+NOTE([^A-Z0-9_]|$)/ }
NR==1{ sub(/^\357\273\277/,"") }
{ sub(/\r$/,""); raw=$0
  if(fence!=""){ t=raw; sub(/^ +/,"",t); u=t; gsub("^[" substr(fence,1,1) "]+","",u); sub(/[ \t]+$/,"",u)
    if(length(raw)-length(t)<=fi+3 && substr(t,1,1)!="\t" && index(t,fence)==1 && u=="") fence=""
    next }
  # <!--…--> → space ⇒ adjacent tokens stay split.
  vis=""; rest=raw
  while(rest!=""){
    if(cm){ i=index(rest,"-->"); if(!i) break; rest=substr(rest,i+3); cm=0 }
    else { i=index(rest,"<!--"); if(!i){ vis=vis rest; break }; vis=vis substr(rest,1,i-1) " "; rest=substr(rest,i+4); cm=1 } }
  t=vis; sub(/^ +/,"",t); ind=length(vis)-length(t); if(substr(t,1,1)=="\t") ind=4
  line=t; sub(/^[ \t]+/,"",line); sub(/[ \t]+$/,"",line)
  if(line==""){ blank=1; para=0; next }
  # Indented code cannot interrupt a paragraph; list-item content is no code.
  if(ind>3 && !lst && !para) next
  pb=blank; blank=0; para=0
  if(line ~ /^([-+*]|[0-9]+[.)])([ \t]|$)/) lst=1; else if(pb && ind<2) lst=0
  if(substr(line,1,1)==">") next
  if(match(line,/^(```+|~~~+)/)){ t=substr(line,RLENGTH+1)
    if(substr(line,1,1)=="~" || !index(t,"`")){ fence=substr(line,1,RLENGTH); fi=ind; next } }
  if(match(line,/^#+/) && RLENGTH<=6 && (length(line)==RLENGTH || substr(line,RLENGTH+1,1) ~ /[ \t]/)){
    lv=RLENGTH; ti=substr(line,lv+1); sub(/^[ \t]+/,"",ti); if(ti ~ /^#*$/) ti=""; sub(/[ \t]+#+$/,"",ti); lst=0
    if(lv<=sec){ sec=0; wait=0 }
    if(resume(ti)) rs=1
    if(ind<4){ f=field(ti); if(f=="" || toupper(plain(ti))=="PHASE"){ d[++n]=""; sec=lv; wait=1 } else if(f!="\001") d[++n]=f }
    next }
  para=1
  if(resume(line)) rs=1
  if(ind>3) next
  u=unlist(line); f=field(u)
  if(wait){ d[n]=(f=="\001" ? plain(u) : f); wait=0 }
  else if(!li && f!="\001") d[++n]=f }
END{ p="UNKNOWN"
  if(n==1){ v=toupper(d[1]); split("PROTOTYPE ITERATE IMPLEMENT MAINTAIN",N," ")
    for(k=1;k<=4;k++) if(index(v,N[k])==1 && substr(v,length(N[k])+1,1) !~ /[A-Z0-9_]/){ p=N[k]; break } }
  print p (rs ? " RESUME" : "") }'
sf=""; sd=${pd:-$PWD}
while :; do
  [ -f "$sd/.agent/spec.md" ] && { sf=$sd/.agent/spec.md; break; }
  case $sd in */*) ;; *) break ;; esac
  [ -e "$sd/.git" ] && break
  sd=${sd%/*}
done
pv=UNKNOWN
[ -r "$sf" ] && [ "$(wc -c < "$sf")" -le 1048576 ] && pv=$(LC_ALL=C awk "$ph" "$sf" 2>/dev/null)
case "${pv% RESUME}" in
  IMPLEMENT) pt=implement pc=31 ;;
  ITERATE) pt=iterate pc=33 ;;
  PROTOTYPE) pt=prototype pc=32 ;;
  MAINTAIN) pt=maintain pc= ;;
  *) pt="no phase" pc= ;;
esac
[ "$pv" = "${pv% RESUME}" ] || pc=35
[ -n "$pc" ] && pt=$(printf '\033[%sm%s\033[0m' "$pc" "$pt")
rl=" | $pt$rl"
[ -n "$ef" ] && rl=" | $ef$rl"
awk -v u="$u" -v w="$w" -v c="$c" -v r="$rl" '
function h(n){ if(n>=1000000){s=sprintf("%.1fM",n/1000000);sub(/\.0M$/,"M",s);return s}
              return sprintf("%dK",int(n/1000+0.5)) }
BEGIN{ if(u==""){ print "? ?/" h(w) r; exit }
       p=int(u*100/w+0.5); s=p "% " h(u) "/" h(w)
       if(c&&p>=92) s="\033[31m" s "\033[0m"; else if(c&&p>=75) s="\033[33m" s "\033[0m"; else if(c&&p>=50) s="\033[32m" s "\033[0m"
       print s r }'
