#!/usr/bin/env python3
"""Exercise context-alert routing, tiers, markers and notice text."""

import contextlib
import json
import os
import subprocess
import tempfile
import unittest
from pathlib import Path

ALERT = os.environ.get("ALERT_BIN") or str(Path(__file__).with_name("context-alert"))
AGENT = "aprobe-1-0123456789abcdef"
NOTICE_MAIN = "Checkpoint ahead of compaction: land the current unit on a commit with .agent/spec.md current, then continue."
FINAL_MAIN = "Compaction is imminent: commit now with .agent/spec.md current; after compaction, reorient from spec.md + git log and continue."
NOTICE_AGENT = "Hand off: bring your deliverable current on disk, then return its path, completion status + next action."
FINAL_AGENT = "Compaction is imminent: save progress to your deliverable now, then return its path, completion status + next action."


def assistant(total, *, model="claude-opus-5-5", sidechain=False):
    return {
        "type": "assistant",
        "isSidechain": sidechain,
        "message": {
            "model": model,
            "usage": {
                "input_tokens": 1 if total else 0,
                "cache_creation_input_tokens": 0,
                "cache_read_input_tokens": total - 1 if total else 0,
                "output_tokens": 0,
            },
        },
    }


def teammate(total):
    return assistant(total, model="gpt-6-luna", sidechain=True)


def streaming_stub(total):
    return {
        "type": "assistant",
        "isSidechain": False,
        "message": {"model": "claude-opus-5-5", "usage": {"input_tokens": total, "output_tokens": 0}},
    }


def output(message):
    return json.dumps(
        {"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": message}},
        ensure_ascii=False,
        indent=2,
    ) + "\n"


def transcript(path, records):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(json.dumps(item, separators=(",", ":")) + "\n" for item in records), encoding="utf-8")


def fixture(root, session_records, *, agent_id=None, agent_records=None, workflow=None, agent_type=None, max_tokens="920000", acw=None):
    home = root / "home"
    home.mkdir()
    project = root / "project"
    session_id = "session"
    session_path = project / f"{session_id}.jsonl"
    transcript(session_path, session_records)
    payload = {"transcript_path": str(session_path), "session_id": session_id}
    if agent_id is not None:
        payload["agent_id"] = agent_id
        if agent_records is not None:
            owner_dir = project / session_id / "subagents"
            if workflow is not None:
                owner_dir = owner_dir / "workflows" / workflow
            transcript(owner_dir / f"agent-{agent_id}.jsonl", agent_records)
    if agent_type is not None:
        payload["agent_type"] = agent_type
    env = os.environ.copy()
    env["HOME"] = str(home)
    if max_tokens is None:
        env.pop("CLAUDE_CODE_MAX_CONTEXT_TOKENS", None)
    else:
        env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = str(max_tokens)
    env.pop("CLAUDE_CODE_AUTO_COMPACT_WINDOW", None)
    if acw is not None:
        env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = str(acw)
    return payload, env, home


@contextlib.contextmanager
def scenario(session_records, **options):
    with tempfile.TemporaryDirectory() as temp:
        yield fixture(Path(temp), session_records, **options)


class ContextAlert(unittest.TestCase):
    def invoke(self, payload, env):
        result = subprocess.run(
            [ALERT],
            input=json.dumps(payload, ensure_ascii=False),
            text=True,
            capture_output=True,
            env=env,
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        return result.stdout

    def test_main_uses_session_transcript_and_1m_window(self):
        with scenario([assistant(960000)]) as (payload, env, _):
            self.assertEqual(self.invoke(payload, env), output(f"Context 960K/1M — 40K left. {FINAL_MAIN}"))

    def test_teammate_uses_own_transcript_not_session(self):
        with scenario(
            [assistant(100000)], agent_id=AGENT, agent_records=[teammate(850000)], agent_type="general-purpose"
        ) as (payload, env, _):
            self.assertEqual(self.invoke(payload, env), output(f"Context 850K/887K — 37K left. {NOTICE_AGENT}"))

    def test_teammate_workflow_transcript(self):
        with scenario(
            [assistant(100000)], agent_id=AGENT, agent_records=[teammate(880000)], workflow="run-1"
        ) as (payload, env, _):
            self.assertEqual(self.invoke(payload, env), output(f"Context 880K/887K — 7K left. {FINAL_AGENT}"))

    def test_missing_teammate_transcript_is_quiet(self):
        with scenario([assistant(960000)], agent_id=AGENT, agent_type="general-purpose") as (payload, env, _):
            self.assertEqual(self.invoke(payload, env), "")

    def test_agent_type_without_agent_id_is_main(self):
        with scenario([assistant(900000)], agent_type="Explore") as (payload, env, _):
            self.assertEqual(self.invoke(payload, env), output(f"Context 900K/1M — 100K left. {NOTICE_MAIN}"))

    def test_markers_independent_per_agent(self):
        other = "aprobe-2-0123456789abcdef"
        with scenario(
            [assistant(910000)], agent_id=AGENT, agent_records=[teammate(850000)], agent_type="general-purpose"
        ) as (payload, env, _):
            session = Path(payload["transcript_path"])
            transcript(session.with_suffix("") / "subagents" / f"agent-{other}.jsonl", [teammate(850000)])
            main = {key: payload[key] for key in ("transcript_path", "session_id")}
            self.assertEqual(
                [self.invoke(payload, env), self.invoke(main, env), self.invoke(dict(payload, agent_id=other), env)],
                [
                    output(f"Context 850K/887K — 37K left. {NOTICE_AGENT}"),
                    output(f"Context 910K/1M — 90K left. {NOTICE_MAIN}"),
                    output(f"Context 850K/887K — 37K left. {NOTICE_AGENT}"),
                ],
            )

    def test_main_marker_is_session_and_tier(self):
        with scenario([assistant(960000)]) as (payload, env, home):
            state = home / ".claude" / "cache" / "context-alert"
            state.mkdir(parents=True)
            (state / "session.final").touch()
            self.assertEqual(self.invoke(payload, env), "")

    def test_tier_boundaries(self):
        cases = (
            (899999, ""),
            (900000, output(f"Context 900K/1M — 100K left. {NOTICE_MAIN}")),
            (949999, output(f"Context 949K/1M — 50K left. {NOTICE_MAIN}")),
            (950000, output(f"Context 950K/1M — 50K left. {FINAL_MAIN}")),
        )
        for total, expected in cases:
            with self.subTest(total=total), scenario([assistant(total)]) as (payload, env, _):
                self.assertEqual(self.invoke(payload, env), expected)

    def test_once_per_tier_and_final_jump(self):
        with scenario([assistant(960000)]) as (payload, env, _):
            self.assertEqual(
                [self.invoke(payload, env), self.invoke(payload, env)],
                [output(f"Context 960K/1M — 40K left. {FINAL_MAIN}"), ""],
            )
        with scenario([assistant(900000)]) as (payload, env, _):
            first = [self.invoke(payload, env), self.invoke(payload, env)]
            transcript(Path(payload["transcript_path"]), [assistant(960000)])
            self.assertEqual(
                first + [self.invoke(payload, env), self.invoke(payload, env)],
                [
                    output(f"Context 900K/1M — 100K left. {NOTICE_MAIN}"),
                    "",
                    output(f"Context 960K/1M — 40K left. {FINAL_MAIN}"),
                    "",
                ],
            )

    def test_final_subsumes_notice_after_compaction(self):
        with scenario([assistant(960000)]) as (payload, env, _):
            first = self.invoke(payload, env)
            transcript(Path(payload["transcript_path"]), [assistant(900000)])
            self.assertEqual(
                [first, self.invoke(payload, env)],
                [output(f"Context 960K/1M — 40K left. {FINAL_MAIN}"), ""],
            )

    def test_concurrent_claims_emit_once(self):
        with scenario([assistant(900000)]) as (payload, env, _):
            runs = [
                subprocess.Popen([ALERT], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, env=env)
                for _ in range(16)
            ]
            for run in runs:
                run.stdin.write(json.dumps(payload))
                run.stdin.close()
            results = [(run.communicate()[0], run.returncode) for run in runs]
            self.assertEqual([rc for _, rc in results], [0] * 16)
            self.assertEqual(
                [out for out, _ in results if out],
                [output(f"Context 900K/1M — 100K left. {NOTICE_MAIN}")],
            )

    def test_incomplete_and_synthetic_usage_skipped(self):
        records = [assistant(900000), streaming_stub(960000), assistant(0, model="<synthetic>")]
        with scenario(records) as (payload, env, _):
            self.assertEqual(self.invoke(payload, env), output(f"Context 900K/1M — 100K left. {NOTICE_MAIN}"))

    def test_main_skips_sidechain_records(self):
        with scenario([assistant(925000), assistant(960000, sidechain=True)]) as (payload, env, _):
            self.assertEqual(self.invoke(payload, env), output(f"Context 925K/1M — 75K left. {NOTICE_MAIN}"))

    def test_acw_clamps_window_and_trigger(self):
        for owner, advice in (({}, FINAL_MAIN), ({"agent_id": AGENT, "agent_records": [teammate(190000)]}, FINAL_AGENT)):
            with self.subTest(teammate=bool(owner)), scenario(
                [assistant(190000)], max_tokens="273000", acw="240000", **owner
            ) as (payload, env, _):
                self.assertEqual(self.invoke(payload, env), output(f"Context 190K/207K — 17K left. {advice}"))

    def test_default_teammate_window_200k(self):
        with scenario(
            [assistant(100000)], agent_id=AGENT, agent_records=[teammate(100000)], max_tokens=None
        ) as (payload, env, _):
            self.assertEqual(self.invoke(payload, env), output(f"Context 100K/167K — 67K left. {NOTICE_AGENT}"))

    def test_message_format(self):
        cases = (
            ({}, 923456, f"Context 923K/1M — 76K left. {NOTICE_MAIN}"),
            ({"agent_id": AGENT, "agent_records": [teammate(890000)]}, 890000, f"Context 890K/887K — 0K left. {FINAL_AGENT}"),
        )
        for owner, total, message in cases:
            with self.subTest(total=total), scenario([assistant(total)], **owner) as (payload, env, _):
                self.assertEqual(self.invoke(payload, env), output(message))

    @unittest.skipIf(os.geteuid() == 0, "root ignores mode bits")
    def test_unwritable_state_is_quiet(self):
        with scenario([assistant(900000)]) as (payload, env, home):
            state = home / ".claude" / "cache" / "context-alert"
            state.mkdir(parents=True)
            state.chmod(0o500)
            self.assertEqual(self.invoke(payload, env), "")


if __name__ == "__main__":
    unittest.main()
