#!/bin/sh
# Check notify-scan against fixture transcripts (MAIN + teammate + workflow) and a fixture repo.
# Usage: check-notify-scan — NOTIFY_SCAN=<path> checks another build of the script.
ns=${NOTIFY_SCAN:-$(dirname "$(readlink -f "$0")")/notify-scan}
t=$(mktemp -d) || exit 1
trap 'rm -rf "$t"' EXIT
H=$t/home P=$H/proj S=$H/.claude/projects/p/s n=0 fail=0
mkdir -p "$H/.local/app/agents/claude/agents" "$H/.local/app/agents/bin" "$H/.local/bin" "$H/.claude" \
  "$H/.codex" "$P/.agent" "$P/sub" "$S/subagents/workflows/w"
: > "$H/.local/app/agents/bin/tool"
ln -s ../app/agents/bin/tool "$H/.local/bin/tool"
git -C "$H/.local/app/agents" init -q && printf '/.scratch/\n' > "$H/.local/app/agents/.gitignore"
g() { GIT_AUTHOR_NAME=c GIT_AUTHOR_EMAIL=c@c GIT_COMMITTER_NAME=c GIT_COMMITTER_EMAIL=c@c \
  GIT_AUTHOR_DATE=$1 GIT_COMMITTER_DATE=$1 git -C "$P" commit -qam "$1"; }
git -C "$P" init -q
printf '# Spec\n\n## Intent\n\nv1 goal.\n\n## Tasks\n\n- [ ] a\n' > "$P/.agent/spec.md"
git -C "$P" add -A && g 2026-01-01T00:00:00Z
# tool_use entry: TOOL ID INPUT-JSON
u() { jq -nc --arg n "$1" --arg i "$2" --argjson in "$3" \
  '{type: "assistant", message: {content: [{type: "tool_use", id: $i, name: $n, input: $in}]}}'; }
f() { jq -nc --arg p "$1" '{file_path: $p}'; }
c() { jq -nc --arg c "$1" '{command: $c}'; }
{
  jq -nc --arg d "$P" '{type: "user", cwd: $d, timestamp: "2026-01-02T00:00:00Z"}'
  u Read r1 "$(f "$H/.claude/CLAUDE.md")"
  u Edit e1 "$(f "$H/.claude/CLAUDE.md")"
  u Edit e1 "$(f "$H/.claude/CLAUDE.md")"
  u Write e2 "$(f "$P/CLAUDE.md")"
  u Write e3 "$(f "$P/sub/CLAUDE.local.md")"
  u Edit e4 "$(f "$P/src/x.py")"
  u Edit e5 "$(f "$P/.claude/rules/r.md")"
  u Edit e6 "$(f "$H/.local/bin/tool")"
  u NotebookEdit e7 "$(jq -nc --arg p "$H/.local/app/agents/n.ipynb" '{notebook_path: $p}')"
  u Edit e8 "$(f "$P/CLAUDE_dir/x.md")"
  u Bash b1 "$(c 'cat ~/.claude/CLAUDE.md')"
  u Bash b2 "$(c "sed -i 's/a/b/' ~/.claude/agents/r.md")"
  u Bash b3 "$(c 'cp claude/cachyos/CLAUDE.md ~/.claude/CLAUDE.md')"
  u Bash b4 "$(c 'ls ~/.claude/ >/dev/null 2>&1; echo "a -> b"')"
  u Bash b5 "$(c 'printf x >> "$HOME/.codex/AGENTS.md"')"
  u Bash b6 "$(c "cat > notes.md <<'EOF'
see ~/.claude/CLAUDE.md
EOF")"
  u Bash b7 "$(c 'git -C ~/.local/app/agents log --oneline')"
  u Bash b8 "$(c 'git -C ~/.local/app/agents commit -qm x')"
  u Bash b9 "$(c 'cat .claude/rules/r.md > /tmp/y')"
  u Bash b10 "$(c 'perl -pi -e s/a/b/ ~/.claude/agents/r.md')"
  u Bash b11 "$(c 'sed --in-place s/a/b/ CLAUDE.md')"
  u Bash b12 "$(c 'sed -n 1p ~/.claude/agents/r.md | grep -i x')"
  u Edit e9 "$(f "$H/.claude/projects/p/old.jsonl")"
  u Edit e10 "$(f "$H/.claude/agents/new.md")"
  u Edit e11 "$(f "$H/.local/app/agents/.scratch/x.md")"
  u Bash b13 "$(c 'rm -f ~/.claude/projects/p/old.jsonl')"
  u Bash b14 "$(c 'jq . "$HOME/.claude/projects/p/s.jsonl" > /tmp/x')"
  u Bash b15 "$(c 'rm -f ~/.claude/projects/p/old.jsonl ~/.claude/agents/old.md')"
  printf 'not json\n'
} > "$S.jsonl"
u Write s1 "$(f "$H/.local/app/agents/claude/agents/x.md")" > "$S/subagents/agent-a.jsonl"
u Edit s2 "$(f "$H/AGENTS.md")" > "$S/subagents/workflows/w/agent-b.jsonl"
sed -i 's/v1 goal/v2 goal/; s/- \[ \] a/- [x] a/' "$P/.agent/spec.md"
run() { HOME=$H sh "$ns" "$S.jsonl" 2>&1; }
# ck NAME LINE [absent]: the exact output LINE is present (missing with `absent`).
ck() {
  n=$((n + 1))
  if printf '%s\n' "$out" | grep -qxF -e "$2"; then [ -z "$3" ] && return; else [ -n "$3" ] && return; fi
  fail=$((fail + 1)); printf 'FAIL %s: %s line %s\n' "$1" "${3:-want}" "$2"
}
out=$(HOME=$H sh "$ns" --help); ck help 'POSIX sh + jq. Usage: notify-scan [-h | <transcript>]   (default = `context-gauge -p`)'
out=$(run)
ck totals 'transcripts=3 tool_calls=29 edits=9 leads=7 intent=changed'
for p in "$H/.claude/CLAUDE.md" "$H/.claude/agents/new.md" "$P/CLAUDE.md" "$P/sub/CLAUDE.local.md" "$H/.local/bin/tool" \
  "$H/.local/app/agents/n.ipynb" "$H/.local/app/agents/claude/agents/x.md" "$H/AGENTS.md"; do
  ck "edit ${p#"$H"/}" "edit	$p"
done
for p in "$P/src/x.py" "$P/.claude/rules/r.md" "$P/CLAUDE_dir/x.md" "$H/.claude/projects/p/old.jsonl" \
  "$H/.local/app/agents/.scratch/x.md"; do ck "no-edit ${p#"$H"/}" "edit	$p" absent; done
ck lead-sed "lead	sed -i 's/a/b/' ~/.claude/agents/r.md"
ck lead-perl 'lead	perl -pi -e s/a/b/ ~/.claude/agents/r.md'
ck lead-in-place 'lead	sed --in-place s/a/b/ CLAUDE.md'
ck lead-cp 'lead	cp claude/cachyos/CLAUDE.md ~/.claude/CLAUDE.md'
ck lead-redirect 'lead	printf x >> "$HOME/.codex/AGENTS.md"'
ck lead-commit 'lead	git -C ~/.local/app/agents commit -qm x'
ck lead-beside-runtime 'lead	rm -f ~/.claude/projects/p/old.jsonl ~/.claude/agents/old.md'
for b in 'cat ~/.claude/CLAUDE.md' 'ls ~/.claude/ >/dev/null 2>&1; echo "a -> b"' \
  "cat > notes.md <<'EOF' see ~/.claude/CLAUDE.md EOF" 'git -C ~/.local/app/agents log --oneline' \
  'cat .claude/rules/r.md > /tmp/y' 'sed -n 1p ~/.claude/agents/r.md | grep -i x' \
  'rm -f ~/.claude/projects/p/old.jsonl' 'jq . "$HOME/.claude/projects/p/s.jsonl" > /tmp/x'; do
  ck "no-lead $b" "lead	$b" absent
done
ck intent-edit "edit	$P/.agent/spec.md"
ck intent-old '-v1 goal.'
ck intent-new '+v2 goal.'
ck intent-tasks '+- [x] a' absent
git -C "$P" checkout -q -- .agent/spec.md
out=$(run); ck intent-unchanged 'transcripts=3 tool_calls=29 edits=8 leads=7 intent=unchanged'
GIT_COMMITTER_DATE=2026-01-03T00:00:00Z git -C "$P" -c user.name=c -c user.email=c@c commit -q --amend --no-edit
out=$(run); ck intent-no-base 'transcripts=3 tool_calls=29 edits=8 leads=7 intent=no-base'
rm "$P/.agent/spec.md"
out=$(run); ck intent-no-spec 'transcripts=3 tool_calls=29 edits=8 leads=7 intent=no-spec'
# Transcript without cwd → Intent check skipped, even inside a repo whose Intent changed.
: > "$S.jsonl"; rm -r "$S"
P=$H/other; mkdir -p "$P/.agent"; git -C "$P" init -q
printf '## Intent\n\nv1\n' > "$P/.agent/spec.md"; git -C "$P" add -A && g 2026-01-01T00:00:00Z
echo v2 >> "$P/.agent/spec.md"
out=$(cd "$P" && run); ck empty 'transcripts=1 tool_calls=0 edits=0 leads=0 intent=no-spec'
if [ "$fail" -eq 0 ]; then echo "notify-scan: $n/$n cases pass"; else echo "notify-scan: $fail/$n cases FAIL"; exit 1; fi
