#!/usr/bin/env python3
"""Plugin version stamps: content-derived, local to each plugin, reproducible + check-only under --check."""

import json
import re
import shutil
import subprocess
import tempfile
import unittest
from pathlib import Path

HERE = Path(__file__).resolve().parent
STAMP = re.compile(r"^1\.0\.0\+[0-9a-f]{12}$")


def tracked(root):
    files = subprocess.run(["git", "-C", str(root), "ls-files", "-z", "--", "."],
                           capture_output=True, text=True, check=True).stdout.split("\0")
    return [name for name in files if name] + ["stamp-versions"]


class Stamps(unittest.TestCase):
    def setUp(self):
        directory = tempfile.TemporaryDirectory(prefix="stamp-versions-check-")
        self.addCleanup(directory.cleanup)
        self.base = Path(directory.name)
        self.root = self.copy("marketplace")
        self.manifest = self.root / ".claude-plugin/marketplace.json"
        reset = subprocess.run(["jq", '.plugins[].version = "1.0.0"', str(self.manifest)],
                               capture_output=True, text=True, check=True).stdout
        self.manifest.write_text(reset)
        self.commit(self.root)

    def copy(self, name):
        root = self.base / name
        for file in tracked(HERE):
            (root / file).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(HERE / file, root / file)
        self.git(root, "init", "-q")
        return root

    def git(self, root, *arguments):
        subprocess.run(["git", "-C", str(root), *arguments], capture_output=True, check=True)

    def commit(self, root):
        self.git(root, "add", "-A")
        self.git(root, "-c", "user.name=check", "-c", "user.email=check@localhost", "commit", "-qm", "state")

    def stamp(self, *arguments, root=None):
        return subprocess.run([str((root or self.root) / "stamp-versions"), *arguments],
                              capture_output=True, text=True, timeout=60, check=False)

    def versions(self, root=None):
        data = json.loads(((root or self.root) / ".claude-plugin/marketplace.json").read_text())
        return {plugin["name"]: plugin["version"] for plugin in data["plugins"]}

    def edit_manifest(self, change):
        data = json.loads(self.manifest.read_text())
        change(data)
        self.manifest.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")

    def entry(self, data, name):
        return next(plugin for plugin in data["plugins"] if plugin["name"] == name)

    def stale(self):
        result = self.stamp("--check")
        names = re.findall(r"^stale: (\S+) ", result.stderr, re.MULTILINE)
        self.assertEqual(result.returncode, 1 if names else 0, result.stderr)
        return set(names)

    def test_stamp_then_check_is_clean_and_idempotent(self):
        self.assertEqual(self.stale(), set(self.versions()))
        self.assertEqual(self.stamp().returncode, 0)
        self.assertTrue(all(STAMP.match(version) for version in self.versions().values()), self.versions())
        self.assertEqual(self.stale(), set())
        before = self.manifest.read_bytes()
        self.assertEqual(self.stamp().returncode, 0)
        self.assertEqual(self.manifest.read_bytes(), before)

    def test_rewrite_changes_version_lines_alone(self):
        before = self.manifest.read_text().splitlines()
        self.stamp()
        after = self.manifest.read_text().splitlines()
        changed = [(old, new) for old, new in zip(before, after, strict=True) if old != new]
        self.assertEqual(len(changed), len(self.versions()))
        self.assertTrue(all('"version": "1.0.0"' in old for old, _ in changed), changed)

    def test_check_never_writes(self):
        before = self.manifest.read_bytes()
        self.assertEqual(self.stamp("--check").returncode, 1)
        self.assertEqual(self.manifest.read_bytes(), before)

    def test_file_edit_restamps_its_plugin_alone(self):
        self.stamp()
        before = self.versions()
        with (self.root / "plugins/bash-lsp/cachyos/README.md").open("a") as readme:
            readme.write("\nOne more line.\n")
        self.assertEqual(self.stale(), {"bash-lsp"})
        self.stamp()
        after = self.versions()
        self.assertEqual({name for name in after if after[name] != before[name]}, {"bash-lsp"})

    def test_entry_edit_restamps_its_plugin_alone(self):
        self.stamp()
        self.edit_manifest(lambda data: self.entry(data, "r-lsp")["lspServers"]["r"].update(command="R"))
        self.assertEqual(self.stale(), {"r-lsp"})

    def test_version_field_and_key_order_do_not_count(self):
        self.stamp()
        stamped = self.versions()["xml-lsp"]

        def reorder(data):
            index = data["plugins"].index(self.entry(data, "xml-lsp"))
            entry = dict(reversed(list(data["plugins"][index].items())))
            data["plugins"][index] = entry | {"version": "garbage"}
        self.edit_manifest(reorder)
        self.stamp()
        self.assertEqual(self.versions()["xml-lsp"], stamped)

    def test_untracked_files_count_once_added(self):
        self.stamp()
        self.commit(self.root)
        (self.root / "plugins/xml-lsp/notes.md").write_text("draft\n")
        self.assertEqual(self.stale(), set())
        self.git(self.root, "add", "plugins/xml-lsp/notes.md")
        self.assertEqual(self.stale(), {"xml-lsp"})

    def test_rename_counts(self):
        self.stamp()
        self.commit(self.root)
        self.git(self.root, "mv", "plugins/prolog-lsp/aeon/README.md", "plugins/prolog-lsp/aeon/INSTALL.md")
        self.assertEqual(self.stale(), {"prolog-lsp"})

    def test_same_content_same_stamp_anywhere(self):
        other = self.copy("elsewhere")
        (other / ".claude-plugin/marketplace.json").write_bytes(self.manifest.read_bytes())
        self.commit(other)
        self.stamp()
        self.stamp(root=other)
        self.assertEqual(self.versions(), self.versions(other))

    def test_outside_git_fails_closed(self):
        loose = self.base / "loose"
        shutil.copytree(self.root, loose, ignore=shutil.ignore_patterns(".git"))
        before = (loose / ".claude-plugin/marketplace.json").read_bytes()
        for arguments in ((), ("--check",)):
            result = self.stamp(*arguments, root=loose)
            self.assertNotIn(result.returncode, (0, 1), result.stderr)
            self.assertNotIn("stale:", result.stderr)
        self.assertEqual((loose / ".claude-plugin/marketplace.json").read_bytes(), before)

    def test_repository_manifest_is_current(self):
        result = subprocess.run([str(HERE / "stamp-versions"), "--check"], capture_output=True, text=True,
                                timeout=60, check=False)
        self.assertEqual(result.returncode, 0, result.stderr)


if __name__ == "__main__":
    unittest.main()
