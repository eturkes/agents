{
  "name": "global",
  "owner": {
    "name": "eturkes",
    "email": "emir.turkes@eturkes.com"
  },
  "metadata": {
    "description": "LSP plugins for all projects. Claude Code's LSP tool and its automatic diagnostics use them. Each server executable must be on PATH. Each plugin README gives the install commands."
  },
  "plugins": [
    {
      "name": "xml-lsp",
      "description": "XML LSP via Eclipse LemMinX; covers DMN, BPMN, SHACL-XML and generic XML/XSD",
      "version": "1.0.0",
      "source": "./plugins/xml-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "lemminx": {
          "command": "lemminx",
          "extensionToLanguage": {
            ".xml": "xml",
            ".xsd": "xml",
            ".dmn": "xml",
            ".bpmn": "xml"
          }
        }
      }
    },
    {
      "name": "prolog-lsp",
      "description": "SWI-Prolog LSP via the lsp_server pack (jamesnvc/lsp_server), tracking the default branch",
      "version": "1.0.0",
      "source": "./plugins/prolog-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "prolog": {
          "command": "prolog-lsp",
          "extensionToLanguage": {
            ".pl": "prolog",
            ".pro": "prolog"
          }
        }
      }
    },
    {
      "name": "markdown-lsp",
      "description": "Markdown LSP via Marksman: link + reference diagnostics, heading symbols",
      "version": "1.0.0",
      "source": "./plugins/markdown-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "marksman": {
          "command": "marksman",
          "args": [
            "server"
          ],
          "extensionToLanguage": {
            ".md": "markdown",
            ".qmd": "markdown",
            ".Rmd": "markdown"
          }
        }
      }
    },
    {
      "name": "r-lsp",
      "description": "R LSP via the languageserver package: diagnostics (lintr), definitions, hover",
      "version": "1.0.0",
      "source": "./plugins/r-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "r": {
          "command": "Rscript",
          "args": [
            "-e",
            "languageserver::run()"
          ],
          "extensionToLanguage": {
            ".R": "r",
            ".r": "r"
          }
        }
      }
    },
    {
      "name": "bash-lsp",
      "description": "Bash LSP via bash-language-server; shellcheck diagnostics when shellcheck is on PATH",
      "version": "1.0.0",
      "source": "./plugins/bash-lsp",
      "category": "development",
      "strict": false,
      "lspServers": {
        "bash": {
          "command": "bash-language-server",
          "args": [
            "start"
          ],
          "extensionToLanguage": {
            ".sh": "shellscript",
            ".bash": "shellscript"
          }
        }
      }
    }
  ]
}
