#!/usr/bin/python3
"""Keep the prompt cache of live Claude Code sessions warm across long waits.

Relay Claude Code → CLIProxyAPI; stores each session's last main-thread request. --interval s without one →
quiet session (idle-compact mod report: no turn, no background work) → the mod compacts it, touches end;
else ≤ --touches touches: re-send the request as a stream, cut at message_start ⇒ the cache read renews the
1h entry. CC's own keepalive needs a direct api.anthropic.com connection → off behind these proxies.

Stdlib only: starts without a package cache.
"""
import argparse
import http.client
import http.server
import json
import sys
import threading
import time
import urllib.parse
from dataclasses import dataclass
from pathlib import Path

HOP = frozenset({
    "connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "proxy-connection",
    "te", "trailer", "transfer-encoding", "upgrade", "host", "content-length",
})
SESSION_HEADER = "X-Claude-Code-Session-Id"
CLASS_HEADER = "x-claude-code-request-class"
STATUS_PATH = "/_keepalive"
POLL_FRESH = 90  # s: 3 idle-compact polls; older → no mod report
NO_RETRY = frozenset({400, 401, 403, 404, 413, 422})


def log(message):
    print(message, flush=True)


@dataclass(eq=False)
class Entry:
    session: str
    model: str
    path: str
    headers: list
    body: bytes
    renewed_at: float  # last cache read: the stored request or a touch
    stopped_at: float = 0.0  # end of the stored request's response
    touches: int = 0
    misses: int = 0
    busy: bool = False
    quiet: bool = False  # idle-compact's last report
    working: bool = False  # same report: a turn running, no question open
    polled_at: float = 0.0
    compact_at: float = 0.0  # when the mod was told to compact: one attempt per entry
    state: str = "armed"  # ready (mod report, no stored request) | armed | compacting | compacted | done
    last: str = "armed"


def has_1h_marker(request):
    def marked(block):
        control = block.get("cache_control") if isinstance(block, dict) else None
        return isinstance(control, dict) and control.get("ttl") == "1h"

    if marked(request):
        return True
    for key in ("system", "tools"):
        blocks = request.get(key)
        if isinstance(blocks, list) and any(map(marked, blocks)):
            return True
    for message in request.get("messages") or []:
        content = message.get("content") if isinstance(message, dict) else None
        for block in content if isinstance(content, list) else []:
            inner = block.get("content") if isinstance(block, dict) else None
            if marked(block) or isinstance(inner, list) and any(map(marked, inner)):
                return True
    return False


def live_sessions(directory):
    """{session id: launch dir} per running Claude Code process; flag = every record was readable."""
    live, complete = {}, True
    for path in Path(directory).glob("*.json"):
        try:
            record = json.loads(path.read_text())
            pid, session = int(record["pid"]), record["sessionId"]
        except (OSError, ValueError, KeyError, TypeError):
            complete = False
            continue
        if Path(f"/proc/{pid}").exists():
            live[session] = record.get("cwd")
    return live, complete


def utc(stamp):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(stamp)) if stamp else None


class Keeper:
    def __init__(self, cfg):
        self.cfg = cfg
        self.lock = threading.Lock()
        self.entries = {}

    def candidate(self, method, path, headers, body, now):
        """An Entry for a main-thread Claude request with a 1h breakpoint, else None."""
        if method != "POST" or urllib.parse.urlsplit(path).path != "/v1/messages":
            return None
        session = headers.get(SESSION_HEADER)
        if (headers.get(CLASS_HEADER) or "").lower() != "main" or not session:
            return None
        try:
            request = json.loads(body)
        except ValueError:
            return None
        model = request.get("model") if isinstance(request, dict) else None
        if not (isinstance(model, str) and model.startswith("claude")) or not has_1h_marker(request):
            return None
        if request.get("stream") is not True:
            # A touch must stream to stop at message_start; the flag sits outside the cached prompt.
            request["stream"] = True
            body = json.dumps(request).encode()
        forwarded = [(k, v) for k, v in headers.items() if k.lower() not in HOP]
        return Entry(session, model, path, forwarded, body, now)

    def record(self, entry):
        with self.lock:
            old = self.entries.get(entry.session)
            if old is not None:  # a turn stores requests between the mod's 30-s polls
                entry.quiet, entry.working, entry.polled_at = old.quiet, old.working, old.polled_at
            self.entries[entry.session] = entry
        if old is None or old.state != "armed":
            log(f"armed {entry.session[:8]} model={entry.model} bytes={len(entry.body)}")

    def finish(self, entry, reason):
        """Caller holds the lock. The entry stays listed until its session ends or sends a new request."""
        entry.state, entry.last, entry.body = "done", reason, b""
        log(f"stop {entry.session[:8]}: {reason} after {entry.touches} touches")

    def tick(self, now):
        live, complete = live_sessions(self.cfg.sessions_dir)
        due = []
        with self.lock:
            for session, entry in list(self.entries.items()):
                if session not in live and complete:
                    del self.entries[session]
                    log(f"drop {session[:8]}: session ended")
                    continue
                if entry.busy or entry.state not in ("armed", "compacting"):
                    continue
                if now - entry.renewed_at >= self.cfg.ttl:
                    self.finish(entry, "cache lapsed")
                    continue
                if entry.state == "compacting" and now - entry.polled_at >= POLL_FRESH:
                    # The mod polls throughout its own compaction ⇒ a stale report = the mod is gone.
                    # compact_at stays set ⇒ no second attempt.
                    entry.state, entry.last = "armed", "compaction unreported"
                    log(f"compaction unreported {session[:8]}: touches resume")
                if entry.state != "armed" or now - entry.renewed_at < self.cfg.interval:
                    continue
                if self.compacts(entry, now):
                    continue  # the mod's next poll compacts it
                if entry.touches >= self.cfg.touches:
                    self.finish(entry, "touch limit")
                    continue
                entry.busy = True
                due.append(entry)
        for entry in due:
            threading.Thread(target=self.touch, args=(entry,), daemon=True).start()

    @staticmethod
    def compacts(entry, now):
        """Caller holds the lock. True = the entry's mark goes to the mod's compaction, not a touch."""
        return entry.quiet and now - entry.polled_at < POLL_FRESH and not entry.compact_at

    def mark(self, entry, now):
        """Caller holds the lock. What an armed entry's next mark does: compact | touch | stop; else None."""
        if entry.state != "armed":
            return None
        if self.compacts(entry, now):
            return "compact"
        return "stop" if entry.touches >= self.cfg.touches else "touch"

    def poll(self, session, quiet, working, now):
        """Store the mod's report → {compact: True = compact now, + the entry's touches, limit + state}."""
        with self.lock:
            entry = self.entries.get(session)
            if entry is None:  # no stored request yet (new session, keeper restart mid-turn): the report alone
                entry = self.entries[session] = Entry(session, "", "", [], b"", 0.0, state="ready", last="ready")
            entry.quiet, entry.working, entry.polled_at = quiet, working, now
            reply = {"compact": False, "touches": entry.touches, "limit": self.cfg.touches, "state": entry.state}
            if not quiet or entry.state != "armed" or entry.busy or entry.compact_at \
                    or now - entry.renewed_at < self.cfg.interval:
                return reply
            entry.state, entry.last, entry.compact_at = "compacting", "compacting", now
        log(f"compact {session[:8]} after {entry.touches} touches")
        return reply | {"compact": True, "state": "compacting"}

    def compacted(self, session, ok, reason, usage):
        tokens = ""
        if isinstance(usage, dict):
            tokens = f" read={usage.get('cache_read_input_tokens')} write={usage.get('cache_creation_input_tokens')}"
        with self.lock:
            entry = self.entries.get(session)
            if entry is None or not entry.compact_at:
                return
            if ok:
                entry.state, entry.last, entry.body = "compacted", "compacted" + tokens, b""
            elif entry.state == "compacting":
                entry.state, entry.last = "armed", f"compaction failed: {reason}"
        log(f"compacted {session[:8]}{tokens}" if ok else f"compaction failed {session[:8]}: {reason}")

    def touch(self, entry):
        started = time.time()
        try:
            status, detail = send_touch(self.cfg.upstream, entry, self.cfg.touch_timeout)
        except Exception as exc:  # noqa: BLE001 — any failure must clear busy below
            status, detail = None, f"{type(exc).__name__}: {exc}"
        took = time.time() - started
        with self.lock:
            entry.busy = False
            current = self.entries.get(entry.session) is entry
            if status == 200 and isinstance(detail, dict):
                read = detail.get("cache_read_input_tokens") or 0
                wrote = detail.get("cache_creation_input_tokens") or 0
                entry.renewed_at = started
                entry.touches += 1
                entry.misses = entry.misses + 1 if wrote > read else 0
                entry.last = f"ok read={read} write={wrote} {took:.1f}s"
                stop = "repeated misses" if entry.misses >= 2 else None
            else:
                entry.last = f"failed {status or ''} {str(detail)[:200]}".replace("\n", " ")
                stop = f"rejected {status}" if status in NO_RETRY else None
            if current:
                log(f"touch {entry.session[:8]} {entry.touches}/{self.cfg.touches} {entry.last}")
                if stop:
                    self.finish(entry, stop)

    def status(self):
        dirs, _ = live_sessions(self.cfg.sessions_dir)
        now = time.time()
        with self.lock:
            return [{
                "session": e.session[:8], "dir": dirs.get(e.session), "stopped": utc(e.stopped_at),
                "kept_alive": "compacted" if e.state == "compacted" else e.touches, "last": e.last,
                "state": e.state, "renewed": utc(e.renewed_at), "mark": self.mark(e, now),
                "working": e.working and now - e.polled_at < POLL_FRESH,
            } for e in self.entries.values()]


def send_touch(upstream, entry, timeout):
    """Re-send the stored request; return (status, message_start usage | error text)."""
    conn = http.client.HTTPConnection(upstream.hostname, upstream.port, timeout=timeout)
    try:
        conn.putrequest("POST", entry.path, skip_host=True, skip_accept_encoding=True)
        conn.putheader("Host", upstream.netloc)
        for key, value in entry.headers:
            if key.lower() != "accept-encoding":
                conn.putheader(key, value)
        conn.putheader("Accept-Encoding", "identity")
        conn.putheader("Content-Length", str(len(entry.body)))
        conn.endheaders(entry.body)
        resp = conn.getresponse()
        if resp.status != 200:
            return resp.status, resp.read(2000).decode(errors="replace")
        event = None
        while line := resp.readline(1 << 20):
            line = line.strip()
            if line.startswith(b"event:"):
                event = line[6:].strip()
            elif line.startswith(b"data:") and event == b"message_start":
                return 200, json.loads(line[5:])["message"]["usage"]
            elif line.startswith(b"data:") and event == b"error":
                return 200, line[5:].decode(errors="replace")
        return 200, "stream ended before message_start"
    finally:
        conn.close()  # closing before message_stop cancels generation upstream


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "cache-keepalive"

    def log_message(self, format, *args):
        pass

    def relay(self):
        if self.path.startswith(STATUS_PATH):
            return self.control()
        try:
            body = self.read_body()
        except ValueError:
            self.close_connection = True
            return self.reply(400, error("cache-keepalive: malformed request body"))
        cfg = self.server.cfg
        conn = http.client.HTTPConnection(cfg.upstream.hostname, cfg.upstream.port, timeout=cfg.upstream_timeout)
        started = time.time()
        try:
            conn.putrequest(self.command, self.path, skip_host=True, skip_accept_encoding=True)
            conn.putheader("Host", cfg.upstream.netloc)
            for key, value in self.headers.items():
                if key.lower() not in HOP:
                    conn.putheader(key, value)
            if body or "content-length" in self.headers or "transfer-encoding" in self.headers:
                conn.putheader("Content-Length", str(len(body)))
            conn.endheaders(body)
            entry = self.server.keeper.candidate(self.command, self.path, self.headers, body, started)
            resp = conn.getresponse()
        except (OSError, http.client.HTTPException) as exc:
            conn.close()
            return self.reply(502, error(f"cache-keepalive: upstream unreachable: {exc}"))
        recorded = entry is not None and resp.status == 200
        try:
            if recorded:
                self.server.keeper.record(entry)
            self.forward(resp)
        finally:
            conn.close()
            if recorded:
                entry.stopped_at = time.time()

    def control(self):
        """GET status; POST /poll {session, quiet, working} → poll(); POST /compacted {session, ok, reason, usage}."""
        keeper = self.server.keeper
        if self.command == "GET" and self.path == STATUS_PATH:
            cfg = self.server.cfg
            return self.reply(200, {"entries": keeper.status(), "interval": cfg.interval, "touches": cfg.touches})
        try:
            report = json.loads(self.read_body())
            if self.path == STATUS_PATH + "/poll":
                return self.reply(200, keeper.poll(report["session"], report["quiet"] is True, report.get("working") is True, time.time()))
            if self.path == STATUS_PATH + "/compacted":
                keeper.compacted(report["session"], report["ok"] is True, str(report.get("reason"))[:200], report.get("usage"))
                return self.reply(200, {})
        except (ValueError, KeyError, TypeError):
            self.close_connection = True
        return self.reply(400, error(f"cache-keepalive: bad control request {self.command} {self.path}"))

    do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_HEAD = do_OPTIONS = relay

    def read_body(self):
        if "chunked" in (self.headers.get("Transfer-Encoding") or "").lower():
            chunks = []
            while True:
                size = int(self.rfile.readline(65537).split(b";")[0], 16)
                if size == 0:
                    while self.rfile.readline(65537) not in (b"\r\n", b"\n", b""):
                        pass
                    return b"".join(chunks)
                chunks.append(self.rfile.read(size))
                self.rfile.readline(65537)
        length = int(self.headers.get("Content-Length") or 0)
        return self.rfile.read(length) if length else b""

    def forward(self, resp):
        self.send_response_only(resp.status, resp.reason)
        for key, value in resp.getheaders():
            if key.lower() not in HOP:
                self.send_header(key, value)
        length = None if resp.chunked else resp.getheader("Content-Length")
        if self.command == "HEAD" or resp.status in (204, 304) or resp.status < 200:
            if length is not None:
                self.send_header("Content-Length", length)
            return self.end_headers()
        chunked = length is None
        self.send_header(*(("Transfer-Encoding", "chunked") if chunked else ("Content-Length", length)))
        self.end_headers()
        sse = (resp.getheader("Content-Type") or "").startswith("text/event-stream")
        held = b""
        try:
            while data := resp.read1(65536):
                if sse:
                    data, held = split_block_stop(held + data)
                if data:
                    self.wfile.write(b"%x\r\n%s\r\n" % (len(data), data) if chunked else data)
            if held:
                self.wfile.write(b"%x\r\n%s\r\n" % (len(held), held) if chunked else held)
            if chunked:
                self.wfile.write(b"0\r\n\r\n")
        except (OSError, http.client.HTTPException):
            self.close_connection = True  # either side failed mid-body: end the exchange unterminated

    def reply(self, status, payload):
        data = json.dumps(payload).encode()
        self.send_response_only(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


def split_block_stop(data):
    """(send now, hold): a trailing complete content_block_stop event waits for the next chunk.

    CC writes an in-process teammate's transcript entry on a 100 ms timer and adds usage + stop_reason
    at message_delta; CLIProxyAPI can send message_delta >100 ms after the last content_block_stop →
    without the hold, that entry reaches disk without final usage.
    """
    if not data.endswith(b"\n\n"):
        return data, b""
    cut = data.rfind(b"\n\n", 0, len(data) - 2)
    start = cut + 2 if cut >= 0 else 0
    if data[start:].split(b"\n", 1)[0].partition(b":")[2].strip() == b"content_block_stop":
        return data[:start], data[start:]
    return data, b""


def error(message):
    return {"type": "error", "error": {"type": "api_error", "message": message}}


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    request_queue_size = 128

    def handle_error(self, request, client_address):
        if not isinstance(sys.exc_info()[1], ConnectionError):  # a client reset is routine
            super().handle_error(request, client_address)


def serve(cfg):
    keeper = Keeper(cfg)
    host, port = cfg.listen.rsplit(":", 1)
    server = Server((host, int(port)), Handler)
    server.cfg, server.keeper = cfg, keeper

    def ticks():
        while True:
            time.sleep(cfg.tick)
            try:
                keeper.tick(time.time())
            except Exception as exc:  # noqa: BLE001 — the loop must outlive one bad tick
                log(f"tick failed: {exc!r}")

    threading.Thread(target=ticks, daemon=True).start()
    return server


def parse(argv):
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    p.add_argument("--listen", default="127.0.0.1:8318")
    p.add_argument("--upstream", default="http://127.0.0.1:8317")
    p.add_argument("--interval", type=float, default=3300, help="seconds without a cache read before a compaction or a touch")
    p.add_argument("--ttl", type=float, default=3600, help="cache entry lifetime; the keeper stops for the session after it")
    # break-even: 19 touch reads × 0.1 = a miss's 1-h write 2.0 - a hit's read 0.1
    p.add_argument("--touches", type=int, default=19, help="touches per stored request while the session is not quiet")
    p.add_argument("--tick", type=float, default=30)
    p.add_argument("--touch-timeout", type=float, default=180)
    p.add_argument("--upstream-timeout", type=float, default=900, help="idle read timeout on relayed requests")
    p.add_argument("--sessions-dir", default=str(Path.home() / ".claude" / "sessions"))
    cfg = p.parse_args(argv)
    cfg.upstream = urllib.parse.urlsplit(cfg.upstream)
    return cfg


def main():
    cfg = parse(sys.argv[1:])
    server = serve(cfg)
    log(f"listening {cfg.listen} → {cfg.upstream.geturl()}; compact or touch after {cfg.interval:g}s idle, "
        f"≤{cfg.touches} touches, ttl {cfg.ttl:g}s")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        log("stopped")
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
