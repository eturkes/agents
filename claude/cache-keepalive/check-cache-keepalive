#!/usr/bin/python3
"""Check cache-keepalive against a fake upstream: relay framing, arming rules, touch + compaction lifecycle."""
import calendar
import gzip
import http.client
import http.server
import importlib.machinery
import importlib.util
import json
import os
import select
import socket
import sys
import tempfile
import threading
import time
from pathlib import Path

here = Path(__file__).resolve().parent
sys.dont_write_bytecode = True  # keep __pycache__ out of the repository
loader = importlib.machinery.SourceFileLoader("cache_keepalive", str(here / "cache-keepalive"))
ka = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(ka)
ka.log = lambda message: LOG.append(message)
LOG = []


class Up:
    seen, cut = [], []
    status, usage, pause = 200, {"cache_read_input_tokens": 900, "cache_creation_input_tokens": 0}, 0.0

    @classmethod
    def reset(cls, **kw):
        cls.seen, cls.cut = [], []
        cls.status, cls.pause = 200, 0.0
        cls.usage = {"cache_read_input_tokens": 900, "cache_creation_input_tokens": 0}
        for k, v in kw.items():
            setattr(cls, k, v)


def events(usage):
    start = {"type": "message_start", "message": {"id": "m", "usage": usage}}
    return [f"event: message_start\ndata: {json.dumps(start)}\n\n".encode(),
            b'event: ping\ndata: {"type":"ping"}\n\n',
            b'event: message_stop\ndata: {"type":"message_stop"}\n\n']


GZ = gzip.compress(b"plain body " * 50)


class Upstream(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *args):
        pass

    def do_GET(self):
        Up.seen.append({"path": self.path, "headers": self.headers, "body": b""})
        if self.path == "/plain":
            self.send_response(200)
            self.send_header("Content-Encoding", "gzip")
            self.send_header("Content-Length", str(len(GZ)))
            self.end_headers()
            self.wfile.write(GZ)
        else:  # close-delimited body
            self.send_response(200)
            self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.write(b"until close")
            self.close_connection = True

    def do_POST(self):
        body = self.rfile.read(int(self.headers.get("Content-Length") or 0))
        Up.seen.append({"path": self.path, "headers": self.headers, "body": body})
        if Up.status != 200:
            data = b'{"type":"error","error":{"type":"x","message":"no"}}'
            self.send_response(Up.status)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            return self.wfile.write(data)
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()
        first, *rest = events(Up.usage)
        self.wfile.write(b"%x\r\n%s\r\n" % (len(first), first))
        ready, _, _ = select.select([self.connection], [], [], Up.pause)
        if ready and self.connection.recv(1, socket.MSG_PEEK) == b"":
            Up.cut.append(self.path)
            self.close_connection = True
            return
        for event in rest:
            self.wfile.write(b"%x\r\n%s\r\n" % (len(event), event))
        self.wfile.write(b"0\r\n\r\n")


upstream = ka.Server(("127.0.0.1", 0), Upstream)
threading.Thread(target=upstream.serve_forever, daemon=True).start()
UP_URL = f"http://127.0.0.1:{upstream.server_address[1]}"
sessions = Path(tempfile.mkdtemp(prefix="cache-keepalive-check-"))


def proxy(*extra, up=UP_URL):
    cfg = ka.parse(["--listen", "127.0.0.1:0", "--upstream", up, "--tick", "1e9",
                    "--sessions-dir", str(sessions), *extra])
    server = ka.serve(cfg)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server


def live(session, pid=None):
    (sessions / f"{session}.json").write_text(json.dumps({"pid": pid or os.getpid(), "sessionId": session,
                                                           "cwd": f"/launch/{session}"}))


def body(model="claude-opus-5-5", ttl="1h", stream=True):
    return json.dumps({"model": model, "stream": stream, "max_tokens": 64,
                       "system": [{"type": "text", "text": "s", "cache_control": {"type": "ephemeral", "ttl": ttl}}],
                       "messages": [{"role": "user", "content": [{"type": "text", "text": "hi"}]}]}).encode()


def post(server, session="s1", cls="main", data=None, conn=None, path="/v1/messages?beta=true"):
    conn = conn or http.client.HTTPConnection(*server.server_address, timeout=10)
    headers = {"Content-Type": "application/json", "X-Custom": "kept", "Accept-Encoding": "gzip"}
    if session:
        headers[ka.SESSION_HEADER] = session
    if cls:
        headers[ka.CLASS_HEADER] = cls
    conn.request("POST", path, body=body() if data is None else data, headers=headers)
    resp = conn.getresponse()
    return resp.status, resp.read(), conn


def entries(server):
    return {e["session"]: e for e in server.keeper.status()}


def control(server, path, payload):
    conn = http.client.HTTPConnection(*server.server_address, timeout=10)
    conn.request("POST", f"{ka.STATUS_PATH}/{path}", body=json.dumps(payload).encode())
    resp = conn.getresponse()
    return resp.status, json.loads(resp.read())


def poll(server, session, quiet):
    status, reply = control(server, "poll", {"session": session, "quiet": quiet})
    assert status == 200, (status, reply)
    return reply["compact"]


def wait(predicate, timeout=5.0):
    end = time.time() + timeout
    while time.time() < end:
        if predicate():
            return True
        time.sleep(0.02)
    return False


def backdate(server, session, seconds):
    server.keeper.entries[session].renewed_at -= seconds


def tick(server, ahead=0.0):
    server.keeper.tick(time.time() + ahead)
    wait(lambda: not any(e.busy for e in server.keeper.entries.values()))


checks = []


def check(fn):
    checks.append(fn)
    return fn


@check
def relays_sse_and_arms_main():
    Up.reset()
    server = proxy()
    status, data, conn = post(server)
    assert status == 200 and data == b"".join(events(Up.usage)), "SSE bytes changed in transit"
    seen = Up.seen[-1]
    assert seen["body"] == body() and seen["path"] == "/v1/messages?beta=true", "request changed in transit"
    assert seen["headers"]["X-Custom"] == "kept" and seen["headers"]["Accept-Encoding"] == "gzip"
    assert seen["headers"]["Host"] == UP_URL.removeprefix("http://"), "Host not rewritten"
    status, _, _ = post(server, conn=conn)  # same client connection again
    assert status == 200 and len(Up.seen) == 2, "keep-alive connection not reusable"
    assert list(entries(server)) == ["s1"], "main request not armed"


@check
def relays_raw_and_close_delimited_bodies():
    Up.reset()
    server = proxy()
    conn = http.client.HTTPConnection(*server.server_address, timeout=10)
    conn.request("GET", "/plain")
    resp = conn.getresponse()
    assert resp.getheader("Content-Encoding") == "gzip" and resp.read() == GZ, "encoded body altered"
    conn.request("GET", "/close")
    resp = conn.getresponse()
    assert resp.read() == b"until close", "close-delimited body lost"
    conn.request("GET", "/plain")
    assert conn.getresponse().read() == GZ, "connection unusable after close-delimited upstream"
    assert entries(server) == {}


@check
def arms_only_main_claude_1h_success():
    Up.reset()
    server = proxy()
    post(server, session="aux", cls="auxiliary")
    post(server, session="sub", cls="subagent")
    post(server, session=None)
    post(server, session="gpt", data=body(model="gpt-6-astra"))
    post(server, session="5m", data=body(ttl="5m"))
    post(server, session="count", path="/v1/messages/count_tokens")
    Up.status = 529
    status, _, _ = post(server, session="err")
    assert status == 529, "error status not relayed"
    assert entries(server) == {}, f"armed: {list(entries(server))}"
    Up.reset()
    request = json.loads(body(ttl="5m"))
    request["messages"][0]["content"][0]["cache_control"] = {"type": "ephemeral", "ttl": "1h"}
    post(server, session="msg1h", data=json.dumps(request).encode())
    assert list(entries(server)) == ["msg1h"], "message-level 1h breakpoint not armed"


@check
def touch_resends_verbatim_and_cuts_at_message_start():
    Up.reset(pause=2.0)
    live("tch")
    server = proxy("--interval", "100")
    Up.pause = 0.0
    post(server, session="tch")
    Up.reset(pause=2.0)
    backdate(server, "tch", 50)
    tick(server)
    assert Up.seen == [], "touched before the interval"
    backdate(server, "tch", 51)
    tick(server)
    assert len(Up.seen) == 1, "no touch after the interval"
    touch = Up.seen[0]
    assert touch["body"] == body() and touch["headers"]["X-Custom"] == "kept", "touch request differs"
    assert touch["headers"]["Accept-Encoding"] == "identity"
    assert wait(lambda: Up.cut), "touch stream not closed at message_start"
    entry = entries(server)["tch"]
    assert entry["kept_alive"] == 1 and entry["last"].startswith("ok read=900 write=0"), entry
    assert time.time() - server.keeper.entries["tch"].renewed_at < 5, "touch did not renew the clock"


@check
def non_stream_request_is_touched_as_stream():
    Up.reset()
    live("buf")
    server = proxy("--interval", "100")
    sent = body(stream=False)
    post(server, session="buf", data=sent)
    assert Up.seen[-1]["body"] == sent, "relayed request changed in transit"
    assert list(entries(server)) == ["buf"], "stream:false request not armed"
    Up.reset(pause=2.0)
    backdate(server, "buf", 101)
    tick(server)
    touched = json.loads(Up.seen[0]["body"])
    assert touched == json.loads(sent) | {"stream": True}, "touch differs beyond the stream flag"
    assert wait(lambda: Up.cut), "touch stream not closed at message_start"


@check
def drops_ended_sessions_but_not_on_unreadable_records():
    Up.reset()
    server = proxy()
    live("dead", pid=2**22 + 12345)
    post(server, session="dead")
    post(server, session="gone")
    live("keep")
    post(server, session="keep")
    (sessions / "broken.json").write_text("{")
    tick(server)
    assert set(entries(server)) == {"keep", "dead", "gone"}, "dropped on an unreadable record"
    (sessions / "broken.json").unlink()
    tick(server)
    assert set(entries(server)) == {"keep"}, "ended sessions kept"
    assert any("drop dead: session ended" in line for line in LOG)
    assert Up.seen[-1]["path"] != "touch" and len(Up.seen) == 3, "dead session touched"


@check
def status_lists_dir_stop_time_and_count():
    Up.reset()
    live("stat")
    server = proxy()
    before = time.time()
    post(server, session="stat")
    assert wait(lambda: entries(server)["stat"]["stopped"]), "no stop time"
    entry = entries(server)["stat"]
    stopped = calendar.timegm(time.strptime(entry["stopped"], "%Y-%m-%dT%H:%M:%SZ"))
    assert entry["dir"] == "/launch/stat" and entry["kept_alive"] == 0, entry
    assert int(before) <= stopped <= time.time(), "stop time not the response end in UTC"


@check
def waiting_session_touches_up_to_limit():
    Up.reset()
    live("wait")
    server = proxy("--interval", "100", "--touches", "2")
    post(server, session="wait")
    assert poll(server, "wait", False) is False
    for n in (1, 2):
        backdate(server, "wait", 101)
        tick(server)
        assert entries(server)["wait"]["kept_alive"] == n, f"touch {n} missing"
    backdate(server, "wait", 101)
    tick(server)
    entry = entries(server)["wait"]
    assert len(Up.seen) == 3 and entry["last"] == "touch limit", entry
    tick(server, ahead=1e4)
    assert len(Up.seen) == 3 and entries(server)["wait"]["kept_alive"] == 2, "finished entry touched or unlisted"


@check
def drops_on_lapse():
    Up.reset()
    live("lapse")
    server = proxy("--interval", "100", "--ttl", "200")
    post(server, session="lapse")
    Up.status = 503
    tick(server, ahead=150)
    assert entries(server)["lapse"]["last"].startswith("failed 503"), "failed touch not recorded"
    tick(server, ahead=201)
    assert entries(server)["lapse"]["last"] == "cache lapsed", "kept past cache lapse"
    tick(server, ahead=1e4)
    assert len(Up.seen) == 2, "lapsed entry touched"


@check
def quiet_session_compacts_once_at_mark():
    Up.reset()
    live("q")
    server = proxy("--interval", "100")
    post(server, session="q")
    assert poll(server, "q", True) is False, "compacted before the mark"
    backdate(server, "q", 101)
    tick(server)
    assert len(Up.seen) == 1, "quiet session touched"
    assert poll(server, "q", True) is True, "no compaction at the mark"
    assert poll(server, "q", True) is False, "compaction handed out twice"
    tick(server)
    usage = {"cache_read_input_tokens": 900, "cache_creation_input_tokens": 40}
    assert control(server, "compacted", {"session": "q", "ok": True, "usage": usage}) == (200, {})
    entry = entries(server)["q"]
    assert entry["kept_alive"] == "compacted" and entry["last"] == "compacted read=900 write=40", entry
    tick(server, ahead=1e4)
    assert len(Up.seen) == 1 and entries(server)["q"]["kept_alive"] == "compacted", "compacted session touched"
    post(server, session="q")
    assert entries(server)["q"]["kept_alive"] == 0, "new request did not re-arm"


@check
def quiet_after_touches_compacts():
    Up.reset()
    live("auq")
    server = proxy("--interval", "100")
    post(server, session="auq")
    poll(server, "auq", False)
    backdate(server, "auq", 101)
    tick(server)
    assert entries(server)["auq"]["kept_alive"] == 1
    backdate(server, "auq", 101)
    assert poll(server, "auq", True) is True, "quiet after a wait did not compact"


@check
def failed_compaction_or_silent_mod_falls_back_to_touch():
    Up.reset()
    live("fail")
    live("gone")
    server = proxy("--interval", "100")
    post(server, session="fail")
    backdate(server, "fail", 101)
    assert poll(server, "fail", True) is True
    control(server, "compacted", {"session": "fail", "ok": False, "reason": "vetoed"})
    assert entries(server)["fail"]["last"] == "compaction failed: vetoed"
    tick(server)
    assert entries(server)["fail"]["kept_alive"] == 1, "failed compaction not followed by a touch"
    backdate(server, "fail", 101)
    assert poll(server, "fail", True) is False, "compaction retried"
    post(server, session="gone")
    poll(server, "gone", True)
    server.keeper.entries["gone"].polled_at -= ka.POLL_FRESH
    backdate(server, "gone", 101)
    tick(server)
    assert entries(server)["gone"]["kept_alive"] == 1, "stale quiet report blocked the touch"


@check
def control_rejects_malformed_reports():
    server = proxy()
    for path, payload in (("poll", {"quiet": True}), ("compacted", ["x"]), ("other", {"session": "x"})):
        status, reply = control(server, path, payload)
        assert status == 400 and reply["type"] == "error", (path, status, reply)


@check
def drops_on_rejection_and_repeated_misses():
    Up.reset()
    live("rej")
    live("miss")
    server = proxy("--interval", "100")
    post(server, session="rej")
    post(server, session="miss")
    Up.status = 400
    server.keeper.entries["miss"].busy = True  # one session at a time
    tick(server, ahead=101)
    assert entries(server)["rej"]["last"] == "rejected 400", "kept touching after a 400"
    Up.reset(usage={"cache_read_input_tokens": 0, "cache_creation_input_tokens": 900})
    server.keeper.entries["miss"].busy = False
    tick(server, ahead=101)
    assert entries(server)["miss"]["kept_alive"] == 1, "first miss dropped"
    tick(server, ahead=202)
    assert entries(server)["miss"]["last"] == "repeated misses", "kept touching after two misses"


@check
def new_request_replaces_entry():
    Up.reset()
    live("rep")
    server = proxy("--interval", "100")
    post(server, session="rep")
    newer = body().replace(b'"hi"', b'"again"')
    post(server, session="rep", data=newer)
    Up.reset()
    tick(server, ahead=101)
    assert Up.seen and Up.seen[0]["body"] == newer, "touch did not use the newest request"


@check
def unreachable_upstream_returns_502():
    probe = socket.socket()
    probe.bind(("127.0.0.1", 0))
    port = probe.getsockname()[1]
    probe.close()
    server = proxy(up=f"http://127.0.0.1:{port}")
    status, data, _ = post(server)
    assert status == 502 and json.loads(data)["type"] == "error", (status, data)


for fn in checks:
    LOG.clear()
    fn()
    print(f"{fn.__name__}: OK")
print(f"checks={len(checks)}: OK")
