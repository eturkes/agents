# msmtp -- Gmail relay for the Claude Code turn-email mod.
# App password of emiru.tarukesu@gmail.com (the Claude-only mailbox) in ~/.config/claude-mail/app-password;
# Google prints it in groups of four → spaces stripped.

defaults
tls             on
tls_starttls    on
tls_trust_file  /etc/ssl/certs/ca-certificates.crt
logfile         ~/.claude/cache/msmtp.log

account         gmail
host            smtp.gmail.com
port            587
auth            on
from            emiru.tarukesu@gmail.com
user            emiru.tarukesu@gmail.com
passwordeval    "tr -d ' \n' < $HOME/.config/claude-mail/app-password"

account default : gmail
