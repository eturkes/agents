# msmtp -- Gmail relay for the Claude Code turn-email mod.
# XOAUTH2: the token helper mints short-lived access tokens from the refresh token in
# ~/.config/claude-mail/oauth.json; Internal eturkes.com Workspace client → no 7-day testing-mode expiry.

defaults
tls             on
tls_starttls    on
tls_trust_file  /etc/ssl/certs/ca-certificates.crt
logfile         ~/.claude/cache/msmtp.log

account         gmail
host            smtp.gmail.com
port            587
auth            xoauth2
from            emir.turkes@eturkes.com
user            emir.turkes@eturkes.com
passwordeval    "$HOME/.claude/gmail-oauth-token"

account default : gmail
