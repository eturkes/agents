# msmtp -- Gmail relay for the Claude Code turn-email Stop hook.
# XOAUTH2 rather than a password: the token helper mints short-lived access tokens from a refresh
# token in ~/.config/claude-mail/oauth.json. The OAuth client is Internal to the eturkes.com
# Workspace, so the refresh token does not expire on the 7-day testing-mode clock.

defaults
tls             on
tls_starttls    on
tls_trust_file  /etc/ssl/certs/ca-certificates.crt
logfile         ~/.claude/cache/msmtp.log

account         gmail
host            smtp.gmail.com
port            587
auth            xoauth2
from            emir.turkes@eturkes.com
user            emir.turkes@eturkes.com
passwordeval    "$HOME/.claude/gmail-oauth-token"

account default : gmail
