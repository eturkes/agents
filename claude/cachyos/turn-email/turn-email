#!/bin/sh
# Stop + Notification hook: one email per completed MAIN turn (Stop) and one per
# pending user dialog (Notification, permission_prompt|elicitation_dialog =
# AskUserQuestion + permission prompts). Stop/SubagentStop event split =
# structural scope. Detached SMTP + unconditional exit 0 isolate turn outcome.
# Missing client/config ⇒ silent no-op. Credentials = ~/.msmtprc (0600).
# Body = base64 text/plain for SMTP line limit + Unicode; subject = RFC 2047.
TO=${CLAUDE_TURN_EMAIL_TO:-emir.turkes@eturkes.com}
FROM=${CLAUDE_TURN_EMAIL_FROM:-$TO}
cache=$HOME/.claude/cache/turn-email
log=$cache.log

IN=$(cat)
command -v msmtp >/dev/null 2>&1 || exit 0
[ -r "$HOME/.msmtprc" ] || exit 0

sid=$(printf '%s' "$IN" | jq -r '.session_id // "unknown"' 2>/dev/null)
cwd=$(printf '%s' "$IN" | jq -r '.cwd // ""' 2>/dev/null)
tp=$(printf '%s' "$IN" | jq -r '.transcript_path // ""' 2>/dev/null)
event=$(printf '%s' "$IN" | jq -r '.hook_event_name // "Stop"' 2>/dev/null)
mode=$(printf '%s' "$IN" | jq -r '.permission_mode // "?"' 2>/dev/null)
effort=$(printf '%s' "$IN" | jq -r '.effort.level // "?"' 2>/dev/null)
# Response cap keeps mail notification-sized; transcript remains archive.
resp=$(printf '%s' "$IN" | jq -r '(.last_assistant_message // "")[0:100000]' 2>/dev/null)

# One streaming reduce extracts prompt/model/context with bounded memory.
# Sidechain entries skip; textless tool_result entries fall through empty-text gate.
meta=$(jq -cn '
  def txt: if type == "string" then .
           else [.[]? | select(.type == "text") | .text] | join("\n") end;
  reduce inputs as $e ({};
    if ($e.isSidechain // false) then .
    elif $e.type == "user" and (($e.isMeta // false) | not) then
      (($e.message.content | txt) // "" | gsub("<system-reminder>.*?</system-reminder>"; ""; "s")
        | gsub("^\\s+|\\s+$"; "")) as $t
      | if $t == "" then . else .prompt = ($t[0:4000]) end
    elif $e.type == "assistant" and $e.message.model != "<synthetic>" then
      .model = ($e.message.model // .model)
      | if ($e.message.usage | type) == "object" then
          .ctx = ($e.message.usage
                  | .input_tokens + .cache_creation_input_tokens
                    + .cache_read_input_tokens + .output_tokens)
        else . end
    else . end)' "$tp" 2>/dev/null)

prompt=$(printf '%s' "$meta" | jq -r '.prompt // ""' 2>/dev/null)
model=$(printf '%s' "$meta" | jq -r '.model // "?"' 2>/dev/null)
ctx=$(printf '%s' "$meta" | jq -r 'if .ctx then "\(.ctx / 1000 | floor)K" else "?" end' 2>/dev/null)

# Per-session turn counter; stale sessions reaped after 7d. Stop advances it;
# a Notification reads it, so the mail threads under the turn it interrupts.
mkdir -p "$cache" 2>/dev/null || exit 0
find "$cache" -maxdepth 1 -type f -mtime +7 -delete 2>/dev/null
n=0; [ -f "$cache/$sid" ] && IFS= read -r n <"$cache/$sid" 2>/dev/null

proj=$(basename "${cwd:-$HOME}")
if [ "$event" = Notification ]; then
  # Payload carries no assistant text: the pending question = the transcript's
  # last AskUserQuestion input; a bare permission prompt reports its message.
  ntype=$(printf '%s' "$IN" | jq -r '.notification_type // "?"' 2>/dev/null)
  nmsg=$(printf '%s' "$IN" | jq -r '.message // ""' 2>/dev/null)
  q=$(jq -rn '[inputs | select(.type == "assistant" and (.isSidechain // false | not))
                | .message.content[]? | select(.type == "tool_use" and .name == "AskUserQuestion")
                | .input] | last // empty
              | .questions[] | "[\(.header)] \(.question)\n"
                + ([.options[] | "  - \(.label): \(.description)"] | join("\n"))' "$tp" 2>/dev/null)
  resp="pending: $ntype — $nmsg
${q:+
$q}"
  line1=$(printf '%s' "${q:-$nmsg}" | jq -Rrs 'split("\n")[0] | .[0:72]' 2>/dev/null)
  subj="[cc] $proj #$n needs input — ${line1:-(dialog)}"
  mid="cc.$sid.$n.ask.$(date +%s)"
  label=input
else
  [ -n "$prompt$resp" ] || exit 0
  n=$((n + 1)); printf '%s' "$n" >"$cache/$sid" 2>/dev/null
  line1=$(printf '%s' "$prompt" | jq -Rrs 'split("\n")[0] | .[0:72]' 2>/dev/null)
  subj="[cc] $proj #$n — ${line1:-(no prompt)}"
  mid="cc.$sid.$n"
  label=response
fi

hdr=$(mktemp "${TMPDIR:-/tmp}/cc-mail.XXXXXX") || exit 0
body=$(mktemp "${TMPDIR:-/tmp}/cc-body.XXXXXX") || { rm -f "$hdr"; exit 0; }

{
  printf 'Session   : %s (turn %s)\n' "$sid" "$n"
  printf 'Directory : %s\n' "${cwd:-?}"
  printf 'Model     : %s · effort %s · %s\n' "$model" "$effort" "$mode"
  printf 'Context   : %s\n' "$ctx"
  printf 'Time      : %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"
  printf 'Transcript: %s\n' "${tp:-?}"
  printf '\n───────────────────────────── prompt ─────────────────────────────\n\n'
  printf '%s\n' "${prompt:-(none)}"
  printf '\n──────────────────────────── %s ────────────────────────────\n\n' "$label"
  printf '%s\n' "${resp:-(none)}"
} >"$body"

# References threads session turns; Auto-Submitted suppresses automated replies.
{
  printf 'From: %s\n' "$FROM"
  printf 'To: %s\n' "$TO"
  printf 'Subject: =?UTF-8?B?%s?=\n' "$(printf '%s' "$subj" | base64 -w0)"
  printf 'Date: %s\n' "$(date -R)"
  printf 'Message-ID: <%s@eturkes.com>\n' "$mid"
  printf 'References: <cc.%s@eturkes.com>\n' "$sid"
  printf 'In-Reply-To: <cc.%s@eturkes.com>\n' "$sid"
  printf 'Auto-Submitted: auto-generated\n'
  printf 'X-Claude-Session: %s\n' "$sid"
  printf 'MIME-Version: 1.0\n'
  printf 'Content-Type: text/plain; charset=utf-8\n'
  printf 'Content-Transfer-Encoding: base64\n\n'
  base64 -w 76 "$body"
} >"$hdr"

(
  msmtp --read-recipients <"$hdr" 2>>"$log" ||
    printf '%s turn-email: send failed (session %s turn %s)\n' "$(date -Is)" "$sid" "$n" >>"$log"
  rm -f "$hdr" "$body"
) </dev/null >/dev/null 2>&1 &

exit 0
