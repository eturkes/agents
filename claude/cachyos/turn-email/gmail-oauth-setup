#!/usr/bin/env python3
"""One-time Gmail OAuth2 authorization for the turn-email hook.

Runs the installed-app loopback flow: prints an authorization URL, serves 127.0.0.1 to catch the
redirect, then exchanges the code for a refresh token and writes ~/.config/claude-mail/oauth.json.

  gmail-oauth-setup --client-id ID --client-secret SECRET

SMTP XOAUTH2 needs the full https://mail.google.com/ scope; the narrower gmail.send scope is
rejected by the SMTP endpoint. access_type=offline + prompt=consent are what make Google return a
refresh token rather than an access token alone.
"""
import argparse
import http.server
import json
import os
import secrets
import sys
import threading
import time
import urllib.parse
import urllib.request

AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth"
TOKEN_URL = "https://oauth2.googleapis.com/token"
SCOPE = "https://mail.google.com/"
CRED = os.path.expanduser(os.environ.get("CLAUDE_MAIL_CRED", "~/.config/claude-mail/oauth.json"))

result = {}


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        result.update({k: v[0] for k, v in q.items()})
        ok = "code" in result
        body = (
            b"<html><body style='font:16px sans-serif;padding:3em'>"
            + (b"<h2>Authorized.</h2><p>Claude Code can now send mail. Close this tab.</p>"
               if ok else b"<h2>Authorization failed.</h2><p>Check the terminal.</p>")
            + b"</body></html>"
        )
        self.send_response(200)
        self.send_header("Content-Type", "text/html")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *a):
        pass


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--client-id", required=True)
    ap.add_argument("--client-secret", required=True)
    ap.add_argument("--timeout", type=int, default=300)
    args = ap.parse_args()

    srv = http.server.HTTPServer(("127.0.0.1", 0), Handler)
    redirect = f"http://127.0.0.1:{srv.server_port}/"
    state = secrets.token_urlsafe(16)
    url = AUTH_URL + "?" + urllib.parse.urlencode({
        "client_id": args.client_id,
        "redirect_uri": redirect,
        "response_type": "code",
        "scope": SCOPE,
        "access_type": "offline",
        "prompt": "consent",
        "state": state,
    })

    print("AUTHORIZE_URL: " + url, flush=True)
    threading.Thread(target=srv.serve_forever, daemon=True).start()

    deadline = time.time() + args.timeout
    while "code" not in result and "error" not in result and time.time() < deadline:
        time.sleep(0.5)
    srv.shutdown()

    if result.get("state") != state and "code" in result:
        print("state mismatch -- aborting", file=sys.stderr)
        return 1
    if "code" not in result:
        print("no authorization code received: " + (result.get("error") or "timed out"),
              file=sys.stderr)
        return 1

    data = urllib.parse.urlencode({
        "code": result["code"],
        "client_id": args.client_id,
        "client_secret": args.client_secret,
        "redirect_uri": redirect,
        "grant_type": "authorization_code",
    }).encode()
    with urllib.request.urlopen(urllib.request.Request(TOKEN_URL, data=data), timeout=30) as resp:
        tok = json.load(resp)
    if "refresh_token" not in tok:
        print("no refresh_token returned; revoke the app at "
              "https://myaccount.google.com/permissions and retry", file=sys.stderr)
        return 1

    os.makedirs(os.path.dirname(CRED), mode=0o700, exist_ok=True)
    fd = os.open(CRED, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump({
            "client_id": args.client_id,
            "client_secret": args.client_secret,
            "refresh_token": tok["refresh_token"],
            "access_token": tok.get("access_token", ""),
            "expires_at": time.time() + int(tok.get("expires_in", 3600)),
        }, fh, indent=2)
    print("wrote " + CRED)
    return 0


if __name__ == "__main__":
    sys.exit(main())
