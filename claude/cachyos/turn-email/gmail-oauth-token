#!/usr/bin/env python3
"""msmtp passwordeval helper: print a live Gmail access token on stdout.

Credential file caches each token until 60 s before expiry; a lock file serializes refreshes → overlapping
sends share one refresh. Failure → empty stdout + nonzero exit → msmtp aborts that one send; the turn-email
mod logs it to ~/.claude/cache/turn-email.log, and the turn continues.
"""
import fcntl
import json
import os
import sys
import tempfile
import time
import urllib.parse
import urllib.request

CRED = os.path.expanduser(os.environ.get("CLAUDE_MAIL_CRED", "~/.config/claude-mail/oauth.json"))
TOKEN_URL = os.environ.get("CLAUDE_MAIL_TOKEN_URL", "https://oauth2.googleapis.com/token")


def load():
    with open(CRED) as fh:
        return json.load(fh)


def fresh(cred):
    return bool(cred.get("access_token")) and cred.get("expires_at", 0) - 60 > time.time()


def save(cred):
    # Private staging file (mkstemp = 0600) + atomic replace: a torn credential file would break
    # every later send, not just this one.
    fd, tmp = tempfile.mkstemp(prefix=".oauth-", dir=os.path.dirname(CRED) or ".")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(cred, fh, indent=2)
        os.replace(tmp, CRED)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def refresh(cred):
    data = urllib.parse.urlencode({
        "client_id": cred["client_id"],
        "client_secret": cred["client_secret"],
        "refresh_token": cred["refresh_token"],
        "grant_type": "refresh_token",
    }).encode()
    req = urllib.request.Request(TOKEN_URL, data=data)
    with urllib.request.urlopen(req, timeout=30) as resp:
        tok = json.load(resp)
    cred["access_token"] = tok["access_token"]
    cred["expires_at"] = time.time() + int(tok.get("expires_in", 3600))
    save(cred)
    return cred


def main():
    try:
        cred = load()
    except Exception as exc:  # noqa: BLE001
        print(f"gmail-oauth-token: cannot read {CRED}: {exc}", file=sys.stderr)
        return 1
    try:
        if not fresh(cred):
            # Waiters re-read after the lock: the holder's refresh serves them.
            with open(os.open(CRED + ".lock", os.O_WRONLY | os.O_CREAT, 0o600), "w") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                cred = load()
                if not fresh(cred):
                    cred = refresh(cred)
    except Exception as exc:  # noqa: BLE001
        print(f"gmail-oauth-token: refresh failed: {exc}", file=sys.stderr)
        return 1
    print(cred["access_token"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
