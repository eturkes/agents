    "defaultMode": "bypassPermissions"
  },
  "skillOverrides": {
    "claude-api": "off",
    "update-config": "off",
    "schedule": "off",
    "run": "off",
    "loop": "off",
    "verify": "off",
    "keybindings-help": "off",
    "code-review": "off",
    "fewer-permission-prompts": "off",
    "security-review": "off",
    "init": "off",
    "review": "off",
    "simplify": "off",
    "deep-research": "off",
    "dataviz": "off",
    "artifact-design": "off",
    "artifact-capabilities": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Agent|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/eturkes/.local/bin/tokensave",
            "args": [
              "hook-pre-tool-use"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/eturkes/.local/bin/tokensave",
            "args": [
              "hook-prompt-submit"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/eturkes/.local/bin/tokensave",
            "args": [
              "hook-stop"
            ]
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "xml-lsp@global": true,
    "prolog-lsp@global": true
  },
  "extraKnownMarketplaces": {
    "global": {
      "source": {
        "source": "directory",
        "path": "/home/eturkes/Projects/agents/claude/marketplace"
      }
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "preferredNotifChannel": "notifications_disabled",
  "switchModelsOnFlag": false,
  "teammateMode": "in-process",
  "remoteControlAtStartup": false,
  "useAutoModeDuringPlan": false
}
