# kk NAME WANT STATE [MARK KEPT AGO WORKING]: WANT = `[color]:text` of the keeper segment, `:` ⇒
# none, `last` gains the read's HH:MM; STATE = this session's entry state beside another session's
# entry | `-` ⇒ no entry of its own | `{…}` = the document verbatim | `off` ⇒ unreachable;
# MARK `-` ⇒ null; KEPT = kept_alive as JSON; AGO = s since the last cache read; WORKING = JSON.
kk() {
  n=$((n + 1)); now=$(date +%s); r=$((now - ${6:-0})); rm -f "$t/ka.json"
  case $3 in
    off) ;;
    \{*) printf '%s' "$3" > "$t/ka.json" ;;
    *) e=""; m=null; [ "${4:--}" = - ] || m="\"$4\""
       [ "$3" = - ] || e=$(printf ',{"session":"5e551011","state":"%s","mark":%s,"kept_alive":%s,"renewed":"%s","working":%s}' "$3" "$m" "${5:-0}" "$(date -u -d "@$r" +%Y-%m-%dT%H:%M:%SZ)" "${7:-false}")
       printf '{"interval":3300.0,"touches":19,"entries":[{"session":"0ther000","state":"armed","mark":"touch","kept_alive":3,"renewed":null,"working":true}%s]}' "$e" > "$t/ka.json" ;;
  esac
  out=$(printf '{"session_id":"5e551011-0000-4000-8000-000000000000","workspace":{"project_dir":"%s"},"context_window":{"total_input_tokens":1,"context_window_size":200000}}' "$t/k" | HOME=$t sh "$sl" 2>/dev/null)
  got=${out#* | } want=${2#*:}
  got=${got%no phase}
  [ "$want" = last ] && want="last $(date -d "@$r" +%H:%M)"
  [ -n "${2%%:*}" ] && want="${E}[${2%%:*}m$want${E}[0m"
  [ -n "$want" ] && want="$want | "
  [ "$got" = "$want" ] || { fail=$((fail + 1)); printf 'FAIL %s: want %s, got %s\n' "$1" "$want" "$got" | cat -v; }
  rm -f "$t/ka.json"
}
