kk touches-none '32:touches 0/19' armed touch 0 3000
kk touches-early '32:touches 12/19' armed touch 12
kk touches-late '33:touches 13/19' armed touch 13
kk touches-penultimate '33:touches 18/19' armed touch 18
kk touches-last '31:touches 19/19' armed stop 19
kk working ':in progress' armed touch 0 0 true
kk working-unstored ':in progress' ready - 0 0 true
kk ready-reported ':fresh session' ready - 0 0 false
kk working-after-touches ':in progress' armed touch 5 0 true
kk working-unarmed :compacted compacted - '"compacted"' 0 true
kk compacting :compacting compacting - 0
kk compacted :compacted compacted - '"compacted"'
kk stopped 31:stopped 'done' - 19
kk unknown-state : bogus
# Claude weekly = native rate_limits.seven_day → `claude N% MM/DD HH:MM` (reset > 15 h away ⇒ plain).
n=$((n + 1)); r=$(( $(date +%s) + 7 * 86400 ))
out=$(printf '{"workspace":{"project_dir":"%s"},"context_window":{"total_input_tokens":1,"context_window_size":200000},"rate_limits":{"seven_day":{"used_percentage":42,"resets_at":%s}}}' "$t/k" "$r" | HOME=$t sh "$sl" 2>/dev/null)
want="claude 42% $(date -d "@$r" +'%m/%d %H:%M')"
[ "${out##* | }" = "$want" ] || { fail=$((fail + 1)); printf 'FAIL claude-weekly: want %s, got %s\n' "$want" "${out##* | }" | cat -v; }
printf '%d/%d passed\n' $((n - fail)) "$n"
[ "$fail" -eq 0 ]
