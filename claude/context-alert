#!/bin/sh
# PostToolUse: emit one closure notice per tier/session. Usage sum = gauges.
# Tiers keep their distance from the compaction trigger at any window size:
# notice = window - 100K, final = window - 50K (1M ⇒ 900K/950K). Each notice
# computes live remainder; threshold jumps emit the highest crossed tier.
# Applicable standing instructions authorize limit-spanning work and override notice.
# Compaction = window - 33K; a 1M first-party MAIN is collapse-managed.
IN=""
[ -t 0 ] || IN=$(cat)   # hooks always pipe the payload; a bare terminal run exits quiet
{ read -r tp; read -r at; read -r sid; } <<EOF
$(printf '%s' "$IN" | jq -r '.transcript_path // "", .agent_type // "", .session_id // ""' 2>/dev/null)
EOF
[ -n "$tp" ] && [ -f "$tp" ] || exit 0

# One notice per session+tier. State keyed by session id; stale files reaped after 7d.
state_dir=$HOME/.claude/cache/context-alert
mkdir -p "$state_dir" 2>/dev/null || exit 0
find "$state_dir" -maxdepth 1 -type f -mtime +7 -delete 2>/dev/null

u=$(jq -n 'last(inputs|select(.type=="assistant" and .isSidechain!=true and .message.model!="<synthetic>" and (.message.usage|type)=="object")|.message.usage|.input_tokens+.cache_creation_input_tokens+.cache_read_input_tokens+.output_tokens)//empty' "$tp" 2>/dev/null)
[ -n "$u" ] || exit 0

# Raw window: MAIN = first-party 1M; a teammate's unknown model declares its own
# (200K when unset). ACW then clamps every model.
w=1000000
[ "$at" = main ] || [ -z "$at" ] || w=${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-200000}
acw=$CLAUDE_CODE_AUTO_COMPACT_WINDOW
[ "$acw" -gt 0 ] 2>/dev/null && [ "$acw" -lt "$w" ] && w=$acw
final=$((w - 50000))
# Ascending tiers; emit highest newly crossed tier after a jump.
if   [ "$u" -ge "$final" ];        then tier=final
elif [ "$u" -ge $((w - 100000)) ]; then tier=notice
else exit 0; fi
marker=$state_dir/${sid:-unknown}.$tier
[ -e "$marker" ] && exit 0
: > "$marker"

k=$((u / 1000)); left=$(( (w - u) / 1000 )); [ "$left" -lt 0 ] && left=0
wl=$((w / 1000))K; [ $((w % 1000000)) -eq 0 ] && wl=$((w / 1000000))M
if [ "$at" = "main" ] || [ -z "$at" ]; then
  case $tier in
    notice) msg="Hold scope fixed and steer toward closure: finish the current unit and verify it." ;;
    final)  msg="Close now: persist finished work and leave open threads where the next session picks them up." ;;
  esac
else
  case $tier in
    notice) msg="Hold scope fixed, finish and verify the current unit, then return your result." ;;
    final)  msg="Return your result now: compacting costs a turn and drops detail." ;;
  esac
fi

msg="Context ${k}K/${wl} — ${left}K left. ${msg} Standing instructions to work past the context limit override this notice."
jq -n --arg m "$msg" '{hookSpecificOutput:{hookEventName:"PostToolUse",additionalContext:$m}}'
