#!/bin/sh
# PostToolUse: one closure notice per agent + tier. Usage sum = gauges. Tiers sit
# at fixed offsets below the window ⇒ equal headroom at any window size.
IN=""
[ -t 0 ] || IN=$(cat)   # hooks always pipe the payload; a bare terminal run exits quiet
{ read -r tp; read -r sid; read -r aid; } <<EOF
$(printf '%s' "$IN" | jq -r '.transcript_path // "", .session_id // "", .agent_id // ""' 2>/dev/null)
EOF
# transcript_path = the session transcript in every payload; agent_id marks a
# teammate (agent_type also marks MAIN under --agent) → its own transcript.
if [ -n "$aid" ]; then
  for tp in "${tp%.jsonl}/subagents/agent-$aid.jsonl" \
            "${tp%.jsonl}"/subagents/workflows/*/"agent-$aid.jsonl"; do
    [ -f "$tp" ] && break
  done
fi
[ -f "$tp" ] || exit 0

# Streaming stubs carry no cache fields; a session file's sidechain records = subagent turns.
u=$(jq -n --arg aid "$aid" 'last(inputs|select(.type=="assistant" and ($aid!="" or .isSidechain!=true) and .message.model!="<synthetic>" and (.message.usage|type)=="object" and (.message.usage.cache_read_input_tokens|type)=="number")|.message.usage|.input_tokens+.cache_creation_input_tokens+.cache_read_input_tokens+.output_tokens)//empty' "$tp" 2>/dev/null)
[ -n "$u" ] || exit 0

# Raw window: MAIN = first-party 1M; a teammate's unknown model declares its own
# (200K when unset).
w=1000000
[ -z "$aid" ] || w=${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-200000}
acw=$CLAUDE_CODE_AUTO_COMPACT_WINDOW
if [ "$acw" -gt 0 ] 2>/dev/null; then
  [ "$acw" -lt "$w" ] && w=$acw
  t=$((w - 33000))  # enforcement follows ACW being set, not the clamp firing
elif [ -z "$aid" ]; then
  t=$w              # first-party MAIN, collapse-managed
else
  t=$((w - 33000))  # an unknown model self-enforces
fi
if   [ "$u" -ge $((w - 50000)) ];  then tier=final
elif [ "$u" -ge $((w - 100000)) ]; then tier=notice
else exit 0; fi

# Teammates share MAIN's session_id; set -C claims a tier once across parallel tool
# calls; final covers notice, so regrowth after compaction stays quiet.
state_dir=$HOME/.claude/cache/context-alert
mkdir -p "$state_dir" 2>/dev/null || exit 0
find "$state_dir" -maxdepth 1 -type f -mtime +7 -delete 2>/dev/null
key=$state_dir/${sid:-unknown}${aid:+.$aid}
[ -e "$key.final" ] && exit 0
(set -C; : > "$key.$tier") 2>/dev/null || exit 0

k=$((u / 1000)); left=$(( (t - u) / 1000 )); [ "$left" -lt 0 ] && left=0
tl=$((t / 1000))K; [ $((t % 1000000)) -eq 0 ] && tl=$((t / 1000000))M
if [ -z "$aid" ]; then
  case $tier in
    notice) msg="Checkpoint ahead of compaction: land the current unit on a commit with its checklist current (.agent/spec.md Tasks or .scratch/tasks.md), then continue." ;;
    final)  msg="Compaction is imminent: commit now with the checklist current; after compaction, reorient from the checklist + git log and continue." ;;
  esac
else
  case $tier in
    notice) msg="Hand off: bring your deliverable current on disk, then return its path, completion status + next action." ;;
    final)  msg="Compaction is imminent: save progress to your deliverable now, then return its path, completion status + next action." ;;
  esac
fi

msg="Context ${k}K/${tl} — ${left}K left. ${msg}"
jq -n --arg m "$msg" '{hookSpecificOutput:{hookEventName:"PostToolUse",additionalContext:$m}}'
