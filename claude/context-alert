#!/bin/sh
# PostToolUse hook → pushes the closure signal to the agent: ONE wrap-up notice per tier per session,
# freeing it to work until told. Same last-assistant-turn usage sum as the gauges; silent between tiers.
#
# Tiers, both contexts: 200K notice (40K of runway) → 220K final warning, bound 240K.
#   main session  ACW=273000 → auto-compaction at 240K (− 20K output reserve − 13K).
#   subagent      compaction-free → 240K = policy bound, clear of its 249K hard block.
IN=$(cat)
{ read -r tp; read -r at; read -r sid; } <<EOF
$(printf '%s' "$IN" | jq -r '.transcript_path // "", .agent_type // "", .session_id // ""' 2>/dev/null)
EOF
[ -n "$tp" ] && [ -f "$tp" ] || exit 0

# One notice per session+tier. State keyed by session id; stale files reaped after 7d.
state_dir=$HOME/.claude/cache/context-alert
mkdir -p "$state_dir" 2>/dev/null || exit 0
find "$state_dir" -maxdepth 1 -type f -mtime +7 -delete 2>/dev/null

u=$(jq -n 'last(inputs|select(.type=="assistant" and .isSidechain!=true and .message.model!="<synthetic>" and (.message.usage|type)=="object")|.message.usage|.input_tokens+.cache_creation_input_tokens+.cache_read_input_tokens+.output_tokens)//empty' "$tp" 2>/dev/null)
[ -n "$u" ] || exit 0

final=220000
# Tiers ascend; report the highest crossed that has yet to fire, so a jump past both lands on the higher.
if   [ "$u" -ge "$final" ]; then tier=final
elif [ "$u" -ge 200000 ];   then tier=200
else exit 0; fi
marker=$state_dir/${sid:-unknown}.$tier
[ -e "$marker" ] && exit 0
: > "$marker"

k=$((u / 1000))
if [ "$at" = "main" ] || [ -z "$at" ]; then
  case $tier in
    200)   msg="Context ${k}K/240K (~40K left, auto-compaction at 240K). Hold scope fixed and steer toward closure: finish the current unit, verify it, commit. The remaining room is ample — work through closure deliberately." ;;
    final) msg="Context ${k}K/240K (~20K left). Close now: commit finished work, and record open threads in the roadmap where the next session picks them up." ;;
  esac
else
  case $tier in
    200)   msg="Context ${k}K/240K (~40K left). Hold scope fixed, finish and verify the current unit, and return your result while the room lasts." ;;
    final) msg="Context ${k}K/240K (~20K left). Return your result now — work still held at 240K returns empty." ;;
  esac
fi

jq -n --arg m "$msg" '{hookSpecificOutput:{hookEventName:"PostToolUse",additionalContext:$m}}'
