#!/bin/sh
# PostToolUse: one 100%-usage alert per context/window: 5h, 7d all-models,
# or scoped weekly (`.limits[]`). Account-billed Claude contexts receive the
# relevant alert; scoped windows match named model. Refresh shared usage cache
# for tool-only runs. <100% = silent; 100% ⇒ stop until renewed credits.
uc="${OAUTH_USAGE_FILE:-$HOME/.claude/.oauth_usage.json}"

# Payload = session + agent + transcript; transcript supplies model below.
# Hook stdin carries payload; TTY invocation = manual limit check.
IN=""
[ -t 0 ] || IN=$(cat)
{ read -r sid; read -r aid; read -r tp; } <<EOF
$(printf '%s' "$IN" | jq -r '.session_id // "", .agent_id // "", .transcript_path // ""' 2>/dev/null)
EOF
date +%s >"$HOME/.claude/.oauth_limit_alert.stamp" 2>/dev/null   # liveness marker (last run epoch)
"${OAUTH_REFRESH_CMD:-$HOME/.claude/oauth-refresh}" "$uc"        # cache + poll shared with the statusline
[ -s "$uc" ] || exit 0

# Dedupe key = resets_at rounded to nearest hour; absorbs boundary jitter.
hkey='def hkey: try (.[0:19] | strptime("%Y-%m-%dT%H:%M:%S") | mktime
                     | (. + 1800) - ((. + 1800) % 3600)) catch 0;'

# >=100% precedence: 5h (soonest reset) > 7d > scoped weekly. Stage 1 =
# cache-only single jq; resolve model after a hot window. `WIN EPOCH` = key.
sel=$(jq -r "$hkey"'
  (.five_hour.utilization // 0) as $f | (.seven_day.utilization // 0) as $w |
  if   $f >= 100 and $f >= $w then "5h \(.five_hour.resets_at // "" | hkey)"
  elif $w >= 100              then "7d \(.seven_day.resets_at // "" | hkey)"
  elif any(.limits[]?; .kind == "weekly_scoped" and (.percent // 0) >= 100) then "SCOPED"
  else "" end' "$uc" 2>/dev/null)
[ -n "$sel" ] || exit 0

# Acting model source = calling-context transcript. Teammate path =
# <session>/subagents/agent-<agent_id>.jsonl beside MAIN transcript. Bounded tail
# fixes read cost; `fromjson?` tolerates severed first line; launch env covers
# pre-first-turn transcript.
f=$tp
[ -n "$aid" ] && f="${tp%.jsonl}/subagents/agent-$aid.jsonl"
mdl=""
[ -s "$f" ] && mdl=$(tail -c 262144 "$f" 2>/dev/null |
  jq -rR 'fromjson? | select(.type == "assistant") | .message.model // empty' 2>/dev/null |
  awk '$0 != "<synthetic>" { m = $0 } END { print m }')
[ -n "$mdl" ] || { [ -n "$aid" ] && mdl=$CLAUDE_CODE_SUBAGENT_MODEL || mdl=$ANTHROPIC_MODEL; }

# Billing filter: Claude + undetermined models receive account-wide alerts;
# other-provider models continue independently. Scoped windows require the named
# match below.
case "$mdl" in ""|*claude*) ;; *) exit 0 ;; esac

# Stage 2 = hottest scoped weekly window matching acting model. Surface scope
# binds current model. Match during scan preserves this model's alert despite a
# hotter peer window.
[ "$sel" = "SCOPED" ] && sel=$(jq -r --arg m "$mdl" "$hkey"'
  [ .limits[]?
    | select(.kind == "weekly_scoped" and (.percent // 0) >= 100)
    | ((.scope.model.display_name // .scope.model.id // .scope.surface // "scoped")
       | ascii_downcase | gsub(" "; "-")) as $k
    | select(.scope.model == null or ($m | ascii_downcase | contains($k)))
    | {k: $k, p: (.percent // 0), r: (.resets_at // "")} ]
  | max_by(.p) | if . == null then "" else "\(.k) \(.r | hkey)" end' "$uc" 2>/dev/null)
[ -n "$sel" ] || exit 0

# Marker per session+agent+window ⇒ each billed context sees alert once.
# Reap markers after 7d.
state_dir=${OAUTH_ALERT_STATE:-$HOME/.claude/cache/oauth-limit-alert}
mkdir -p "$state_dir" 2>/dev/null || exit 0
find "$state_dir" -maxdepth 1 -type f -mtime +7 -delete 2>/dev/null
marker=$state_dir/${sid:-unknown}${aid:+.$aid}.$(printf '%s' "$sel" | tr ' ' '.')
[ -e "$marker" ] && exit 0
: > "$marker"

win=${sel%% *}
msg="⚠ USAGE LIMIT at 100% (${win} window; usage credits now billing) → STOP NOW and \`TaskStop\` any running subagents. Leave work where it stands, even if incomplete."
jq -n --arg m "$msg" '{hookSpecificOutput:{hookEventName:"PostToolUse",additionalContext:$m}}'
