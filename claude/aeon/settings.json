{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "local-proxy",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "273000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "MCP_TIMEOUT": "60000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "273000",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "gpt-5.6-sol",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_CODE_NO_FLICKER": "0",
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(cat:*)",
      "Bash(bat:*)",
      "Bash(batcat:*)",
      "Bash(ccat:*)",
      "Bash(pygmentize:*)",
      "Bash(highlight:*)",
      "Bash(source-highlight:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(most:*)",
      "Bash(pg:*)",
      "Bash(nl:*)",
      "Bash(tac:*)",
      "Bash(rev:*)",
      "Bash(fold:*)",
      "Bash(pr:*)",
      "Bash(fmt:*)",
      "Bash(od:*)",
      "Bash(xxd:*)",
      "Bash(hexdump:*)",
      "Bash(hd:*)",
      "Bash(hexyl:*)",
      "Bash(strings:*)",
      "Bash(vi:*)",
      "Bash(vim:*)",
      "Bash(nvim:*)",
      "Bash(view:*)",
      "Bash(nano:*)",
      "Bash(emacs:*)",
      "Bash(ed:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "skillOverrides": {
    "claude-api": "off",
    "update-config": "off",
    "schedule": "off",
    "run": "off",
    "loop": "off",
    "verify": "off",
    "keybindings-help": "off",
    "code-review": "off",
    "fewer-permission-prompts": "off",
    "security-review": "off",
    "init": "off",
    "review": "off",
    "simplify": "off",
    "deep-research": "off",
    "dataviz": "off",
    "artifact-design": "off",
    "artifact-capabilities": "off",
    "design": "off",
    "prototype": "off",
    "workshop": "off",
    "artifact-components": "off",
    "commit": "off",
    "pr": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/quiet-bash",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/context-alert"
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "xml-lsp@global": true,
    "prolog-lsp@global": true
  },
  "extraKnownMarketplaces": {
    "global": {
      "source": {
        "source": "directory",
        "path": "/var/home/eturkes/debian/agents/claude/marketplace"
      }
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "preferredNotifChannel": "notifications_disabled",
  "switchModelsOnFlag": false,
  "fileCheckpointingEnabled": false,
  "teammateMode": "in-process",
  "remoteControlAtStartup": false,
  "useAutoModeDuringPlan": false,
  "crossSessionInbound": "accept"
}
