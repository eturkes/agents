{
  "cleanupPeriodDays": 365,
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_PROMPT_CACHE_TTL": "1h",
    "MCP_TIMEOUT": "60000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "1000000000",
    "CLAUDE_CODE_NO_FLICKER": "0",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1",
    "CLAUDE_CODE_ENABLE_EXPERIMENTAL_ADVISOR_TOOL": "1",
    "CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP": "1",
    "CLAUDE_CODE_DISABLE_AGENT_PROGRESS_SUMMARIES": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/context-alert:~/.claude/mods/agent-lanes:~/.claude/mods/agent-flow:~/.claude/mods/away",
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1",
    "CLAUDE_AGENT_LANES": "claude",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(bat:*)",
      "Bash(batcat:*)",
      "Bash(ccat:*)",
      "Bash(pygmentize:*)",
      "Bash(highlight:*)",
      "Bash(source-highlight:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(most:*)",
      "Bash(pg:*)",
      "Bash(vi:*)",
      "Bash(vim:*)",
      "Bash(nvim:*)",
      "Bash(view:*)",
      "Bash(nano:*)",
      "Bash(emacs:*)",
      "Bash(ed:*)",
      "WebFetch",
      "ScheduleWakeup"
    ],
    "defaultMode": "bypassPermissions"
  },
  "skillOverrides": {
    "claude-api": "off",
    "update-config": "off",
    "schedule": "off",
    "run": "off",
    "loop": "off",
    "verify": "off",
    "keybindings-help": "off",
    "code-review": "off",
    "fewer-permission-prompts": "off",
    "security-review": "off",
    "init": "off",
    "review": "off",
    "simplify": "off",
    "deep-research": "off",
    "dataviz": "off",
    "artifact-design": "off",
    "artifact-capabilities": "off",
    "design": "off",
    "prototype": "off",
    "workshop": "off",
    "artifact-components": "off",
    "commit": "off",
    "pr": "off",
    "plugin-authoring": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c 'if (.session_title // \"\") == \"\" then {hookSpecificOutput: {hookEventName: \"SessionStart\", sessionTitle: (.cwd | sub(\".*/(?=.)\"; \"\"))}} else empty end'"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c 'select(.permission_mode == \"bypassPermissions\") | {hookSpecificOutput: {hookEventName: \"PermissionRequest\", decision: {behavior: \"allow\"}}}'"
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "markdown-lsp@global": true,
    "r-lsp@global": true,
    "bash-lsp@global": true,
    "xml-lsp@global": true,
    "prolog-lsp@global": true
  },
  "extraKnownMarketplaces": {
    "global": {
      "source": {
        "source": "directory",
        "path": "/var/home/eturkes/debian/.local/app/agents/claude/marketplace"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official",
        "sparsePaths": [
          ".claude-plugin",
          "plugins/pyright-lsp",
          "plugins/typescript-lsp",
          "plugins/rust-analyzer-lsp"
        ]
      }
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md"
      }
    }
  },
  "timeFormat": "24-hour-utc",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "preferredNotifChannel": "notifications_disabled",
  "switchModelsOnFlag": true,
  "fileCheckpointingEnabled": false,
  "teammateMode": "in-process",
  "remoteControlAtStartup": false,
  "crossSessionInbound": "accept",
  "useAutoModeDuringPlan": false,
  "disableClaudeAiConnectors": true,
  "syncClaudeAiSkills": false
}
