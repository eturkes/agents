#!/bin/sh
# PreToolUse + Stop: second advisor beside the native advisor() (Fable, server-side).
# After an advisor() call of the current turn, MAIN's next tool call or turn end
# forks the session to gpt-6-astra and hands its verdict back before MAIN acts:
# the no-op Bash call `echo second-advisor` runs with the verdict attached
# (additionalContext); any other call is denied with it (re-issued once ruled);
# a turn end is blocked with it. Back-to-back advisor() calls = one review, of the
# latest.
#
# Blind by construction: the fork ends at the last chain entry before the call
# (--resume-session-at), so Fable's reply + MAIN's text after it stay out; Fable's
# reply also sits encrypted (advisor_redacted_result). MAIN's thinking reaches the
# transcript empty ⇒ MAIN's visible plan + doubt line ahead of the call is all
# astra learns of its reasoning. An empty thinking-only entry never ends the fork.
#
# Batch: PreToolUse fires per call, concurrently for concurrency-safe calls,
# serially otherwise, ~0.3 s before the batch's records land on disk. The claimer
# (atomic ln) records its batch = message.id + runs astra; siblings of that batch
# wait for its verdict + are held too, so no call of the batch runs on Fable's
# advice alone. A re-issue = a new message ⇒ passes; another batch or a later
# turn never waits on a claim.
#
# `astra-advisor rebut '<gist>'` (MAIN's Bash; session = $CLAUDE_CODE_SESSION_ID)
# = the one conferral round on a substantive disagreement: astra re-forks at the
# same cut with Fable's gist + its own earlier verdict.
#
# Fork = `claude -p --resume` + --fork-session --no-session-persistence: CC
# rebuilds system prompt, CLAUDE.md + history; no tools/MCP/hooks/advisor
# (disableAllHooks also keeps the fork off this hook + turn-email); MAIN's effort;
# context window lifted past the settings-env 305K teammate pin.
IN=""
# Hooks always pipe the payload; a bare terminal run exits quiet. rebut reads no
# stdin: the Bash tool's stays open + unwritten.
[ "${1-}" = rebut ] || [ -t 0 ] || IN=$(cat)
model=gpt-6-astra
state_dir=$HOME/.claude/cache/astra-advisor
settings='{"disableAllHooks":true,"advisorModel":"","env":{"CLAUDE_CODE_MAX_CONTEXT_TOKENS":"1000000"}}'
# A prompt opens a turn: human or queued; tool results, meta + compaction summaries excluded.
human='def human: .type == "user" and .isMeta != true and .isCompactSummary != true
  and ([.message.content | arrays | .[] | objects | select(.type == "tool_result")] | length == 0);'
rebut_line="On a substantive disagreement, run \`~/.claude/astra-advisor rebut '<the advisor gist + the open question>'\` once."

# Last MAIN advisor() result → "<line>\t<call id>". Raw unescaped quotes match JSON
# structure alone, never a quote inside a tool output string.
last_call() {
  command grep -n '"type":"advisor_tool_result"' "$1" | jq -R -r '
    index(":") as $i | .[:$i] as $n | (.[$i + 1:] | fromjson? // {}) as $r
    | select($r.type == "assistant" and $r.isSidechain != true)
    | $r.message.content[]? | objects | select(.type == "advisor_tool_result") | .tool_use_id | strings
    | "\($n)\t\(.)"' 2>/dev/null | tail -n 1
}

# Chain entry the fork ends at: the call's parent, past empty thinking-only entries.
cut_before() {
  jq -n -r --arg id "$2" '
    reduce (inputs | objects | select(.uuid | type == "string")) as $r ({m: {}, cut: null};
      .m[$r.uuid] = {p: $r.parentUuid,
        skip: ($r.type == "assistant" and ([$r.message.content[]? | objects | .type] | all(. == "thinking")))}
      | if $r.type == "assistant" and any($r.message.content[]? | objects; .type == "server_tool_use" and .id == $id)
        then .cut = $r.parentUuid else . end)
    | .m as $m | .cut
    | until(. == null or $m[.] == null or ($m[.].skip | not); $m[.].p) // empty' "$1" 2>/dev/null
}

# message.id of the assistant record carrying tool_use $2; empty until on disk.
batch_of() {
  case $2 in ''|*[!A-Za-z0-9_-]*) return 0 ;; esac
  command grep -F "\"id\":\"$2\"" "$1" | jq -r 'select(.type == "assistant") | .message.id | strings' 2>/dev/null | tail -n 1
}

effort_ok() { case $1 in low|medium|high|xhigh|max) printf '%s' "$1" ;; *) printf high ;; esac; }
effort_of() { effort_ok "$(tail -n 400 "$1" | jq -r 'select(.type == "assistant") | .effort // empty' 2>/dev/null | tail -n 1)"; }

# $1 session, $2 cwd, $3 effort, $4 cut, $5 prompt → verdict on stdout; empty = failure.
ask() {
  (cd "$2" 2>/dev/null || cd /
   timeout -k 10 540 claude -p --resume "$1" --resume-session-at "$4" --fork-session --no-session-persistence \
     --model "$model" --effort "$3" --strict-mcp-config --tools "" --settings "$settings" \
     --output-format json "$5" </dev/null 2>/dev/null) \
    | jq -r 'select(.is_error == false) | .result | strings' 2>/dev/null
}

if [ "${1-}" = rebut ]; then
  [ -n "${2-}" ] || { echo "Usage: astra-advisor rebut '<the advisor gist + the open question>'" >&2; exit 2; }
  sid=${CLAUDE_CODE_SESSION_ID-}
  for tp in "$HOME"/.claude/projects/*/"$sid".jsonl; do [ -f "$tp" ] && break; done
  [ -n "$sid" ] && [ -f "$tp" ] || { echo "astra-advisor: no transcript for session '$sid'" >&2; exit 1; }
  id=$(last_call "$tp" | cut -f2)
  cut=${id:+$(cut_before "$tp" "$id")}
  [ -n "$cut" ] || { echo "astra-advisor: no fork point before an advisor() call" >&2; exit 1; }
  earlier=$(cat "$state_dir/$id" 2>/dev/null)
  out=$(ask "$sid" "$PWD" "$(effort_of "$tp")" "$cut" "Second advisor, reconciliation round. Your earlier verdict:
${earlier:-(none recorded)}

The agent's other advisor disagrees:
$2

Use no tools. Reply in under 250 words: the points you concede, the points you hold and why, and the one check that decides each open disagreement.")
  [ -n "$out" ] || { echo "astra-advisor: $model returned no verdict" >&2; exit 1; }
  printf '%s\n' "$out"
  exit 0
fi

{ read -r ev; read -r tp; read -r sid; read -r aid; read -r cwd; read -r tid; read -r effort; read -r ping; } <<EOF
$(printf '%s' "$IN" | jq -r '.hook_event_name // "", .transcript_path // "", .session_id // "", .agent_id // "",
  .cwd // "", .tool_use_id // "", (.effort | if type == "object" then .level else . end // ""),
  (.tool_name == "Bash" and (.tool_input.command | strings | trim) == "echo second-advisor" | tostring)' 2>/dev/null)
EOF
lam=$(printf '%s' "$IN" | jq -r '.last_assistant_message // "" | strings' 2>/dev/null)
# Teammates share MAIN's transcript_path + carry agent_id; their advisor stub is dead.
# stop_hook_active gates nothing: the claim ends a Stop loop, while a new call made
# after a block still earns its review.
[ -z "$aid" ] && [ -n "$sid" ] && [ -f "$tp" ] || exit 0
case $ev in PreToolUse|Stop) ;; *) exit 0 ;; esac
# Advisor off → nothing to review; its advisor_tool attachment marks the session on.
command grep -q '"type":"advisor_tool"' "$tp" || exit 0
# Hooks fire ~0.3 s before CC flushes the current message ⇒ an advisor() call in it
# stays invisible until then. Wait (≤5 s) for the flush: PreToolUse = the call's own
# tool_use record; Stop = the final response's last text (after the last user record)
# ends last_assistant_message.
flushed() {
  case $ev in
    PreToolUse) [ -n "$(batch_of "$tp" "$tid")" ] ;;
    Stop) [ -z "$lam" ] || tail -n 200 "$tp" | jq -n -e --arg l "$lam" '
      reduce (inputs | objects) as $r (null; if $r.type == "user" then null elif $r.type == "assistant" then
        ([$r.message.content[]? | objects | select(.type == "text") | .text | strings | select(length > 0)] | last) // .
        else . end)
      | . as $t | $t != null and ($l | rtrim | endswith($t | rtrim))' >/dev/null 2>&1 ;;
  esac
}
i=0
until flushed || [ "$i" -ge 50 ]; do sleep 0.1; i=$((i + 1)); done
call=$(last_call "$tp")
[ -n "$call" ] || exit 0
line=${call%%"	"*}; id=${call#*"	"}
mkdir -p "$state_dir" 2>/dev/null || exit 0
claim=$state_dir/$id; done_f=$state_dir/$id.done
hold="Held with its batch for the second advisor; the verdict arrived on a sibling call. Re-issue this call if it still stands."

# A later prompt = an earlier turn's call: resumed history, or a call from before this hook.
tail -n +"$((line + 1))" "$tp" | jq -e -n "$human"'first(inputs | select(human))' >/dev/null 2>&1 && exit 0

own=$(batch_of "$tp" "$tid")
# Sibling: a live claimer of this batch (claim = its batch) → wait out its fork,
# then hold calls of the batch its verdict names (.done = batch; empty = none).
sibling() {
  [ "$ev" = PreToolUse ] && [ -n "$own" ] && [ "$ping" != true ] || exit 0
  if [ ! -e "$done_f" ]; then
    [ -n "$(find "$claim" -mmin -10 2>/dev/null)" ] && [ "$(cat "$claim" 2>/dev/null)" = "$own" ] ||
      [ -e "$done_f" ] || exit 0
    i=0
    while [ ! -e "$done_f" ] && [ "$i" -lt 560 ]; do sleep 1; i=$((i + 1)); done
  fi
  [ "$(cat "$done_f" 2>/dev/null)" = "$own" ] || exit 0
  jq -n --arg m "$hold" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$m}}'
  exit 0
}
[ -e "$claim" ] && sibling
# ln = atomic create-with-content: one claimer across parallel calls, and no sibling
# reads a claim before its batch lands. A failure keeps the claim.
printf '%s' "$own" > "$claim.$$" 2>/dev/null || exit 0
ln "$claim.$$" "$claim" 2>/dev/null; won=$?
rm -f "$claim.$$"
[ "$won" = 0 ] || sibling
find "$state_dir" -maxdepth 1 -type f -mtime +30 -delete 2>/dev/null

[ -n "$effort" ] && effort=$(effort_ok "$effort") || effort=$(effort_of "$tp")
cut=$(cut_before "$tp" "$id")   # none → no verdict; an uncut fork would show astra Fable's aftermath
out=""
[ -n "$cut" ] && out=$(ask "$sid" "${cwd:-$PWD}" "$effort" "$cut" "Second advisor: the transcript above ends where the agent called its advisor tool, another model; that call and its reply are cut off by design, so judge independently. Use no tools. Review the task, the evidence in the tool results, and the agent's latest stated plan and doubt. Reply in under 300 words: your verdict on the current direction; each error, risk or gap with its evidence (file:line, command output or transcript fact); the next step you recommend.")
# .done first: the claim names the batch until .done does.
b=""
[ -n "$out" ] && b=$own
printf '%s' "$b" > "$done_f.tmp" && mv -f "$done_f.tmp" "$done_f"
if [ -n "$out" ]; then printf '%s\n' "$out" > "$claim"; else : > "$claim"; fi

head="Second advisor ($model, blind to your advisor() reply) reviewed the session up to that call:
$out

Rule on each point where the two advisors disagree by your own check"
case $ev:${out:+ok}:$ping in
  PreToolUse:ok:true) jq -n --arg m "$head, then continue. $rebut_line" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",additionalContext:$m}}' ;;
  PreToolUse:ok:*) jq -n --arg m "$head, then re-issue this call if it still stands. $rebut_line Right after each advisor() call, run \`echo second-advisor\` alone: it returns this verdict without a refused call." \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$m}}' ;;
  Stop:ok:*) jq -n --arg m "$head, then finish. $rebut_line" '{decision:"block",reason:$m}' ;;
  PreToolUse::*) jq -n --arg m "Second advisor ($model) gave no verdict for this advisor() call; continue on the advisor() reply alone." \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",additionalContext:$m}}' ;;
  Stop::*) jq -n --arg m "Second advisor ($model) gave no verdict for the last advisor() call." '{systemMessage:$m}' ;;
esac
