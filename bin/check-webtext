#!/usr/bin/env python3
"""Check webtext type detection against local HTTP + file:// pages; needs trafilatura on PATH."""
import http.server
import os
import subprocess
import tempfile
import threading
import unittest
from pathlib import Path

PAGE = ("<!doctype html><html><head><title>Check</title></head><body><article><h1>Type check</h1>"
        + "<p>Webtext extracts this paragraph of plain prose for the type check.</p>" * 12
        + "</article></body></html>").encode()
SCRIPT = os.environ.get("WEBTEXT_SCRIPT", str(Path(__file__).with_name("webtext")))


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        types = {"/none": None, "/octet": "application/octet-stream", "/plain": "text/plain"}
        if types[self.path]:
            self.send_header("Content-Type", types[self.path])
        body = b"plain body\n" if self.path == "/plain" else PAGE
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format, *args):
        pass


class Types(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        threading.Thread(target=cls.server.serve_forever, daemon=True).start()
        cls.base = f"http://127.0.0.1:{cls.server.server_port}"

    @classmethod
    def tearDownClass(cls):
        cls.server.shutdown()
        cls.server.server_close()

    def run_webtext(self, url):
        return subprocess.run(["bash", SCRIPT, url], capture_output=True, text=True, timeout=60, check=False)

    def assert_page(self, url, kind):
        r = self.run_webtext(url)
        self.assertEqual(r.returncode, 0, r.stderr)
        self.assertIn("Webtext extracts this paragraph", r.stdout)
        self.assertIn(f"({kind})", r.stderr)

    def test_missing_type_sniffs_html(self):
        self.assert_page(f"{self.base}/none", "text/html")

    def test_octet_stream_sniffs_html(self):
        self.assert_page(f"{self.base}/octet", "text/html")

    def test_file_url_sniffs_html(self):
        with tempfile.NamedTemporaryFile(suffix=".html") as page:
            page.write(PAGE)
            page.flush()
            self.assert_page(Path(page.name).as_uri(), "text/html")

    def test_plain_text_prints_unchanged(self):
        r = self.run_webtext(f"{self.base}/plain")
        self.assertEqual((r.returncode, r.stdout), (0, "plain body\n"), r.stderr)


if __name__ == "__main__":
    unittest.main()
