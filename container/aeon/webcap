#!/usr/bin/env node
// Headless capture → PDF / PNG / DOM over CDP.
//
// Sole capture path here: Chrome's own switches (`--print-to-pdf`, `--dump-dom`,
// `--screenshot`) hang in the ChromiumFish build — page loads, browser stays
// live, the headless command handler never completes → rc=124, no artifact.
// CDP drives the same binary correctly → always capture through here.
//
// Rendering is sound: `--use-gl=angle --use-angle=swiftshader` (chromiumfish
// BASE_ARGS) rasterizes text + backgrounds. This build answers
// prefers-color-scheme light under CDP emulation + `--force-dark-mode` →
// `--dark` rewrites the page's own dark media blocks.
//
// Usage: webcap <url> [--pdf FILE] [--png FILE] [--dom FILE|-] [options]
//   --full-page        whole scroll height in PNG (PDF spans the document always)
//   --dark             render the page's prefers-color-scheme: dark styles
//   --width N          viewport width, default 1280
//   --height N         viewport height, default 800
//   --selector CSS     wait for this element before capture
//   --wait MS          settle delay after load, default 0
//   --timeout MS       navigation timeout, default 45000
//   --user-data-dir D  capture as this profile's user; runs against a copy of D
// Writes every requested artifact, prints one path per line.

import { spawnSync } from "node:child_process";
import { existsSync, mkdtempSync, readdirSync, realpathSync, rmSync, unlinkSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { pathToFileURL } from "node:url";

const FLAGS = new Set(["--full-page", "--dark"]);
const VALUED = new Set([
  "--pdf", "--png", "--dom", "--width", "--height",
  "--selector", "--wait", "--timeout", "--user-data-dir",
]);

function die(msg) {
  process.stderr.write(`webcap: ${msg}\n`);
  process.exit(1);
}

function parseArgs(argv) {
  const opts = { width: 1280, height: 800, wait: 0, timeout: 45000 };
  for (let i = 0; i < argv.length; i++) {
    let a = argv[i];
    let inline;
    if (a.startsWith("--") && a.includes("=")) {
      const eq = a.indexOf("=");
      inline = a.slice(eq + 1);
      a = a.slice(0, eq);
    }
    if (FLAGS.has(a)) {
      if (inline !== undefined) die(`${a} takes no value`);
      opts[a.slice(2)] = true;
    } else if (VALUED.has(a)) {
      const v = inline ?? argv[++i];
      if (v === undefined) die(`${a} needs a value`);
      opts[a.slice(2)] = v;
    } else if (a.startsWith("-")) die(`unknown option ${a}`);
    else if (opts.url) die("pass one url");
    else opts.url = a;
  }
  return opts;
}

// pnpm globals move between store versions; scan newest first so package
// upgrades keep resolving.
function resolveGlobal(pkg) {
  const globals = join(process.env.PNPM_HOME || join(homedir(), ".local/share/pnpm"), "global");
  if (!existsSync(globals)) die(`pnpm global store missing at ${globals}`);
  for (const dir of readdirSync(globals).sort((a, b) => Number(b) - Number(a))) {
    const entry = join(globals, dir, "node_modules", pkg);
    if (existsSync(entry)) return pathToFileURL(entry).href;
  }
  die(`${pkg} missing from ${globals}; run upgrade`);
}

const opts = parseArgs(process.argv.slice(2));
if (!opts.url) die("usage: webcap <url> [--pdf FILE] [--png FILE] [--dom FILE|-] [options]");
if (!opts.pdf && !opts.png && !opts.dom) die("choose at least one of --pdf, --png, --dom");

const { ChromiumFish, BASE_ARGS, binaryPath } = await import(`${resolveGlobal("chromiumfish")}/dist/index.js`);
const context = { viewport: { width: Number(opts.width), height: Number(opts.height) } };

// This build answers prefers-color-scheme light under CDP media emulation
// (newPage colorScheme + emulateMedia both report dark=false) → promote every
// dark media block to `all`. Dark blocks follow their light counterparts → the
// cascade already resolves in their favour. Cross-origin sheets deny cssRules
// → stay light. matchMedia keeps reporting light → pages theming off it rather
// than off the media query need their own switch.
function promoteDarkRules() {
  const walk = (rules) => {
    for (const rule of rules) {
      if (rule.media && /prefers-color-scheme\s*:\s*dark/i.test(rule.media.mediaText)) rule.media.mediaText = "all";
      if (rule.cssRules) walk(rule.cssRules);
    }
  };
  let reached = 0;
  for (const sheet of document.styleSheets) {
    try {
      walk(sheet.cssRules);
      reached++;
    } catch {
      // cross-origin
    }
  }
  return { sheets: document.styleSheets.length, reached };
}

// Capture needs a composited frame. Instant loads (file://, localhost above
// all) reach `load` before the compositor produces one → CDP answers "Unable
// to capture screenshot". Two animation frames put a real one in place. This
// script = the only capture route here → the guard stays unconditional.
function nextFrames() {
  return new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
}

let closable;
let page;

// The named profile stays read-only: capture runs against a copy. Any build
// opening the original garbage-collects the component extensions it does not
// itself provide → the owning browser loses extensions its Preferences still
// names. Copying also sheds ProcessSingleton → leave that browser running.
//
// `cp --reflink` shares extents: a 5GB profile copies in ~1.5s for no disk. It
// reflinks within one filesystem → the copy lands beside the original.
// Singleton* name the live instance's socket → a copy keeping them forwards
// the capture into that browser.
function cloneProfile(dir) {
  if (!existsSync(dir)) die(`no profile at ${dir}`);
  const source = realpathSync(dir);
  const copy = mkdtempSync(join(dirname(source), ".webcap-"));
  // Removal rides process exit, not the capture's `finally`: a `die` or launch
  // throw past this point leaves that block unreached → clones accumulate
  // beside the profile.
  process.on("exit", () => rmSync(copy, { recursive: true, force: true }));
  const cp = spawnSync("cp", ["-a", "--reflink=auto", `${source}/.`, copy], { encoding: "utf8" });
  if (cp.status !== 0) {
    rmSync(copy, { recursive: true, force: true });
    die(`cannot copy ${source}: ${cp.stderr?.trim() || cp.error?.message || `cp exited ${cp.status}`}`);
  }
  for (const entry of readdirSync(copy)) {
    if (entry.startsWith("Singleton")) unlinkSync(join(copy, entry));
  }
  return copy;
}

// Chrome deletes every cookie it fails to decrypt. playwright-core pins
// --password-store=basic into every launch on every platform beside
// --use-mock-keychain → a jar encrypted against the login keyring empties on
// open. A later --password-store wins on Chrome's last-duplicate rule → the
// cloned jar opens with the signed-in session intact. That pin = explicit
// switch, not a detector → no desktop-environment variable moves it.
const PERSISTENT_ARGS = [...BASE_ARGS, "--password-store=gnome-libsecret"];

if (opts["user-data-dir"]) {
  const scratch = cloneProfile(opts["user-data-dir"]);
  const pw = await import(`${resolveGlobal("playwright-core")}/index.mjs`);
  const chromium = pw.chromium ?? pw.default.chromium;
  closable = await chromium.launchPersistentContext(scratch, {
    executablePath: await binaryPath(),
    args: PERSISTENT_ARGS,
    headless: true,
    ...context,
  });
  page = closable.pages()[0] ?? (await closable.newPage());
} else {
  closable = await ChromiumFish({ headless: true });
  page = await closable.newPage(context);
}

let failure;
try {
  await page.goto(opts.url, { waitUntil: "load", timeout: Number(opts.timeout) });
  if (opts.selector) await page.waitForSelector(opts.selector, { timeout: Number(opts.timeout) });
  if (Number(opts.wait)) await page.waitForTimeout(Number(opts.wait));
  if (opts.dark) {
    const { sheets, reached } = await page.evaluate(promoteDarkRules);
    if (reached < sheets) process.stderr.write(`webcap: ${sheets - reached}/${sheets} stylesheets are cross-origin and stay light\n`);
  }
  await page.evaluate(nextFrames);

  if (opts.dom) {
    const html = await page.content();
    if (opts.dom === "-") process.stdout.write(html);
    else {
      writeFileSync(opts.dom, html);
      process.stdout.write(`${opts.dom}\n`);
    }
  }
  if (opts.png) {
    await page.screenshot({ path: opts.png, fullPage: Boolean(opts["full-page"]) });
    process.stdout.write(`${opts.png}\n`);
  }
  if (opts.pdf) {
    await page.pdf({ path: opts.pdf, printBackground: true });
    process.stdout.write(`${opts.pdf}\n`);
  }
} catch (e) {
  failure = e?.message || String(e);
} finally {
  await closable.close();
}
if (failure) die(failure);
