diff --git a/internal/translator/codex/claude/codex_claude_deferred_tools_test.go b/internal/translator/codex/claude/codex_claude_deferred_tools_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a7f8d8ca92269ffa3468ba39e0a0f13fb4727b0a
--- /dev/null
+++ b/internal/translator/codex/claude/codex_claude_deferred_tools_test.go
@@ -0,0 +1,208 @@
+package claude
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/MoeForge/moego/ojson"
+)
+
+const deferredToolsBase = `{
+	"model": "claude-opus-4-8",
+	"system": [{"type": "text", "text": "Be helpful"}],
+	"tools": [
+		{"name": "Read", "description": "Read a file", "input_schema": {"type": "object", "properties": {"path": {"type": "string"}}}},
+		{"name": "ToolSearch", "description": "Load deferred tools", "input_schema": {"type": "object", "properties": {"query": {"type": "string"}}}}
+		%s
+	],
+	"messages": [
+		{"role": "user", "content": [{"type": "text", "text": "Check the diagnostics"}]}
+		%s
+	]
+}`
+
+const (
+	deferredLSPTool = `{"name": "LSP", "description": "Code intelligence", "input_schema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "properties": {"operation": {"type": "string"}}}, "defer_loading": true}`
+	searchToolUse   = `{"role": "assistant", "content": [{"type": "tool_use", "id": "toolu_search", "name": "ToolSearch", "input": {"query": "select:LSP"}}]}`
+	searchResult    = `{"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_search", "content": [{"type": "tool_reference", "tool_name": "LSP"}]}]}`
+	lspToolUse      = `{"role": "assistant", "content": [{"type": "tool_use", "id": "toolu_lsp", "name": "LSP", "input": {"operation": "hover"}}]}`
+	lspResult       = `{"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_lsp", "content": "no diagnostics"}]}`
+)
+
+func deferredToolsRequest(extraTools string, messages ...string) []byte {
+	tools := ""
+	if extraTools != "" {
+		tools = "," + extraTools
+	}
+	history := ""
+	if len(messages) > 0 {
+		history = "," + strings.Join(messages, ",")
+	}
+	return []byte(strings.Replace(strings.Replace(deferredToolsBase, "%s", tools, 1), "%s", history, 1))
+}
+
+func translatedToolNames(t *testing.T, body ojson.Result) []string {
+	t.Helper()
+	var names []string
+	for _, tool := range body.Get("tools").Array() {
+		names = append(names, tool.Get("name").String())
+	}
+	return names
+}
+
+func TestConvertClaudeRequestToCodex_DeclaresDiscoveredToolAtReference(t *testing.T) {
+	result, err := ConvertClaudeRequestToCodex("gpt-6-luna", deferredToolsRequest(deferredLSPTool, searchToolUse, searchResult), true)
+	if err != nil {
+		t.Fatalf("translate: %v", err)
+	}
+	body := ojson.ParseBytes(result)
+
+	if got := strings.Join(translatedToolNames(t, body), ","); got != "Read,ToolSearch" {
+		t.Fatalf("top-level tools = %s, want Read,ToolSearch", got)
+	}
+	input := body.Get("input").Array()
+	var types []string
+	for _, item := range input {
+		types = append(types, item.Get("type").String())
+	}
+	if got := strings.Join(types, ","); got != "message,message,function_call,function_call_output,additional_tools" {
+		t.Fatalf("input types = %s", got)
+	}
+	added := input[4]
+	if added.Get("role").String() != "developer" {
+		t.Fatalf("additional_tools role = %q, want developer", added.Get("role").String())
+	}
+	tools := added.Get("tools").Array()
+	if len(tools) != 1 {
+		t.Fatalf("additional_tools tools = %s", added.Get("tools").Raw)
+	}
+	lsp := tools[0]
+	if lsp.Get("type").String() != "function" || lsp.Get("name").String() != "LSP" || lsp.Get("strict").Type != ojson.False {
+		t.Fatalf("declared tool = %s", lsp.Raw)
+	}
+	if lsp.Get("defer_loading").Exists() || lsp.Get("input_schema").Exists() || lsp.Get("parameters.$schema").Exists() {
+		t.Fatalf("declared tool kept Claude-only fields: %s", lsp.Raw)
+	}
+	if lsp.Get("parameters.properties.operation.type").String() != "string" {
+		t.Fatalf("declared tool parameters = %s", lsp.Get("parameters").Raw)
+	}
+}
+
+func TestConvertClaudeRequestToCodex_ToolDiscoveryKeepsPromptPrefix(t *testing.T) {
+	steps := [][]byte{
+		deferredToolsRequest(""),
+		deferredToolsRequest(deferredLSPTool, searchToolUse, searchResult),
+		deferredToolsRequest(deferredLSPTool, searchToolUse, searchResult, lspToolUse, lspResult),
+	}
+	var previous ojson.Result
+	for i, step := range steps {
+		result, err := ConvertClaudeRequestToCodex("gpt-6-luna", step, true)
+		if err != nil {
+			t.Fatalf("step %d: translate: %v", i, err)
+		}
+		body := ojson.ParseBytes(result)
+		if i > 0 {
+			if body.Get("tools").Raw != previous.Get("tools").Raw {
+				t.Fatalf("step %d: tools changed:\n%s\n%s", i, previous.Get("tools").Raw, body.Get("tools").Raw)
+			}
+			before, after := previous.Get("input").Array(), body.Get("input").Array()
+			if len(after) <= len(before) {
+				t.Fatalf("step %d: input did not grow", i)
+			}
+			for j := range before {
+				if before[j].Raw != after[j].Raw {
+					t.Fatalf("step %d: input[%d] changed:\n%s\n%s", i, j, before[j].Raw, after[j].Raw)
+				}
+			}
+		}
+		previous = body
+	}
+}
+
+func TestConvertClaudeRequestToCodex_UnreferencedDeferredToolStaysDeferred(t *testing.T) {
+	result, err := ConvertClaudeRequestToCodex("gpt-6-luna", deferredToolsRequest(deferredLSPTool), true)
+	if err != nil {
+		t.Fatalf("translate: %v", err)
+	}
+	body := ojson.ParseBytes(result)
+	if got := strings.Join(translatedToolNames(t, body), ","); got != "Read,ToolSearch" {
+		t.Fatalf("top-level tools = %s, want Read,ToolSearch", got)
+	}
+	if body.Get(`input.#(type=="additional_tools")`).Exists() {
+		t.Fatalf("unexpected additional_tools item: %s", body.Get("input").Raw)
+	}
+}
+
+func TestConvertClaudeRequestToCodex_RepeatedReferenceDeclaresToolOnce(t *testing.T) {
+	again := strings.NewReplacer("toolu_search", "toolu_search_again").Replace(searchToolUse)
+	againResult := strings.NewReplacer("toolu_search", "toolu_search_again").Replace(searchResult)
+	result, err := ConvertClaudeRequestToCodex("gpt-6-luna", deferredToolsRequest(deferredLSPTool, searchToolUse, searchResult, again, againResult), true)
+	if err != nil {
+		t.Fatalf("translate: %v", err)
+	}
+	input := ojson.ParseBytes(result).Get("input").Array()
+	count := 0
+	for i, item := range input {
+		if item.Get("type").String() == "additional_tools" {
+			count++
+			if prev := input[i-1]; prev.Get("call_id").String() != "toolu_search" {
+				t.Fatalf("additional_tools follows %s, want the first search result", prev.Raw)
+			}
+		}
+	}
+	if count != 1 {
+		t.Fatalf("additional_tools items = %d, want 1", count)
+	}
+}
+
+func TestConvertClaudeRequestToCodexWithCompat_DeclaresDeferredToolAtReference(t *testing.T) {
+	result, err := ConvertClaudeRequestToCodexWithCompat("gpt-6-luna", deferredToolsRequest(deferredLSPTool, searchToolUse, searchResult), true)
+	if err != nil {
+		t.Fatalf("translate: %v", err)
+	}
+	body := ojson.ParseBytes(result)
+	if got := strings.Join(translatedToolNames(t, body), ","); got != "Read,ToolSearch" {
+		t.Fatalf("top-level tools = %s, want Read,ToolSearch", got)
+	}
+	if !body.Get(`input.#(type=="additional_tools")`).Exists() {
+		t.Fatalf("compat discovery missing: %s", body.Get("input").Raw)
+	}
+}
+
+func TestConvertClaudeRequestToCodex_DiscoveredToolUsesShortenedName(t *testing.T) {
+	long := "mcp__browseros-neo-with-a-very-long-server-name__" + strings.Repeat("x", 40)
+	tool := strings.Replace(deferredLSPTool, `"LSP"`, `"`+long+`"`, 1)
+	search := strings.Replace(searchResult, `"LSP"`, `"`+long+`"`, 1)
+	call := strings.Replace(lspToolUse, `"LSP"`, `"`+long+`"`, 1)
+	result, err := ConvertClaudeRequestToCodex("gpt-6-luna", deferredToolsRequest(tool, searchToolUse, search, call, lspResult), true)
+	if err != nil {
+		t.Fatalf("translate: %v", err)
+	}
+	body := ojson.ParseBytes(result)
+	declared := body.Get(`input.#(type=="additional_tools").tools.0.name`).String()
+	called := body.Get(`input.#(call_id=="toolu_lsp").name`).String()
+	if declared == "" || len(declared) > 64 || declared != called {
+		t.Fatalf("declared name %q, called name %q", declared, called)
+	}
+}
+
+func TestConvertClaudeRequestToCodex_ToolUsedBeforeReferenceDeclaresOnRediscovery(t *testing.T) {
+	// Retained reference absent → deferred; rediscovery → one declaration at the retained reference.
+	before, err := ConvertClaudeRequestToCodex("gpt-6-luna", deferredToolsRequest(deferredLSPTool, lspToolUse, lspResult), true)
+	if err != nil {
+		t.Fatalf("translate: %v", err)
+	}
+	after, err := ConvertClaudeRequestToCodex("gpt-6-luna", deferredToolsRequest(deferredLSPTool, lspToolUse, lspResult, searchToolUse, searchResult), true)
+	if err != nil {
+		t.Fatalf("translate: %v", err)
+	}
+	if got := strings.Join(translatedToolNames(t, ojson.ParseBytes(after)), ","); got != "Read,ToolSearch" {
+		t.Fatalf("top-level tools = %s, want Read,ToolSearch", got)
+	}
+	if ojson.GetBytes(before, "tools").Raw != ojson.GetBytes(after, "tools").Raw {
+		t.Fatalf("tools changed on rediscovery")
+	}
+	if !ojson.GetBytes(after, `input.#(type=="additional_tools")`).Exists() {
+		t.Fatalf("rediscovered tool declaration missing: %s", ojson.GetBytes(after, "input").Raw)
+	}
+}
