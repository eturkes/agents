@@ -78,3 +79,29 @@ func TestCodexExecutorCountTokensPreservesToolNumberSchemas(t *testing.T) {
 		}
 	}
 }
+
+func TestCountCodexInputTokensCountsAdditionalTools(t *testing.T) {
+	enc, errEnc := tokenizer.Get(tokenizer.Cl100kBase)
+	if errEnc != nil {
+		t.Fatalf("tokenizer: %v", errEnc)
+	}
+	tool := `{"type":"function","name":"LSP","description":"Code intelligence for hover, definitions and references","parameters":{"type":"object","properties":{"operation":{"type":"string"}}}}`
+	message := `{"type":"message","role":"user","content":[{"type":"input_text","text":"Check the diagnostics"}]}`
+	topLevel := []byte(`{"input":[` + message + `],"tools":[` + tool + `]}`)
+	declared := []byte(`{"input":[` + message + `,{"type":"additional_tools","role":"developer","tools":[` + tool + `]}],"tools":[]}`)
+	bare := []byte(`{"input":[` + message + `],"tools":[]}`)
+
+	count := func(body []byte) int64 {
+		n, err := countCodexInputTokens(enc, body)
+		if err != nil {
+			t.Fatalf("countCodexInputTokens: %v", err)
+		}
+		return n
+	}
+	if got, want := count(declared), count(topLevel); got != want {
+		t.Fatalf("additional_tools count = %d, top-level count = %d", got, want)
+	}
+	if count(declared) <= count(bare) {
+		t.Fatalf("additional_tools tools were not counted")
+	}
+}
diff --git a/internal/runtime/executor/helps/codex_tool_schema.go b/internal/runtime/executor/helps/codex_tool_schema.go
index d97e5e516097a822a57bf9012f527682afdf183e..34fba85cba52e810009c49d7974cc605aa67812c 100644
--- a/internal/runtime/executor/helps/codex_tool_schema.go
+++ b/internal/runtime/executor/helps/codex_tool_schema.go
@@ -54,12 +54,28 @@ func NormalizeCodexToolSchemas(body []byte) []byte {
 	if len(body) == 0 {
 		return body
 	}
-	updatedTools, changed := normalizeCodexToolList(gjson.GetBytes(body, "tools"))
-	if !changed {
-		return body
+	out, changedAny := body, false
+	if updatedTools, changed := normalizeCodexToolList(gjson.GetBytes(body, "tools")); changed {
+		if updated, errSet := sjson.SetRawBytes(out, "tools", updatedTools); errSet == nil {
+			out, changedAny = updated, true
+		}
 	}
-	out, errSet := sjson.SetRawBytes(body, "tools", updatedTools)
