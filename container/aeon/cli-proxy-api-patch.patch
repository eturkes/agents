+func TestNormalizeCodexToolSchemas_AdditionalToolsDeclarations(t *testing.T) {
+	tool := `{"type":"function","name":"Lookup","parameters":{"type":"object","properties":{"n":{"type":"integer","maximum":18446744073709551615}}}}`
+	body := []byte(`{"tools":[` + tool + `],"input":[{"type":"message","role":"user","content":[{"type":"input_text","text":"hi"}]},{"type":"additional_tools","role":"developer","tools":[` + tool + `]}]}`)
