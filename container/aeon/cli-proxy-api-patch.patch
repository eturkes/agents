+		t.Fatalf("top-level tools = %s, want Read,ToolSearch,LSP", got)
+	}
+	if gjson.GetBytes(before, "tools").Raw != gjson.GetBytes(after, "tools").Raw {
+		t.Fatalf("tools changed on rediscovery")
+	}
+	if gjson.GetBytes(after, `input.#(type=="additional_tools")`).Exists() {
+		t.Fatalf("rediscovered tool declared again: %s", gjson.GetBytes(after, "input").Raw)
+	}
