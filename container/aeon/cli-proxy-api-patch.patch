diff --git a/internal/runtime/executor/codex_executor_additional_tools_test.go b/internal/runtime/executor/codex_executor_additional_tools_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..86a31ecfbf4766ecb97522f315a8a494a146d270
--- /dev/null
+++ b/internal/runtime/executor/codex_executor_additional_tools_test.go
@@ -0,0 +1,29 @@
+package executor
+
+import (
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+const codexAdditionalImageFunction = `{"type":"function","name":"image_gen.imagegen","parameters":{"type":"object","properties":{}}}`
+
+func TestEnsureImageGenerationToolSeesAdditionalToolsDeclaration(t *testing.T) {
+	body := []byte(`{"tools":[{"type":"function","name":"Read","parameters":{"type":"object","properties":{}}}],"input":[{"type":"additional_tools","role":"developer","tools":[` + codexAdditionalImageFunction + `]}]}`)
+	out := ensureImageGenerationTool(body, "gpt-6-luna", nil, nil)
+	if gjson.GetBytes(out, `tools.#(type=="image_generation")`).Exists() {
+		t.Fatalf("image_generation injected despite an additional_tools image function: %s", out)
+	}
+}
+
+func TestNormalizeCodexParallelToolCallsKeepsFieldForAdditionalTools(t *testing.T) {
+	body := []byte(`{"parallel_tool_calls":false,"tools":[],"input":[{"type":"additional_tools","role":"developer","tools":[{"type":"function","name":"Lookup","parameters":{"type":"object","properties":{}}}]}]}`)
+	out := normalizeCodexParallelToolCallsForTools(body)
+	if got := gjson.GetBytes(out, "parallel_tool_calls"); !got.Exists() || got.Bool() {
+		t.Fatalf("parallel_tool_calls = %s, want false", got.Raw)
+	}
+	bare := normalizeCodexParallelToolCallsForTools([]byte(`{"parallel_tool_calls":false,"tools":[],"input":[]}`))
+	if gjson.GetBytes(bare, "parallel_tool_calls").Exists() {
+		t.Fatalf("parallel_tool_calls kept without any tools: %s", bare)
+	}
+}
diff --git a/internal/runtime/executor/codex_executor_request.go b/internal/runtime/executor/codex_executor_request.go
index 3f9bb2d9c18eaa95956a5fbf04f37f73a7452f36..6857dd51b8668e60217931537000c6b5e2180809 100644
--- a/internal/runtime/executor/codex_executor_request.go
+++ b/internal/runtime/executor/codex_executor_request.go
@@ -688,6 +688,11 @@ func ensureImageGenerationTool(body []byte, baseModel string, auth *cliproxyauth
 		return body
 	}
 
+	for _, t := range codexAdditionalToolDeclarations(body) {
+		if t.Get("type").String() == "image_generation" || isImageGenerationFunctionTool(t) {
+			return body
+		}
+	}
 	tools := gjson.GetBytes(body, "tools")
 	if !tools.Exists() || !tools.IsArray() {
 		body, _ = sjson.SetRawBytes(body, "tools", imageGenToolArrayJSON)
@@ -702,6 +707,20 @@ func ensureImageGenerationTool(body []byte, baseModel string, auth *cliproxyauth
 	return body
 }
 
+func codexAdditionalToolDeclarations(body []byte) []gjson.Result {
+	if !bytes.Contains(body, []byte(`"additional_tools"`)) {
+		return nil
+	}
+	var tools []gjson.Result
+	gjson.GetBytes(body, "input").ForEach(func(_, item gjson.Result) bool {
+		if item.Get("type").String() == "additional_tools" {
+			tools = append(tools, item.Get("tools").Array()...)
+		}
+		return true
+	})
+	return tools
+}
+
 func normalizeCodexParallelToolCalls(body []byte, headers http.Header) []byte {
 	if util.IsCodexResponsesLiteRequest(body, headers) {
 		body = helps.SetBoolIfDifferent(body, "parallel_tool_calls", false)
@@ -717,7 +736,7 @@ func normalizeCodexParallelToolCallsForTools(body []byte) []byte {
 
 	tools := gjson.GetBytes(body, "tools")
 	hasTools := tools.Exists() && tools.IsArray() && len(tools.Array()) > 0
-	if hasTools {
+	if hasTools || len(codexAdditionalToolDeclarations(body)) > 0 {
 		return body
 	}
 
