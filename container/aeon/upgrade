#!/usr/bin/env bash
set -euo pipefail

# Upgrade run for the Debian container on Aeon; counterpart = host/cachyos/upgrade.
#
# Every toolchain here arrived through its own installer → this script drives
# that list of self-updaters (rustup, uv, corepack, elan, moon, ...) to their
# latest upstream release. apt packages upgrade out of band by hand.

# Make pnpm globals reachable when this script runs outside an interactive shell.
export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# --- Rust: rustup, toolchains, and cargo-installed CLIs ---
# Update rustup itself, all installed Rust toolchains, and cargo binaries tracked
# by cargo-install-update.
rustup self update
rustup update
cargo install-update -a

# --- Python: uv and uv-managed tools ---
# headroom-ai path-pins the locally built wheel in ~/src/headroom/dist
# (image-worker termination fix): `upgrade --all` re-resolves that same path →
# the pin holds + the wheel must stay on disk. Once an upstream release ships
# the fix, return headroom to PyPI:
#   uv tool install --force --python 3.14.5 "headroom-ai[all]"
# Details: ~/agents/container/aeon/headroom/README.md
uv self update
PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1 uv tool upgrade --all

# A resident uvx tool (Serena MCP while a Claude session is open) holds the uv
# cache lock → `uv cache prune` waits on it forever. Cap the wait + skip the
# prune to keep the run moving.
timeout 30 uv cache prune || echo "uv cache in use (resident uvx tool); prune skipped"

# --- Node: Corepack and pnpm globals ---
# pnpm is Corepack-managed; stay on latest v10 while this container uses Node 20.
corepack install -g pnpm@latest-10

# npm is required by Serena's LSP installer, which shells out to `npm install`.
# It lives as a pnpm global, so upgrade it explicitly.
pnpm add -g npm@latest

# --- ChromiumFish ---
# Upgrade the pnpm globals, then fetch the browser build the upgraded package
# names. Upstream Linux archives omit chrome_crashpad_handler + the fetcher
# accepts them, checking the main chrome binary alone. The browser posix_spawns
# that handler at startup → it must be present, or every headless run aborts at
# launch. Repair the cache in place from Chrome for Testing: same
# MAJOR.MINOR.BUILD = the crashpad revision this browser expects. The cache
# persists → one download per browser-version bump.
pnpm add -g chromiumfish@latest playwright-core@latest
chromiumfish fetch
chromiumfish_dir="$(dirname "$(chromiumfish path)")"
if [[ ! -x "$chromiumfish_dir/chrome_crashpad_handler" ]]; then
  browser_version="$(chromiumfish --version | sed -n 's/.*browser \([^)]*\)).*/\1/p')"
  cft_json="$(curl -fsSL https://googlechromelabs.github.io/chrome-for-testing/latest-patch-versions-per-build-with-downloads.json)"
  cft_version="$(jq -r --arg build "${browser_version%.*}" '.builds[$build].version // empty' <<<"$cft_json")"
  cft_url="$(jq -r --arg build "${browser_version%.*}" '.builds[$build].downloads.chrome[]? | select(.platform == "linux64") | .url' <<<"$cft_json")"
  if [[ -z "$cft_url" ]]; then
    echo "chromiumfish cache $chromiumfish_dir needs chrome_crashpad_handler; no Chrome for Testing linux64 build matches ${browser_version:-unknown} -- install one by hand before headless use" >&2
    exit 1
  fi
  cft_tmp="$(mktemp -d)"
  curl -fsSL -o "$cft_tmp/chrome-linux64.zip" "$cft_url"
  unzip -q -o -j "$cft_tmp/chrome-linux64.zip" chrome-linux64/chrome_crashpad_handler -d "$cft_tmp"
  install -m 0755 "$cft_tmp/chrome_crashpad_handler" "$chromiumfish_dir/chrome_crashpad_handler"
  rm -rf "$cft_tmp"
  echo "chromiumfish $browser_version: installed chrome_crashpad_handler from Chrome for Testing $cft_version"
fi

# Always verify size + a real run: an existence check passes a corrupt copy that
# still kills the browser at launch. Truncated + non-ELF handlers fail the run
# (SIGSEGV, command not found); a zero-byte one needs the size test, since bash
# runs it as an empty script + reports success.
if [[ ! -s "$chromiumfish_dir/chrome_crashpad_handler" ]] ||
   ! "$chromiumfish_dir/chrome_crashpad_handler" --help >/dev/null 2>&1; then
  echo "chromiumfish cache $chromiumfish_dir has an unrunnable chrome_crashpad_handler; replace it before headless use" >&2
  exit 1
fi

# Drop unreachable package-store files after global updates.
pnpm store prune

# --- Lean: elan and stable toolchain ---
# Update elan itself, then ensure stable is installed/current.
elan self update

# 'elan toolchain install' exits non-zero when 'stable' already resolves to the
# newest installed release; ignore just that so 'set -e' doesn't abort the run.
out="$(elan toolchain install stable 2>&1)" && rc=0 || rc=$?
printf '%s\n' "$out"
[[ $rc -eq 0 || "$out" == *"already installed"* ]] || exit "$rc"

# --- MoonBit: moon toolchain + registry index ---
# ~/.moon = user-global, shared by every project → keep it current here.
# `moon upgrade` = its installer-based self-updater. MoonBit also caches a
# persistent local package index (git repo under ~/.moon/registry/index) →
# `moon update` refreshes that index + the symbol index for all projects, the
# way `apt update` refreshes APT's. `moon` resolves per-project .mooncakes
# inside each project.
moon_home="${MOON_HOME:-$HOME/.moon}"
case ":$PATH:" in
  *":$moon_home/bin:"*) ;;
  *) export PATH="$moon_home/bin:$PATH" ;;
esac

if [[ -t 0 ]]; then
  moon upgrade
else
  # Recent `moon upgrade` prompts via the terminal and exits with
  # "not a terminal" without a pty. Feed the normal confirmation through one.
  printf 'y\n' | script -qefc 'moon upgrade' /dev/null
fi
moon update

# --- SWI-Prolog packs ---
# The interpreter + its built-in `pack` manager (library(prolog_pack)) ship in
# Debian's swi-prolog-* apt packages, upgraded out of band → this script
# refreshes globally installed packs. upgrade-servers owns lsp_server: it tracks
# the default branch + gates on an LSP handshake, while upstream's newest TAG
# still regresses initialize for utf-16 clients → a plain pack upgrade here
# would resolve backwards into the broken release. The pack list is computed at
# runtime → later additions upgrade automatically; the per-pack catch keeps one
# failing upgrade from aborting the run.
swipl -q -g 'use_module(library(prolog_pack)), Pinned = [lsp_server], findall(P, (pack_property(P, version(_)), \+ memberchk(P, Pinned)), Ps), forall(member(P, Ps), catch(pack_install(P, [upgrade(true), interactive(false)]), E, print_message(warning, E))), halt' -t 'halt(1)'

# --- Marketplace LSP servers ---
# lemminx + prolog-lsp have no package manager behind them → they move only
# here. Each goes to its latest upstream release, verified with a real LSP
# handshake + rolled back on failure, so latest is taken on evidence. Version
# numbers live nowhere: the handshake is the gate. `|| true` keeps a rolled-back
# upgrade (exit 1) or an upstream outage (exit 2) from aborting the run.
if [[ -x "$HOME/agents/claude/marketplace/upgrade-servers" ]]; then
  "$HOME/agents/claude/marketplace/upgrade-servers" || true
fi

# --- Codex CLI ---
# Use Codex's own updater for the CLI.
codex update

# --- CLIProxyAPI ---
curl -fsSL https://raw.githubusercontent.com/router-for-me/cliproxyapi-installer/refs/heads/master/cliproxyapi-installer | bash -s -- upgrade

# --- Docs mirror: agentlanguages.dev/llms.txt ---
# Refresh the local copy every run. It stays git-ignored (see .gitignore) since
# this fetch can always re-create it. Download to a temp file, then move it into
# place → an interrupted fetch leaves the existing copy intact. A fetch failure
# warns + keeps the current copy.
agentlang_doc="$HOME/agents/docs/agentlanguages.dev/llms.txt"
agentlang_tmp="$(mktemp)"
mkdir -p "$(dirname "$agentlang_doc")"
if curl -fsSL -o "$agentlang_tmp" https://agentlanguages.dev/llms.txt; then
  mv "$agentlang_tmp" "$agentlang_doc"
  echo "agentlanguages.dev/llms.txt updated"
else
  rm -f "$agentlang_tmp"
  echo "agentlanguages.dev/llms.txt fetch failed; keeping existing copy" >&2
fi
# docs/scopedcommits.com/llms.txt stays hand-maintained: the live site publishes
# no llms.txt, so the repo's tracked copy is the original rather than a mirror.
# A fetch here would overwrite it with a 404.
