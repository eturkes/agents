#!/usr/bin/env bash
set -euo pipefail

# Aeon Debian: latest user toolchains; host counterpart = host/cachyos/upgrade.
# apt upgrades = manual.

# Noninteractive callers need global bins on PATH.
export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# --- Rust: rustup, toolchains, and cargo-installed CLIs ---
rustup self update
rustup update
cargo install-update -a

# --- Python: uv and uv-managed tools ---
# headroom-ai = local wheel pin → the wheel stays on disk; pin lifecycle: ~/agents/container/aeon/headroom/README.md
uv self update
PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1 uv tool upgrade --all

# A resident uvx holds the cache lock → `uv cache prune` would wait forever; cap it at 30s.
timeout 30 uv cache prune || echo "uv cache in use (resident uvx tool); prune skipped"

# --- Node: pnpm + globals ---
# Native pnpm = Node-independent.
# Project pins govern -g too → use HOME for user-global updates.
pnpm --dir "$HOME" self-update

# npm lives as a pnpm global, so upgrade it explicitly.
pnpm --dir "$HOME" add -g npm@latest

# --- ChromiumFish ---
# Upstream Linux archives omit chrome_crashpad_handler (the fetcher checks chrome
# alone); the browser spawns it at startup → repair the cache from Chrome for
# Testing at the same MAJOR.MINOR.BUILD = its crashpad revision. The cache
# persists → one download per browser-version bump.
pnpm --dir "$HOME" add -g chromiumfish@latest playwright-core@latest
chromiumfish fetch
chromiumfish_dir="$(dirname "$(chromiumfish path)")"
if [[ ! -x "$chromiumfish_dir/chrome_crashpad_handler" ]]; then
  browser_version="$(chromiumfish --version | sed -n 's/.*browser \([^)]*\)).*/\1/p')"
  cft_json="$(curl -fsSL https://googlechromelabs.github.io/chrome-for-testing/latest-patch-versions-per-build-with-downloads.json)"
  cft_version="$(jq -r --arg build "${browser_version%.*}" '.builds[$build].version // empty' <<<"$cft_json")"
  cft_url="$(jq -r --arg build "${browser_version%.*}" '.builds[$build].downloads.chrome[]? | select(.platform == "linux64") | .url' <<<"$cft_json")"
  if [[ -z "$cft_url" ]]; then
    echo "The chromiumfish cache $chromiumfish_dir lacks chrome_crashpad_handler. No Chrome for Testing linux64 build matches ${browser_version:-unknown}. Install a matching handler by hand before headless use." >&2
    exit 1
  fi
  cft_tmp="$(mktemp -d)"
  curl -fsSL -o "$cft_tmp/chrome-linux64.zip" "$cft_url"
  unzip -q -o -j "$cft_tmp/chrome-linux64.zip" chrome-linux64/chrome_crashpad_handler -d "$cft_tmp"
  install -m 0755 "$cft_tmp/chrome_crashpad_handler" "$chromiumfish_dir/chrome_crashpad_handler"
  rm -rf "$cft_tmp"
  echo "chromiumfish $browser_version: installed chrome_crashpad_handler from Chrome for Testing $cft_version"
fi

# Gate = nonzero size + a real `--help` run: an existence check passes a corrupt
# copy that kills the browser at launch; a zero-byte file runs as an empty script + exits 0.
if [[ ! -s "$chromiumfish_dir/chrome_crashpad_handler" ]] ||
   ! "$chromiumfish_dir/chrome_crashpad_handler" --help >/dev/null 2>&1; then
  echo "chromiumfish cache $chromiumfish_dir has an unrunnable chrome_crashpad_handler; replace it before headless use" >&2
  exit 1
fi

pnpm --dir "$HOME" store prune

# --- Lean: elan and stable toolchain ---
elan self update

# 'elan toolchain install' exits non-zero when 'stable' already resolves to the
# newest installed release; ignore just that so 'set -e' doesn't abort the run.
out="$(elan toolchain install stable 2>&1)" && rc=0 || rc=$?
printf '%s\n' "$out"
[[ $rc -eq 0 || "$out" == *"already installed"* ]] || exit "$rc"

# --- MoonBit: moon toolchain + registry index ---
# ~/.moon = user-global toolchain; `moon upgrade` = its self-updater; `moon update`
# refreshes the shared package + symbol index. Projects resolve .mooncakes locally.
moon_home="${MOON_HOME:-$HOME/.moon}"
case ":$PATH:" in
  *":$moon_home/bin:"*) ;;
  *) export PATH="$moon_home/bin:$PATH" ;;
esac

if [[ -t 0 ]]; then
  moon upgrade
else
  # `moon upgrade` confirms through the terminal ("not a terminal" otherwise) → feed it a pty.
  printf 'y\n' | script -qefc 'moon upgrade' /dev/null
fi
moon update

# --- SWI-Prolog packs ---
# apt owns swipl + library(prolog_pack); this refreshes user-global packs.
# lsp_server = upgrade-servers' default-branch pin (the newest tag breaks UTF-16
# initialize) → excluded here. Pack list = computed at run time; the per-pack
# catch isolates failures.
swipl -q -g 'use_module(library(prolog_pack)), Pinned = [lsp_server], findall(P, (pack_property(P, version(_)), \+ memberchk(P, Pinned)), Ps), forall(member(P, Ps), catch(pack_install(P, [upgrade(true), interactive(false)]), E, print_message(warning, E))), halt' -t 'halt(1)'

# --- Marketplace LSP servers ---
# lemminx + prolog-lsp move only here: upgrade-servers installs the Maven release /
# the Prolog default-branch HEAD, gates each on an LSP handshake + restores a prior
# install where one exists. `|| true` keeps a failed upgrade (1) or an upstream
# outage (2) from aborting the run.
if [[ -x "$HOME/agents/claude/marketplace/upgrade-servers" ]]; then
  "$HOME/agents/claude/marketplace/upgrade-servers" || true
fi

# --- Codex CLI ---
codex update

# --- Codexify: installation health + release status ---
codexify doctor

# --- CLIProxyAPI ---
curl -fsSL https://raw.githubusercontent.com/router-for-me/cliproxyapi-installer/refs/heads/master/cliproxyapi-installer | bash -s -- upgrade

