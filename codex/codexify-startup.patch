+    #[test]
+    fn startup_project_doc_is_opt_in_and_reread() {
+        let root = tempfile::tempdir().unwrap();
+        let instructions = "# Home policy\n\n- Workspace = `.` every chat.\n- Unicode = →.\n";
+        std::fs::write(root.path().join("AGENTS.md"), instructions).unwrap();
+        let mut config = crate::config::default_config(root.path().to_path_buf());
+        assert!(!build_initial_instructions(&config).contains(instructions));
+        assert!(!crate::connector_schema::schema_version(&config).contains("startup-doc-v1"));
+        config.project_doc = serde_json::from_value(serde_json::json!({
+            "includeAtStartup": false
+        }))
+        .unwrap();
+        assert!(!build_initial_instructions(&config).contains(instructions));
+        config.project_doc = serde_json::from_value(serde_json::json!({
+            "includeAtStartup": true
+        }))
+        .unwrap();
+        let initial = build_initial_instructions(&config);
+        assert!(
+            initial.ends_with(instructions),
+            "startup must include the entire current AGENTS.md"
+        );
+        assert_eq!(initial.matches(instructions).count(), 1);
+        assert!(initial.contains("Access-root startup instructions"));
+        assert!(initial.contains("override the generic workspace-selection guidance"));
+        assert!(crate::connector_schema::schema_version(&config).contains("startup-doc-v1"));
+        std::fs::write(root.path().join("AGENTS.md"), "replacement policy").unwrap();
+        let updated = build_initial_instructions(&config);
+        assert!(updated.ends_with("replacement policy"));
+        assert!(!updated.contains(instructions));
+    }
+
+    #[test]
+    fn startup_project_doc_keeps_discovery_and_budget_rules() {
+        let root = tempfile::tempdir().unwrap();
+        std::fs::write(root.path().join("AGENTS.md"), "ordinary policy").unwrap();
+        std::fs::write(root.path().join("AGENTS.override.md"), "override policy").unwrap();
+        std::fs::create_dir(root.path().join("project")).unwrap();
+        std::fs::write(
+            root.path().join("project/AGENTS.md"),
+            "child project policy",
+        )
+        .unwrap();
+        let mut config = crate::config::default_config(root.path().to_path_buf());
+        config.project_doc = serde_json::from_value(serde_json::json!({
+            "includeAtStartup": true,
+            "maxBytes": 8
+        }))
+        .unwrap();
+        let initial = build_initial_instructions(&config);
+        assert!(initial.ends_with("override"));
+        assert!(!initial.contains("ordinary policy"));
+        assert!(!initial.contains("child project policy"));
+        config.project_doc.max_bytes = Some(0);
+        assert!(!build_initial_instructions(&config).contains("Access-root startup instructions"));
+        config.project_doc.max_bytes = None;
+        std::fs::remove_file(root.path().join("AGENTS.md")).unwrap();
+        std::fs::remove_file(root.path().join("AGENTS.override.md")).unwrap();
+        assert!(!build_initial_instructions(&config).contains("Access-root startup instructions"));
+    }
+
+    #[test]
+    fn startup_project_doc_preserves_conversation_auth_gate() {
+        let root = tempfile::tempdir().unwrap();
+        std::fs::write(root.path().join("AGENTS.md"), "private startup policy").unwrap();
+        let mut config = crate::config::default_config(root.path().to_path_buf());
+        config.project_doc = serde_json::from_value(serde_json::json!({
+            "includeAtStartup": true
+        }))
+        .unwrap();
+        config.conversation_auth_token = Some("a".repeat(64).into());
+        assert_eq!(
+            build_initial_instructions(&config),
+            CONVERSATION_AUTH_INSTRUCTIONS
+        );
+        config.experimental.agent_tickets = true;
+        let initial = build_initial_instructions(&config);
+        assert!(initial.contains(crate::agent_tickets::INSTRUCTIONS));
+        assert!(!initial.contains("private startup policy"));
+    }
