#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["tomlkit==0.15.1"]
# ///
"""Check instruction files and stale project trust. Use --apply to update them."""
import argparse
import copy
import os
import tempfile
from pathlib import Path

import tomlkit
import tomllib


def prune(text):
    original = tomllib.loads(text)
    missing = {path for path in original.get("projects", {}) if not Path(path).exists()}
    if not missing:
        return text, 0
    document = tomlkit.parse(text)
    expected = copy.deepcopy(original)
    for path in missing:
        del document["projects"][path]
        del expected["projects"][path]
    if not expected["projects"]:
        del document["projects"]
        del expected["projects"]
    result = tomlkit.dumps(document)
    if tomllib.loads(result) != expected:
        raise ValueError("trust pruning changed unrelated configuration")
    return result, len(missing)


def write(path, content):
    target = path.resolve()
    descriptor, temporary = tempfile.mkstemp(prefix=".instructions-", dir=target.parent)
    try:
        with os.fdopen(descriptor, "w") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, target.stat().st_mode & 0o777 if target.exists() else 0o644)
        os.replace(temporary, target)
    finally:
        Path(temporary).unlink(missing_ok=True)


def render_home(here):
    template = (here / "AGENTS.merged.md").read_text()
    routing, marker, _ = template.partition("# Alignment\n")
    if not marker:
        raise ValueError("home instruction template requires an Alignment section")
    return routing + (here.parent / "AGENTS.project.md").read_text()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help="Write the instruction files and prune stale trust entries.")
    args = parser.parse_args()
    here = Path(__file__).resolve().parent
    home = Path.home().resolve()
    config = home / ".codex/config.toml"
    cleaned, missing = prune(config.read_text())
    outputs = {
        home / ".codex/AGENTS.md": (here / "AGENTS.md").read_text(),
        home / "AGENTS.md": render_home(here),
        config: cleaned,
    }
    changed = 0
    for path, content in outputs.items():
        if not path.exists() or path.read_text() != content:
            changed += 1
            if args.apply:
                write(path, content)
            print(f"{'updated' if args.apply else 'outdated'}={path}")
    print(f"stale_trust_entries={missing} files_changed={changed} applied={args.apply}")
    return 0 if args.apply or not changed else 1


if __name__ == "__main__":
    raise SystemExit(main())
