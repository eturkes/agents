#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["tomlkit==0.15.1"]
# ///
"""Check instruction files, stale project trust and the Codexify workspace policy. Use --apply to update them."""
import argparse
import copy
import json
import os
import tempfile
from pathlib import Path

import tomlkit
import tomllib


def prune(text):
    original = tomllib.loads(text)
    missing = {path for path in original.get("projects", {}) if not Path(path).exists()}
    if not missing:
        return text, 0
    document = tomlkit.parse(text)
    expected = copy.deepcopy(original)
    for path in missing:
        del document["projects"][path]
        del expected["projects"][path]
    if not expected["projects"]:
        del document["projects"]
        del expected["projects"]
    result = tomlkit.dumps(document)
    if tomllib.loads(result) != expected:
        raise ValueError("trust pruning changed unrelated configuration")
    return result, len(missing)


# Codexify ≥ 2.2 makes every chat select a workspace + loads AGENTS.md from that directory alone ⇒ entry `.` lets
# chats select ~, whose AGENTS.md routes the task. Under the default `auto`, each later chat on an already selected
# checkout gets a git worktree, which fails on ~ (no repo) and forks emachine from its live build ⇒ `never`.
# Plain chat, no MCP App cards ⇒ uiWidgets + agentChat off.
HOME_ENTRY = {
    "path": ".",
    "name": "home",
    "description": "Home workspace. Its AGENTS.md routes every task. Select it for every chat.",
}


def codexify_policy(text):
    config = json.loads(text)
    expected = copy.deepcopy(config)
    expected.setdefault("worktrees", {})["mode"] = "never"
    expected["uiWidgets"] = False
    expected.setdefault("agentChat", {})["enabled"] = False
    catalog = expected.setdefault("projectCatalog", {})
    catalog["entries"] = [e for e in catalog.get("entries", []) if e.get("path") != "."] + [HOME_ENTRY]
    return text if expected == config else json.dumps(expected, indent=2) + "\n"


def write(path, content):
    target = path.resolve()
    descriptor, temporary = tempfile.mkstemp(prefix=".instructions-", dir=target.parent)
    try:
        with os.fdopen(descriptor, "w") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, target.stat().st_mode & 0o777 if target.exists() else 0o644)
        os.replace(temporary, target)
    finally:
        Path(temporary).unlink(missing_ok=True)


def render_home(here):
    template = (here / "AGENTS.codexify.md").read_text()
    required = {"Collaboration", "Execution", "Authoring", "Engineering", "Environment", "Reading"}
    sections = {line[3:] for line in template.splitlines() if line.startswith("## ")}
    if not template.startswith("# Codexify\n") or not required <= sections:
        raise ValueError("Codexify instruction template requires runtime and policy sections")
    return template


# codex/aeon/deploy-instructions reuses codexify_policy, render_home + sync ⇒ keep names + signatures stable.
def sync(outputs, apply):
    changed = 0
    for path, content in outputs.items():
        if not path.exists() or path.read_text() != content:
            changed += 1
            if apply:
                write(path, content)
            print(f"{'updated' if apply else 'outdated'}={path}")
    return changed


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help="Write the instruction files and prune stale trust entries.")
    args = parser.parse_args()
    here = Path(__file__).resolve().parent
    home = Path.home().resolve()
    config = home / ".codex/config.toml"
    cleaned, missing = prune(config.read_text())
    codexify = home / ".codexify/codexify.config.json"
    outputs = {
        home / ".codex/AGENTS.md": (here / "AGENTS.md").read_text(),
        home / "AGENTS.md": render_home(here),
        config: cleaned,
        codexify: codexify_policy(codexify.read_text()),
    }
    changed = sync(outputs, args.apply)
    print(f"stale_trust_entries={missing} files_changed={changed} applied={args.apply}")
    return 0 if args.apply or not changed else 1


if __name__ == "__main__":
    raise SystemExit(main())
