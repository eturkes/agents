#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["tomlkit==0.15.1"]
# ///
"""Check trust pruning, standalone machine policies, and instruction replay."""
import json
import runpy
import tempfile
from pathlib import Path

import tomllib

here = Path(__file__).resolve().parent
deployment = runpy.run_path(str(here / "deploy-instructions"))
prune = deployment["prune"]
with tempfile.TemporaryDirectory(prefix="instruction-check-") as directory:
    existing = json.dumps(directory)
    absent = json.dumps(str(Path(directory) / "absent"))
    fixtures = [
        f'[projects.{absent}]\ntrust_level="trusted"\n',
        f'[projects.{absent}] # table comment\ntrust_level="trusted"\n',
        f'[projects.{absent}]\ntrust_level="trusted"\n[tui] # unrelated\ntheme="keep"\n',
        f'[projects.{existing}]\ntrust_level="trusted"\n[projects.{absent}]\ntrust_level="trusted"\n',
        '[tui]\nnote="""\n[projects.fake]\n"""\n',
    ]
    for index, text in enumerate(fixtures):
        expected = tomllib.loads(text)
        projects = expected.get("projects", {})
        missing = {key for key in projects if not Path(key).exists()}
        for key in missing:
            del projects[key]
        if missing and not projects:
            del expected["projects"]
        result, count = prune(text)
        assert tomllib.loads(result) == expected, f"case {index}: unrelated configuration changed"
        assert count == len(missing), f"case {index}: wrong removed count"
        assert prune(result) == (result, 0), f"case {index}: not idempotent"
    print(f"trust_pruning_cases={len(fixtures)}: OK")

render_home = deployment["render_home"]
required = {"Collaboration", "Execution", "Authoring", "Engineering", "Environment", "Reading"}
for machine in ("cachyos", "aeon"):
    target = here.parent / machine
    policy = (target / "AGENTS.codexify.md").read_text()
    assert policy.startswith("# Codexify\n"), f"{machine}: runtime missing"
    sections = [line[3:] for line in policy.splitlines() if line.startswith("## ")]
    assert required <= set(sections), f"{machine}: incomplete policy"
    assert len(sections) == len(set(sections)), f"{machine}: duplicate sections"
    bullets = [line for line in policy.splitlines() if line.startswith("- ")]
    assert len(bullets) == len(set(bullets)), f"{machine}: duplicate rules"
    assert "AGENTS.codexify.md" not in policy, f"{machine}: instructions route back to themselves"
    assert (target / "AGENTS.md").read_text().startswith("# Codex\n"), f"{machine}: native policy missing"
    assert render_home(target) == policy, f"{machine}: deployment changed the policy"

runtime = (here / "AGENTS.codexify.md").read_text()
routing = runtime.split("## Task routing\n", 1)[1].split("\n## ", 1)[0]
assert "`~/.local/app/emachine/`" in routing, "Codexify default target is missing"
assert "explicit target overrides" in routing, "explicit target precedence is missing"
assert "`emachine projects`" in routing and "`docs/features.md`" in routing, "project activation is missing"
with tempfile.TemporaryDirectory(prefix="routing-check-") as directory:
    parent = Path(directory)
    target = parent / "cachyos"
    target.mkdir()
    source = target / "AGENTS.codexify.md"
    for label in ("first", "second"):
        expected = runtime.replace("## Collaboration\n", f"## Collaboration\n\n- Context = {label}.\n")
        source.write_text(expected)
        assert render_home(target) == expected, "deployment lost routing or policy changes"
        deployment["write"](parent / "AGENTS.md", render_home(target))
        assert (parent / "AGENTS.md").read_bytes() == source.read_bytes(), "deployment changed source bytes"
        assert render_home(target) == expected, "instruction replay is not idempotent"
    for section in required:
        source.write_text(runtime.replace(f"## {section}\n", ""))
        try:
            render_home(target)
        except ValueError:
            pass
        else:
            raise AssertionError(f"incomplete instruction template accepted: {section}")
print("standalone_policies=2 routing_and_replay: OK")
